{
  "name": "PflegeApp",
  "version": "1.0.3",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android-release": "cd android && ./gradlew assembleRelease && cd ..",
    "android-bundle": "cd android && ./gradlew bundleRelease && cd ..",
    "android-clean": "cd android && ./gradlew clean && cd ..",
    "android-release-windows": "cd android && .\\gradlew.bat assembleRelease && cd ..",
    "android-bundle-windows": "cd android && .\\gradlew.bat bundleRelease && cd ..",
    "normalize-terms": "ts-node src/scripts/normalizeMedicalTerms.ts",
    "prepare": "husky install",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "fix-line-endings": "node scripts/LineEndingConfigurator.js",
    "build-and-install": "cd android && .\\gradlew.bat clean && .\\gradlew.bat assembleDebug && cd .. && adb install -r android\\app\\build\\outputs\\apk\\debug\\app-debug.apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-clipboard/clipboard": "1.16.2",
    "@react-native-community/slider": "^4.5.6",
    "@react-native-google-signin/google-signin": "15.0.0",
    "@react-native-picker/picker": "2.11.0",
    "@react-native-voice/voice": "3.2.4",
    "@react-navigation/bottom-tabs": "^7.3.3",
    "@react-navigation/native": "^7.0.19",
    "@react-navigation/native-stack": "^7.3.3",
    "@xmldom/xmldom": "^0.9.8",
    "fast-xml-parser": "^4.3.6",
    "i18next": "^23.10.1",
    "intl-pluralrules": "2.0.1",
    "react": "19.0.0",
    "react-i18next": "^13.2.2",
    "react-native": "0.78.1",
    "react-native-background-actions": "^4.0.1",
    "react-native-device-info": "^14.0.4",
    "react-native-fs": "2.20.0",
    "react-native-keep-awake": "^4.0.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-navigation-bar-color": "2.0.2",
    "react-native-permissions": "^5.3.0",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.10.0",
    "react-native-sqlite-storage": "6.0.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "6.14.0",
    "react-native-webview": "^13.13.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.1",
    "@react-native/eslint-config": "0.78.1",
    "@react-native/gradle-plugin": "^0.79.1",
    "@react-native/metro-config": "0.78.1",
    "@react-native/typescript-config": "0.78.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.5.1",
    "metro": "^0.80.6",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
