__d((function(g,r,i,a,m,e,d){var n=r(d[0]);Object.defineProperty(e,"__esModule",{value:!0}),e.nursingStandardsData=e.lexikonEntries=e.emergencyData=void 0;var t=n(r(d[1])),s=n(r(d[2])),u=n(r(d[3])),h=n(r(d[4])),l=(e.emergencyData={atemnot:{id:'atemnot',title:"Atemnot",icon:"\ud83d\udca8",steps:[{id:'atemnot_1',text:'Ruhe bewahren, Patient beruhigen.'},{id:'atemnot_2',text:'Oberk\xf6rper hochlagern.'},{id:'atemnot_3',text:'Atmung beobachten (Frequenz, Tiefe, Ger\xe4usche, Zyanose?).'},{id:'atemnot_4',text:'Sauerstoffs\xe4ttigung messen (Pulsoxy). Ziel SpO2 >94%.'},{id:'atemnot_5',text:'O2-Gabe nach \xe4rztl. Anordnung / Standard.'},{id:'atemnot_6',text:'Arzt informieren.'},{id:'atemnot_7',text:'Vitalzeichenkontrolle (Atemfrequenz, Puls, RR, SpO2, Temp, Bewusstsein).'},{id:'atemnot_8',text:'Dokumentation.'}]},brustschmerz:{id:'brustschmerz',title:"Brustschmerz",icon:"\u2764\ufe0f\u200d\ud83d\udd25",steps:[{id:'brust_1',text:'Patient beruhigen, absolute Ruhe.'},{id:'brust_2',text:'Oberk\xf6rper hochlagern (wenn Kreislauf stabil!).'},{id:'brust_3',text:'Vitalzeichen (RR, Puls (Norm ca. 60-100/min), SpO2 (>94%)).'},{id:'brust_4',text:'Schmerzassessment (Skala 0-10, Lokalisation, Art, Ausstrahlung).'},{id:'brust_5',text:'Arzt SOFORT informieren (Verdacht auf Herzinfarkt/ACS).'},{id:'brust_6',text:'12-Kanal-EKG schreiben.'},{id:'brust_7',text:'O2-Gabe nach Anordnung.'},{id:'brust_8',text:'Vorbereitung Notfallmedikamente (Nitrospray etc.) nach Anordnung.'}]},hypoglykaemie:{id:'hypoglykaemie',title:"Unterzuckerung",icon:"\ud83c\udf6d",steps:[{id:'hypo_1',text:'Anzeichen erkennen: Kaltschwei\xdfigkeit, Zittern, Hei\xdfhunger, Bl\xe4sse, Herzklopfen, Verwirrtheit, Wesens\xe4nderung, Sehst\xf6rungen.'},{id:'hypo_2',text:'BZ-Messung sofort durchf\xfchren. Hypoglyk\xe4mie oft <60-70 mg/dl. (Normalbereich ca. 70-140 mg/dl).'},{id:'hypo_3',text:'Bei Bewusstsein & Schluckf\xe4higkeit: Schnelle Kohlenhydrate geben (z.B. 2-4 T\xe4felchen Traubenzucker, Fruchtsaft/Cola).'},{id:'hypo_4',text:'Nach 10-15 Min.: Erneute BZ-Messung. Bei weiter niedrigem BZ/anhaltenden Symptomen: Erneut schnelle KH geben & Arzt informieren!'},{id:'hypo_5',text:'Wenn BZ stabilisiert: Langsam wirkende Kohlenhydrate geben (z.B. Brot, Joghurt, Banane).'},{id:'hypo_6',text:'Bei Bewusstlosigkeit/Krampfanfall: Notarzt (112)! Stabile Seitenlage. KEINE orale Nahrung/Fl\xfcssigkeit (Aspiration!).'},{id:'hypo_7',text:'Glukagon-Injektion i.m. nach \xe4rztl. Anordnung (bei Bewusstlosigkeit/Schluckunf\xe4higkeit, falls Kit vorhanden/geschult).'},{id:'hypo_8',text:'Vitalzeichen kontrollieren (Puls, RR, SpO2, Bewusstsein). Verlauf & Ma\xdfnahmen dokumentieren. Ursache kl\xe4ren.'}]},sturz:{id:'sturz',title:"Sturz",icon:"\ud83e\udd15",steps:[{id:'sturz_1',text:'Patienten ansprechen, Ruhe vermitteln.'},{id:'sturz_2',text:'Auf offensichtliche Verletzungen pr\xfcfen (Wunden, Schwellungen, Fehlstellungen).'},{id:'sturz_3',text:'Schmerzen erfragen (Kopf, Nacken, Wirbels\xe4ule, H\xfcfte, Extremit\xe4ten?).'},{id:'sturz_4',text:'Basale neurologische Pr\xfcfung (Pupillen, Orientierung, Motorik).'},{id:'sturz_5',text:'Bei Verdacht auf schwere Verletzung (z.B. Fraktur, Kopf-/WS-Verletzung): Nicht bewegen! Notarzt (112)!'},{id:'sturz_6',text:'Bei leichten/keinen Verletzungen: Hilfe beim sicheren Aufstehen anbieten.'},{id:'sturz_7',text:'Vitalzeichenkontrolle (Puls, RR, SpO2, Bewusstsein), ggf. BZ.'},{id:'sturz_8',text:'Dokumentation (Sturzprotokoll), Ursache kl\xe4ren.'}]},fieber_sepsis:{id:'fieber_sepsis',title:"Fieber",icon:"\ud83c\udf21\ufe0f",steps:[{id:'fieber_1',text:'Temperatur messen (rektal bevorzugt). Norm ca. 36.5-37.4\xb0C.'},{id:'fieber_2',text:'Sepsiszeichen? (qSOFA: AF \u226522/min, syst. RR \u2264100mmHg, Bewusstseins\xe4nderung?). Sch\xfcttelfrost?'},{id:'fieber_3',text:'Bei Sepsisverdacht: Arzt SOFORT informieren!'},{id:'fieber_4',text:'Fl\xfcssigkeitszufuhr erh\xf6hen (oral/i.v. nach Anordnung).'},{id:'fieber_5',text:'Wadenwickel / fiebersenkende Ma\xdfnahmen nach Anordnung.'},{id:'fieber_6',text:'Blutkulturen abnehmen (vor Antibiose, nach Anordnung).'},{id:'fieber_7',text:'Vitalzeichen engmaschig (AF, Puls, RR, SpO2, Temp, Bewusstsein, BZ).'},{id:'fieber_8',text:'Dokumentation.'}]},blutung:{id:'blutung',title:"Blutung",icon:"\ud83e\ude78",steps:[{id:'blut_1',text:'Ruhe bewahren, Patient beruhigen.'},{id:'blut_2',text:'Einmalhandschuhe anziehen (Eigenschutz!).'},{id:'blut_3',text:'Direkten Druck auf die Wunde aus\xfcben (sterile Kompresse/Tuch).'},{id:'blut_4',text:'Betroffenen K\xf6rperteil hochlagern.'},{id:'blut_5',text:'Druckverband anlegen.'},{id:'blut_6',text:'Arzt / Notarzt (112 bei starker, unkontrollierbarer Blutung) informieren.'},{id:'blut_7',text:'Vitalzeichenkontrolle (Puls, RR, SpO2, Bewusstsein). Schockzeichen? (Tachykardie, Hypotonie, Bl\xe4sse, kalter Schwei\xdf)'},{id:'blut_8',text:'Bei Nasenbluten: Kopf nach vorne beugen, Nacken k\xfchlen.'}]},allergie_anaphylaxie:{id:'allergie_anaphylaxie',title:"Allergie",icon:"\ud83e\uddea",steps:[{id:'allerg_1',text:'Allergenzufuhr stoppen (Infusion, Nahrung etc.).'},{id:'allerg_2',text:'Patient beruhigen. Lagerung: Atemnot -> Oberk\xf6rper hoch; Schock -> Flachlagerung, Beine hoch.'},{id:'allerg_3',text:'Notarzt rufen (112), Anaphylaxie melden!'},{id:'allerg_4',text:'Vitalzeichen pr\xfcfen (AF, Puls, RR, SpO2, Bewusstsein, Haut).'},{id:'allerg_5',text:'Adrenalin-Autoinjektor anwenden (falls vorhanden/instruiert).'},{id:'allerg_6',text:'O2-Gabe nach Anordnung.'},{id:'allerg_7',text:'Bereitschaft zur Reanimation.'},{id:'allerg_8',text:'Dokumentation, Ausl\xf6ser sichern (wenn bekannt).'}]},krampfanfall:{id:'krampfanfall',title:"Krampfanfall",icon:"\u26a1",steps:[{id:'krampf_1',text:'Ruhe bewahren, Umgebung sichern (Gegenst\xe4nde entfernen).'},{id:'krampf_2',text:'Patient vor Verletzungen sch\xfctzen (Kopf polstern), nicht festhalten.'},{id:'krampf_3',text:'Nichts in den Mund stecken!'},{id:'krampf_4',text:'Dauer des Anfalls beobachten (Uhrzeit!).'},{id:'krampf_5',text:'Nach dem Anfall: Stabile Seitenlage (wenn bewusstlos).'},{id:'krampf_6',text:'Atmung und SpO2 kontrollieren.'},{id:'krampf_7',text:'Arzt informieren. Bei erstem Anfall, >5 Min Dauer, Verletzung oder Serie -> Notarzt (112)!'},{id:'krampf_8',text:'Dokumentation (Art, Dauer, Begleitumst\xe4nde).'}]},schlaganfallverdacht:{id:'schlaganfallverdacht',title:"Schlaganfall",icon:"\ud83e\udde0",steps:[{id:'fast_1',text:'FAST-Test: Face (L\xe4cheln), Arms (Arme vorhalten), Speech (Satz nachsprechen), Time (Zeitpunkt Symptombeginn!).'},{id:'fast_2',text:'Bei positivem Test: SOFORT Notarzt (112), Schlaganfall melden!'},{id:'fast_3',text:'Patienten beruhigen, nicht alleine lassen.'},{id:'fast_4',text:'Oberk\xf6rper leicht erh\xf6ht lagern (ca. 30 Grad).'},{id:'fast_5',text:'Nichts zu essen oder trinken geben (Aspirationsgefahr!).'},{id:'fast_6',text:'Vitalzeichen kontrollieren (AF, Puls, RR, SpO2, Temp), BZ messen!'},{id:'fast_7',text:'Genaue Uhrzeit des Symptombeginns erfragen/dokumentieren.'},{id:'fast_8',text:'Vorbereitung Transport (Akte, Medikamente).'}]},dehydratation:{id:'dehydratation',title:"Dehydratation",icon:"\ud83d\udca7",steps:[{id:'dehy_1',text:'Anzeichen erkennen: Trockene Schleimh\xe4ute, stehende Hautfalten, Verwirrtheit, Oligurie (<0.5ml/kg/h), Tachykardie, Hypotonie.'},{id:'dehy_2',text:'Fl\xfcssigkeitszufuhr anbieten/steigern (Lieblingsgetr\xe4nke).'},{id:'dehy_3',text:'Trinkprotokoll f\xfchren / Ein- & Ausfuhr bilanzieren.'},{id:'dehy_4',text:'Ursache kl\xe4ren (Trinkmenge, Erbrechen, Diarrhoe, Fieber?).'},{id:'dehy_5',text:'Bei schwerer Exsikkose / Trinkverweigerung: Arzt informieren (Infusion notwendig?).'},{id:'dehy_6',text:'Vitalzeichen kontrollieren (Puls, RR, Temp, Hautturgor).'},{id:'dehy_7',text:'Mundpflege durchf\xfchren/intensivieren.'},{id:'dehy_8',text:'Dokumentation (Trinkmenge, Bilanz, Symptome, Ma\xdfnahmen).'}]},erbrechen_diarrhoe:{id:'erbrechen_diarrhoe',title:"Erbrechen & Durchfall",icon:"\ud83e\udd22",steps:[{id:'erbr_1',text:'Patienten unterst\xfctzen (Nierenschale, Toilettengang).'},{id:'erbr_2',text:'Hygiene beachten (Handschuhe, Kittel), ggf. Isolation nach Standard.'},{id:'erbr_3',text:'Fl\xfcssigkeits-/Elektrolytverlust ausgleichen (orale Rehydratationsl\xf6sung, Infusion nach Anordnung).'},{id:'erbr_4',text:'Hautpflege im Analbereich (bei Diarrhoe).'},{id:'erbr_5',text:'Ausscheidungen beobachten (Frequenz, Menge, Beschaffenheit, Blut?).'},{id:'erbr_6',text:'Bei Persistenz, Blut, Fieber, starkem Krankheitsgef\xfchl: Arzt informieren.'},{id:'erbr_7',text:'Vitalzeichen kontrollieren (Puls, RR, Temp). Dehydratationszeichen? (Hautturgor, Schleimh\xe4ute)'},{id:'erbr_8',text:'Dokumentation (Frequenz, Beschaffenheit, Bilanz, Ma\xdfnahmen).'}]},schmerz_akut:{id:'schmerz_akut',title:"Akutschmerz",icon:"\ud83d\ude16",steps:[{id:'schmerz_1',text:'Patient ernst nehmen. Schmerzassessment (Skala 0-10, Lokalisation, Art, Ausl\xf6ser).'},{id:'schmerz_2',text:'Ursache suchen (neue Erkrankung, Komplikation?).'},{id:'schmerz_3',text:'Lagerung anpassen, Ruhe erm\xf6glichen.'},{id:'schmerz_4',text:'Nicht-medikament\xf6se Ma\xdfnahmen (K\xfchlung/W\xe4rme, Entspannung, Ablenkung).'},{id:'schmerz_5',text:'Arzt informieren. Schmerzmittel nach Anordnung verabreichen.'},{id:'schmerz_6',text:'Wirkung der Schmerzmittel \xfcberpr\xfcfen (erneutes Assessment nach ca. 30-60 Min).'},{id:'schmerz_7',text:'Vitalzeichen kontrollieren (AF, Puls, RR, SpO2, Bewusstsein - insb. bei Opioiden!).'},{id:'schmerz_8',text:'Dokumentation (Assessment, Ma\xdfnahmen, Wirkung).'}]},verwirrtheit_delir:{id:'verwirrtheit_delir',title:"Verwirrtheit",icon:"\ud83d\ude35\u200d\ud83d\udcab",steps:[{id:'delir_1',text:'Ruhe ausstrahlen, Reizabschirmung.'},{id:'delir_2',text:'Orientierungshilfen geben (Name, Datum, Ort, Brille/H\xf6rger\xe4t).'},{id:'delir_3',text:'M\xf6gliche Ursachen pr\xfcfen (Infekt, Dehydratation, Schmerz, Medis, Hypoxie, Harnverhalt etc.).'},{id:'delir_4',text:'Arzt informieren, Ursachenabkl\xe4rung!'},{id:'delir_5',text:'Sicherheit gew\xe4hrleisten (Sturzprophylaxe), ggf. Sitzwache.'},{id:'delir_6',text:'Fl\xfcssigkeitszufuhr, Ern\xe4hrung sicherstellen.'},{id:'delir_7',text:'Tag-Nacht-Rhythmus f\xf6rdern.'},{id:'delir_8',text:'Dokumentation (Verhalten, Ursachen, Ma\xdfnahmen).'}]},schluckstoerung:{id:'schluckstoerung',title:"Schluckst\xf6rung",icon:"\ud83e\udee6",steps:[{id:'schluck_1',text:'Anzeichen erkennen: Husten/R\xe4uspern bei/nach Nahrungsaufnahme, gurgelnde Stimme, Nahrungsreste im Mund.'},{id:'schluck_2',text:'Bei akuter Aspiration (Luftnot, Zyanose): Notfall! Oberk\xf6rper vorbeugen, Husten auffordern, ggf. Heimlich-Man\xf6ver, Notarzt (112)!'},{id:'schluck_3',text:'Bei Verdacht: Nahrungs-/Fl\xfcssigkeitszufuhr sofort stoppen!'},{id:'schluck_4',text:'Arzt informieren, logop\xe4disches Konsil anregen.'},{id:'schluck_5',text:'Kostform anpassen (Andicken etc.) nach Anordnung/Standard.'},{id:'schluck_6',text:'Oberk\xf6rper aufrecht bei & nach Nahrungsaufnahme (mind. 30 Min).'},{id:'schluck_7',text:'Mundpflege nach Mahlzeiten durchf\xfchren.'},{id:'schluck_8',text:'Atmung/Vitalzeichen beobachten (AF, SpO2, Temp - Aspirationspneumonie?).'}]},harnverhalt:{id:'harnverhalt',title:"Harnverhalt",icon:"\ud83d\udebd",steps:[{id:'harn_1',text:'Patient nach Miktionsproblemen fragen (Harndrang? Schmerzen?).'},{id:'harn_2',text:'Unterbauch palpieren (pralle Blase?).'},{id:'harn_3',text:'Blasenscan durchf\xfchren.'},{id:'harn_4',text:'Letzte Miktion? Ein-/Ausfuhr bilanzieren.'},{id:'harn_5',text:'Unterst\xfctzende Ma\xdfnahmen (Wasser laufen lassen, Intimsph\xe4re).'},{id:'harn_6',text:'Arzt informieren (Einmalkatheterisierung/DK nach Anordnung?).'},{id:'harn_7',text:'Anurie (<100ml/24h) oder <6h keine Miktion trotz Harndrang/Fl\xfcssigkeitszufuhr? DRINGEND Arztinfo! (Nierenversagen?).'},{id:'harn_8',text:'Dokumentation (Symptome, Bilanz, Ma\xdfnahmen, Restharn).'}]},hypertensive_krise:{id:'hypertensive_krise',title:"Hypertonie",icon:"\ud83d\udcc8",steps:[{id:'hyper_1',text:'Blutdruck messen (beidseitig). Norm ca. 120/80 mmHg.'},{id:'hyper_2',text:'Patienten beruhigen, Oberk\xf6rper hochlagern.'},{id:'hyper_3',text:'Symptome erfragen (Kopfschmerz, Schwindel, Sehst\xf6rung, Brustschmerz, Atemnot, \xdcbelkeit?).'},{id:'hyper_4',text:'Arzt SOFORT informieren bei RR >180/110 (Krise) oder RR >230/120 / mit Symptomen (Notfall)!'},{id:'hyper_5',text:'Blutdrucksenkende Medikamente nach \xe4rztl. Anordnung verabreichen.'},{id:'hyper_6',text:'Engmaschige RR-Kontrolle (Ziel: langsame Senkung!).'},{id:'hyper_7',text:'Ursache kl\xe4ren (Medikamentenadh\xe4renz?).'},{id:'hyper_8',text:'Dokumentation (RR-Werte, Symptome, Medikation).'}]},wundinfektion:{id:'wundinfektion',title:"Wundinfektion",icon:"\ud83e\udda0",steps:[{id:'wunde_1',text:'Wunde inspizieren: R\xf6tung, Schwellung, \xdcberw\xe4rmung, Schmerz, Exsudat (Menge, Farbe, Geruch?), Wundrand.'},{id:'wunde_2',text:'Verbandwechsel nach hygienischen Prinzipien.'},{id:'wunde_3',text:'Wundabstrich nach \xe4rztl. Anordnung (vor Antiseptik!).'},{id:'wunde_4',text:'Arzt \xfcber Wundzustand informieren.'},{id:'wunde_5',text:'Systemische Infektionszeichen pr\xfcfen (Fieber, Sch\xfcttelfrost, Tachykardie, Labor?).'},{id:'wunde_6',text:'Wundsp\xfclung / Antiseptika / Wundauflagen nach Anordnung.'},{id:'wunde_7',text:'Schmerzmanagement.'},{id:'wunde_8',text:'Dokumentation (Wundzustand, Ma\xdfnahmen, Material).'}]},synkope_kollaps:{id:'synkope_kollaps',title:"Bewusstlosigkeit",icon:"\ud83d\ude11",steps:[{id:'synk_1',text:'Patient ansprechen, Bewusstsein pr\xfcfen.'},{id:'synk_2',text:'Bei Bewusstlosigkeit: Atmung pr\xfcfen! -> Stabile Seitenlage oder Reanimation!'},{id:'synk_3',text:'Bei kurzer Bewusstlosigkeit / Pr\xe4synkope: Hinlegen, Beine hochlagern.'},{id:'synk_4',text:'Vitalzeichen messen (Puls, RR - auch orthostatisch, SpO2).'},{id:'synk_5',text:'Ursache erfragen (Situation, Medikamente, Herzerkrankung?).'},{id:'synk_6',text:'Arzt informieren (insb. bei erstem Auftreten, Verletzung, kardialem Verdacht).'},{id:'synk_7',text:'BZ messen.'},{id:'synk_8',text:'Langsam mobilisieren, Sturzprophylaxe.'}]},verhaltensnotfall:{id:'verhaltensnotfall',title:"Aggression",icon:"\ud83e\udd2c",steps:[{id:'aggro_1',text:'Eigenschutz beachten! Ruhe bewahren, Abstand halten, Fluchtweg sichern.'},{id:'aggro_2',text:'Situation deeskalieren (ruhige Ansprache, Ich-Botschaften, validieren).'},{id:'aggro_3',text:'Keine Diskussionen, keine Provokation.'},{id:'aggro_4',text:'Hilfe holen (Kollegen, Sicherheit).'},{id:'aggro_5',text:'M\xf6gliche Ausl\xf6ser suchen (Schmerz, Angst, Delir, Medis?).'},{id:'aggro_6',text:'Arzt informieren (medikament\xf6se Sedierung nach Anordnung?).'},{id:'aggro_7',text:'Fixierung nur als Ultima Ratio bei akuter Gefahr nach \xe4rztl. Anordnung!'},{id:'aggro_8',text:'Dokumentation (Ausl\xf6ser, Verhalten, Ma\xdfnahmen).'}]},lungenembolie_verdacht:{id:'lungenembolie_verdacht',title:"Lungenembolie",icon:"\ud83e\udec1",steps:[{id:'lunge_1',text:'Anzeichen erkennen: Pl\xf6tzliche Dyspnoe, atemabh\xe4ngiger Thoraxschmerz, Tachykardie (>100/min), Tachypnoe, Husten, Angst, Zyanose?'},{id:'lunge_2',text:'Patient beruhigen, Oberk\xf6rper hochlagern.'},{id:'lunge_3',text:'Arzt SOFORT informieren, Verdacht \xe4u\xdfern!'},{id:'lunge_4',text:'O2-Gabe nach Anordnung (hoher Fluss).'},{id:'lunge_5',text:'Vitalzeichen engmaschig (AF, Puls, RR, SpO2).'},{id:'lunge_6',text:'Vorbereitung Diagnostik (EKG, BGA, D-Dimere, CT).'},{id:'lunge_7',text:'Antikoagulation nach Anordnung vorbereiten/verabreichen.'},{id:'lunge_8',text:'Reanimationsbereitschaft.'}]}},e.nursingStandardsData=[{id:'standard-dekubitus',title:'Dekubitusprophylaxe',ziel:'Verhinderung der Entstehung von Dekubitus bei gef\xe4hrdeten Personen durch fr\xfchzeitige Identifikation von Risiken und Anwendung gezielter pr\xe4ventiver Ma\xdfnahmen.',strukturkriterien:['Pflegefachkr\xe4fte verf\xfcgen \xfcber aktuelles Wissen zur Dekubitusentstehung, Risikofaktoren, Pr\xe4ventionsstrategien und \xfcber die Anwendung von Skalen zur Risikoeinsch\xe4tzung.','Geeignete Hilfsmittel zur Druckreduktion (z.B. spezielle Matratzen, Lagerungshilfen) sind verf\xfcgbar und einsatzbereit.','Eine interdisziplin\xe4re Zusammenarbeit (z.B. mit \xc4rzten, Physiotherapeuten, Ern\xe4hrungsberatern) ist etabliert.'],prozesskriterien:['Systematische Einsch\xe4tzung des individuellen Dekubitusrisikos bei Aufnahme und regelm\xe4\xdfig bzw. bei Zustands\xe4nderungen (z.B. mittels Braden-Skala).','Regelm\xe4\xdfige Hautinspektion, insbesondere an Pr\xe4dilektionsstellen.','F\xf6rderung der Eigenbewegung des Patienten/Bewohners.','Regelm\xe4\xdfige Durchf\xfchrung druckentlastender Ma\xdfnahmen (Positionswechsel, Mikrolagerungen, Freilagerung gef\xe4hrdeter Stellen).','Anwendung geeigneter druckreduzierender Hilfsmittel basierend auf der Risikoeinsch\xe4tzung.','Sicherstellung einer ad\xe4quaten Hautpflege (schonende Reinigung, Hautschutz).','Management von Ern\xe4hrungs- und Fl\xfcssigkeitsdefiziten.','Information, Schulung und Beratung von Patienten/Bewohnern und deren Angeh\xf6rigen.','Dokumentation aller Ma\xdfnahmen und des Hautzustands.'],ergebniskriterien:['Die Haut des Patienten/Bewohners ist intakt; es entsteht kein Dekubitus.','Der Patient/Bewohner \xe4u\xdfert Zufriedenheit mit den prophylaktischen Ma\xdfnahmen bzw. erf\xe4hrt keine unzumutbare Belastung dadurch.','Fr\xfchzeichen einer Hautsch\xe4digung werden rechtzeitig erkannt und behandelt.']},{id:'standard-sturz',title:'Sturzprophylaxe',ziel:'Reduktion von H\xe4ufigkeit und Schwere von St\xfcrzen durch Identifikation und Minimierung individueller Risiken sowie gezielte Pr\xe4ventionsma\xdfnahmen.',strukturkriterien:['Qualifiziertes, geschultes Personal f\xfcr Sturzprophylaxe.','Verf\xfcgbarkeit geeigneter Hilfsmittel und sicherer Ausstattung (z.B. Gehhilfen, Haltegriffe, rutschfeste B\xf6den).','Systematische Dokumentation und Auswertung von Sturzereignissen.'],prozesskriterien:['Regelm\xe4\xdfige, standardisierte Risikoeinsch\xe4tzung bei allen betreuten Personen.','Entwicklung und Umsetzung individueller, ma\xdfgeschneiderter Pr\xe4ventionspl\xe4ne.','Kontinuierliche Schulung des Personals sowie Beratung von Betroffenen und Angeh\xf6rigen.'],ergebniskriterien:['Messbare Reduktion der Sturzrate und sturzbedingter Verletzungen.','Steigerung der Lebensqualit\xe4t und des Sicherheitsgef\xfchls der Betroffenen.']},{id:'standard-schmerz',title:'Schmerzmanagement',ziel:'Verbesserung der Lebensqualit\xe4t von Menschen mit akuten, chronischen oder zu erwartenden Schmerzen durch systematische Schmerzassessment und individuell angepasste Interventionen, um die Schmerzerfahrung zu minimieren.',strukturkriterien:['Qualifiziertes, geschultes Personal f\xfcr Schmerzassessment und -management.','Verf\xfcgbarkeit geeigneter Hilfsmittel (z.B. standardisierte Assessment-Instrumente, Schulungsmaterialien).','System zur l\xfcckenlosen Erfassung und Auswertung von Schmerzdaten.'],prozesskriterien:['Regelm\xe4\xdfige, umfassende Schmerzerfassung (Intensit\xe4t, Qualit\xe4t, Ursache, individuelle/kulturelle Aspekte).','Entwicklung und Umsetzung individueller Schmerzmanagement-Pl\xe4ne (pharmakologisch und nicht-pharmakologisch).','Kontinuierliche Schulung des Personals sowie Beratung und Unterst\xfctzung von Betroffenen und Angeh\xf6rigen.'],ergebniskriterien:['Messbare Reduktion der Schmerzintensit\xe4t und Verbesserung des allgemeinen Wohlbefindens.','Steigerung der Zufriedenheit von Betroffenen und Angeh\xf6rigen mit der Schmerzversorgung.']},{id:'standard-ernaehrung',title:'Ern\xe4hrungsmanagement',ziel:'Sicherstellung einer bedarfsgerechten Ern\xe4hrung und Fl\xfcssigkeitszufuhr zur Vermeidung von Mangelern\xe4hrung und Dehydratation sowie zur Unterst\xfctzung von Heilungsprozessen und Wohlbefinden.',strukturkriterien:['Qualifiziertes Personal mit Kenntnissen im Ern\xe4hrungsmanagement und Screening-Verfahren.','Verf\xfcgbarkeit von Screening-Instrumenten (z.B. MNA, NRS) und Ressourcen zur Ern\xe4hrungsintervention (z.B. angereicherte Kost, Trinknahrung, Kooperation mit Di\xe4tassistenz).','Etablierte Prozesse zur interdisziplin\xe4ren Zusammenarbeit (\xc4rzte, Di\xe4tassistenten, Logop\xe4den).'],prozesskriterien:['Systematisches Screening auf Mangelern\xe4hrung bei Aufnahme und regelm\xe4\xdfig.','Umfassendes Assessment bei Risiko (Essbiografie, Kau-/Schluckf\xe4higkeit, BMI, Bed\xfcrfnisse/Vorlieben).','Individuelle Ma\xdfnahmenplanung (z.B. angepasste Kostform, Anreicherung, Trinknahrung, Unterst\xfctzung beim Essen/Trinken).','Sicherstellung einer ausreichenden Fl\xfcssigkeitszufuhr.','Regelm\xe4\xdfige \xdcberpr\xfcfung der Nahrungs-/Fl\xfcssigkeitsaufnahme und des Gewichtsverlaufs.','Beratung und Schulung von Patienten/Bewohnern und Angeh\xf6rigen.'],ergebniskriterien:['Der Ern\xe4hrungszustand des Patienten/Bewohners ist stabil oder verbessert sich.','Eine ausreichende Nahrungs- und Fl\xfcssigkeitszufuhr ist gew\xe4hrleistet.','Patienten/Bewohner \xe4u\xdfern Zufriedenheit mit der Ern\xe4hrungssituation.']},{id:"mobilisation",title:"F\xf6rderung der Mobilit\xe4t",ziel:"Erhaltung und F\xf6rderung der Bewegungsf\xe4higkeit zur Vermeidung von Immobilit\xe4tsfolgen (z.B. Kontrakturen, Thrombosen, Pneumonien, Dekubitus) und zur Steigerung der Selbstst\xe4ndigkeit und Lebensqualit\xe4t.",strukturkriterien:['Qualifiziertes Personal mit Kenntnissen \xfcber Mobilisationstechniken und Risiken der Immobilit\xe4t.','Verf\xfcgbarkeit geeigneter Hilfsmittel (z.B. Gehhilfen, Transferhilfen, Lifter).','Kooperation mit Physiotherapie und ggf. Ergotherapie.'],prozesskriterien:['Regelm\xe4\xdfiges Assessment des Mobilit\xe4tsstatus, der Ressourcen und Risiken.','Individuelle Planung von Mobilisationsma\xdfnahmen (aktiv, assistiv, passiv).','Fr\xfchmobilisation nach \xe4rztlicher Anordnung (insb. postoperativ).','Anwendung sicherer Transfer- und Lagerungstechniken (z.B. nach Kin\xe4sthetik).','Anleitung und Motivation des Patienten/Bewohners zur Eigenbewegung.','Integration von Bewegung in allt\xe4gliche Aktivit\xe4ten.','Ad\xe4quates Schmerzmanagement als Voraussetzung.'],ergebniskriterien:['Der Patient/Bewohner erh\xe4lt oder verbessert seine Mobilit\xe4t im Rahmen seiner M\xf6glichkeiten.','Immobilit\xe4tsbedingte Komplikationen werden vermieden.','Der Patient/Bewohner f\xfchlt sich sicher bei Mobilisationsma\xdfnahmen.']},{id:"entlassungsmanagement",title:"Entlassungsmanagement in der Pflege",ziel:"Sicherstellung einer kontinuierlichen und bedarfsgerechten Versorgung von Patienten/Bewohnern beim \xdcbergang vom Krankenhaus oder einer anderen Einrichtung in die ambulante Versorgung oder eine andere Versorgungsform.",strukturkriterien:['Benennung einer verantwortlichen Pflegefachkraft f\xfcr das Entlassungsmanagement.','Etablierte Kooperations- und Kommunikationsstrukturen mit internen und externen Partnern (\xc4rzte, Sozialdienst, Therapeuten, Nachversorger).','Verf\xfcgbarkeit von Informationsmaterialien f\xfcr Patienten/Angeh\xf6rige.'],prozesskriterien:['Fr\xfchzeitige Identifikation von Patienten/Bewohnern mit poststation\xe4rem Versorgungs- und Unterst\xfctzungsbedarf.','Systematisches Assessment des individuellen Bedarfs (pflegerisch, sozial, therapeutisch).','Gemeinsame Planung der Entlassung mit Patient/Angeh\xf6rigen (Festlegung von Zielen, Ma\xdfnahmen, Organisation).','Rechtzeitige Organisation der erforderlichen Nachsorge (z.B. ambulanter Pflegedienst, Hilfsmittel, Reha).','Sicherstellung der Informationsweitergabe (z.B. durch Entlassbrief, Pflege\xfcberleitungsbogen).','Schulung und Beratung von Patient/Angeh\xf6rigen zum Selbstmanagement.'],ergebniskriterien:['Der Patient/Bewohner und seine Angeh\xf6rigen f\xfchlen sich gut auf die Entlassung vorbereitet.','Die Kontinuit\xe4t der Versorgung ist gew\xe4hrleistet, Versorgungsl\xfccken werden vermieden.','Rehospitalisierungen aufgrund von Versorgungsproblemen werden reduziert.']},{id:"harnkontinenz",title:"F\xf6rderung der Harnkontinenz in der Pflege",ziel:"Erhaltung oder F\xf6rderung der Harnkontinenz bzw. Bew\xe4ltigung von Inkontinenz zur Verbesserung der Lebensqualit\xe4t, Vermeidung von Komplikationen und St\xe4rkung der Autonomie.",strukturkriterien:['Qualifiziertes Personal mit Kenntnissen \xfcber Kontinenzf\xf6rderung und Inkontinenzversorgung.','Verf\xfcgbarkeit von Assessmentinstrumenten (z.B. Miktionsprotokoll, Kontinenzprofil).','Zugang zu geeigneten Inkontinenzhilfsmitteln und Ressourcen f\xfcr Kontinenztraining.'],prozesskriterien:['Systematisches Assessment bei Aufnahme und Bedarf (Kontinenzstatus, Ursachen, Ressourcen, Auswirkungen).','Erstellung eines individuellen Kontinenzprofils.','Planung und Durchf\xfchrung individuell abgestimmter Ma\xdfnahmen (z.B. Toilettentraining, Beckenbodentraining, Fl\xfcssigkeitsmanagement, Hilfsmittelberatung/-versorgung, Hautschutz).','Beratung und Anleitung von Patienten/Bewohnern und Angeh\xf6rigen.','Regelm\xe4\xdfige Evaluation der Ma\xdfnahmen und Anpassung des Plans.'],ergebniskriterien:['Der Patient/Bewohner erreicht die bestm\xf6gliche Kontinenz oder eine ad\xe4quate Kompensation der Inkontinenz.','Hautkomplikationen im Zusammenhang mit Inkontinenz werden vermieden.','Die Lebensqualit\xe4t und soziale Teilhabe des Patienten/Bewohners verbessern sich.']},{id:"chronische_wunden",title:"Pflege von Menschen mit chronischen Wunden",ziel:"F\xf6rderung der Wundheilung, Vermeidung von Wundinfektionen, Reduktion von Schmerzen und Geruch, Verbesserung der Lebensqualit\xe4t bei Menschen mit chronischen Wunden (z.B. Dekubitus, Ulcus cruris, Diabetisches Fu\xdfsyndrom).",strukturkriterien:['Qualifiziertes Personal mit spezifischem Wissen im Wundmanagement (z.B. Wundexperten ICW/DGfW).','Verf\xfcgbarkeit von geeigneten Materialien f\xfcr Wunddiagnostik und -therapie (moderne Wundauflagen, Verbandmaterialien).','Etablierte interdisziplin\xe4re Zusammenarbeit (\xc4rzte verschiedener Fachrichtungen, Podologen, etc.).'],prozesskriterien:['Umfassendes Assessment: Beurteilung der Wunde (Lokalisation, Gr\xf6\xdfe, Tiefe, Wundgrund, Exsudat, Geruch, Schmerz) und des Patienten (Grunderkrankungen, Ern\xe4hrungszustand, Mobilit\xe4t, psychosoziale Faktoren).','Planung und Durchf\xfchrung einer phasengerechten lokalen Wundtherapie (D\xe9bridement, Wundreinigung, Exsudatmanagement, Auswahl geeigneter Wundauflagen).','Management wundbedingter Symptome (Schmerz, Geruch, Juckreiz).','Unterst\xfctzung der Kausaltherapie (z.B. Kompressionstherapie bei Ulcus cruris venosum, Druckentlastung bei Dekubitus).','Ma\xdfnahmen zur Rezidivprophylaxe.','Beratung, Anleitung und Schulung von Patient/Angeh\xf6rigen zum Selbstmanagement.','Regelm\xe4\xdfige Evaluation und Anpassung des Therapieplans.'],ergebniskriterien:['Die Wundheilung schreitet voran, die Wundgr\xf6\xdfe reduziert sich.','Infektionszeichen werden vermieden oder fr\xfchzeitig behandelt.','Wundbedingte Schmerzen und andere Symptome werden gelindert.','Die Lebensqualit\xe4t und Selbstpflegef\xe4higkeit des Patienten verbessern sich.']},{id:"geburt",title:"F\xf6rderung der physiologischen Geburt",ziel:"Unterst\xfctzung und F\xf6rderung des nat\xfcrlichen Geburtsverlaufs unter Ber\xfccksichtigung der physischen und psychischen Bed\xfcrfnisse der Frau, um Interventionen zu minimieren und ein positives Geburtserlebnis zu erm\xf6glichen.",strukturkriterien:['Hebammengeleitete Betreuung ist verf\xfcgbar und wird unterst\xfctzt.','Geeignete r\xe4umliche und materielle Voraussetzungen f\xfcr eine physiologische Geburt (z.B. Geb\xe4rwanne, alternative Geburtspositionen).','Klare Kommunikationswege und Kooperation im interprofessionellen Team (Hebammen, \xc4rzte, An\xe4sthesie).'],prozesskriterien:['Kontinuierliche 1:1-Betreuung durch eine Hebamme w\xe4hrend der aktiven Geburtsphase.','F\xf6rderung der Mobilit\xe4t und freie Wahl der Geburtsposition durch die Frau.','Anwendung nicht-pharmakologischer Methoden zur Schmerzlinderung (z.B. Wassergeburt, Massage, Atmung).','Zur\xfcckhaltender Einsatz von Interventionen (z.B. Wehenmittel, Episiotomie) basierend auf Indikation.','Respektvolle Kommunikation und gemeinsame Entscheidungsfindung mit der Frau.','Unmittelbarer und ungest\xf6rter Hautkontakt zwischen Mutter und Kind nach der Geburt (Bonding).'],ergebniskriterien:['Die Rate an vaginalen Spontangeburten ist hoch.','Die Rate an medizinischen Interventionen ist niedrig.','Die Frauen berichten \xfcber ein positives Geburtserlebnis und hohe Zufriedenheit mit der Betreuung.','M\xfctterliche und kindliche Morbidit\xe4t im Zusammenhang mit der Geburt sind gering.']},{id:"demenz_beziehung",title:"Beziehungsgestaltung in der Pflege von Menschen mit Demenz",ziel:"Aufbau und Erhalt einer person-zentrierten, unterst\xfctzenden Beziehung zu Menschen mit Demenz, um deren Wohlbefinden, Sicherheit, Autonomie und soziale Teilhabe zu f\xf6rdern.",strukturkriterien:['Pflegefachkr\xe4fte verf\xfcgen \xfcber spezifisches Wissen zu Demenzerkrankungen, Kommunikationstechniken (z.B. Validation) und person-zentrierten Ans\xe4tzen.','Ausreichend Zeitressourcen f\xfcr Beziehungsgestaltung im Pflegealltag.','Schaffung einer demenzfreundlichen Umgebung (Milieugestaltung).'],prozesskriterien:['Erfassung der Biografie, der individuellen Bed\xfcrfnisse, Vorlieben und Ressourcen der Person mit Demenz.','Anwendung person-zentrierter Kommunikationsstrategien (z.B. Validation, aktives Zuh\xf6ren, nonverbale Kommunikation).','Anpassung der Pflege und Betreuung an den individuellen Tagesrhythmus und die jeweilige Situation.','Validierender und ressourcenorientierter Umgang mit herausforderndem Verhalten.','Einbeziehung von Angeh\xf6rigen als Partner in der Beziehungsgestaltung.','Kontinuierliche Reflexion der eigenen Haltung und des Beziehungsgeschehens im Team.'],ergebniskriterien:['Die Person mit Demenz zeigt Zeichen von Wohlbefinden und Sicherheit.','Herausforderndes Verhalten tritt seltener auf oder kann besser verstanden und begleitet werden.','Die soziale Teilhabe und die Lebensqualit\xe4t der Person mit Demenz sind verbessert.','Angeh\xf6rige f\xfchlen sich in die Pflege einbezogen und unterst\xfctzt.']},{id:"mundgesundheit",title:"Erhaltung und F\xf6rderung der Mundgesundheit in der Pflege",ziel:"Erhaltung oder Verbesserung der Mundgesundheit zur Vermeidung von Schmerzen, Infektionen (z.B. Pneumonie), Beeintr\xe4chtigungen der Nahrungsaufnahme und zur F\xf6rderung des allgemeinen Wohlbefindens.",strukturkriterien:['Qualifiziertes Personal mit Kenntnissen \xfcber Mundpflege, Risikofaktoren und Assessmentinstrumente.','Verf\xfcgbarkeit geeigneter Materialien zur Mund- und Prothesenpflege.','Etablierte Kooperation mit Zahn\xe4rzten/Zahntechnikern.'],prozesskriterien:['Systematisches Assessment der Mundh\xf6hle (Z\xe4hne, Zahnfleisch, Schleimhaut, Prothese, Zunge, Speichelfluss) bei Aufnahme und regelm\xe4\xdfig.','Identifikation individueller Risiken (z.B. Mundtrockenheit, Kau-/Schluckst\xf6rungen, Medikamente).','Planung und Durchf\xfchrung einer individuellen, bedarfsgerechten Mund- und Prothesenpflege (mind. 2x t\xe4glich).','Anleitung und Unterst\xfctzung des Patienten/Bewohners bei der Mundpflege.','Sicherstellung einer ausreichenden Mundbefeuchtung.','Bei Bedarf Hinzuziehung eines Zahnarztes.','Dokumentation des Mundstatus und der durchgef\xfchrten Ma\xdfnahmen.'],ergebniskriterien:['Die Mundh\xf6hle ist sauber, intakt und ausreichend befeuchtet.','Anzeichen von oralen Erkrankungen (z.B. Karies, Parodontitis, Soor) werden vermieden oder fr\xfchzeitig erkannt und behandelt.','Die F\xe4higkeit zur Nahrungsaufnahme ist nicht durch orale Probleme beeintr\xe4chtigt.','Der Patient/Bewohner \xe4u\xdfert Wohlbefinden bez\xfcglich seines Mundzustands.']},{id:"standard-hautintegritaet",title:"Erhaltung und F\xf6rderung der Hautintegrit\xe4t in der Pflege",ziel:"Erhaltung der intakten Haut und Vermeidung von Hautsch\xe4den, die \xfcber Dekubitus hinausgehen (z.B. inkontinenzassoziierte Dermatitis (IAD), Intertrigo, Skin Tears, Xerosis Cutis).",strukturkriterien:['Qualifiziertes Personal mit Wissen \xfcber Hautphysiologie, Risikofaktoren f\xfcr Hautsch\xe4den und pr\xe4ventive Hautpflegema\xdfnahmen.','Verf\xfcgbarkeit geeigneter Hautpflegeprodukte (pH-neutral, r\xfcckfettend, Hautschutzprodukte).','Interdisziplin\xe4re Zusammenarbeit bei spezifischen Hautproblemen.'],prozesskriterien:['Systematisches Assessment des Hautzustands und individueller Risikofaktoren (z.B. Alter, Inkontinenz, Mobilit\xe4tseinschr\xe4nkung, Ern\xe4hrungszustand, Medikamente) bei Aufnahme und regelm\xe4\xdfig.','Planung und Durchf\xfchrung einer individuellen, risikoadaptierten Hautpflege (schonende Reinigung, ad\xe4quate R\xfcckfettung, Hautschutz bei Inkontinenz/Feuchtigkeit).','Minimierung von Reibungs- und Scherkr\xe4ften (z.B. durch Transfertechniken, geeignete Kleidung/Bettw\xe4sche).','Management von Feuchtigkeit (z.B. ad\xe4quate Inkontinenzversorgung, Hautfaltenpflege).','Ber\xfccksichtigung des Ern\xe4hrungszustands und der Fl\xfcssigkeitszufuhr.','Beratung und Anleitung von Patient/Bewohner und Angeh\xf6rigen zur Hautpflege und Selbstbeobachtung.'],ergebniskriterien:['Die Haut des Patienten/Bewohners ist intakt und weist keine vermeidbaren Sch\xe4digungen auf.','Fr\xfchzeichen von Hautsch\xe4den werden rechtzeitig erkannt und behandelt.','Der Patient/Bewohner \xe4u\xdfert Wohlbefinden bez\xfcglich seines Hautzustands.']}],new Map);[{id:'dekubitus',term:'Dekubitus',definition:'Ein Dekubitus (Druckgeschw\xfcr, Wundliegen) ist eine lokale Sch\xe4digung der Haut und/oder des darunterliegenden Gewebes, typischerweise \xfcber kn\xf6chernen Vorspr\xfcngen, infolge von Druck oder Druck in Kombination mit Scherkr\xe4ften. Risikofaktoren umfassen eingeschr\xe4nkte Mobilit\xe4t, schlechte Durchblutung, Mangelern\xe4hrung und Feuchtigkeit. Die Vorbeugung umfasst regelm\xe4\xdfige Positionswechsel, druckentlastende Hilfsmittel und sorgf\xe4ltige Hautpflege.'},{id:'dysphagie',term:'Dysphagie',definition:'Dysphagie bezeichnet Schluckst\xf6rungen, die das sichere und effiziente Transportieren von Nahrung und Fl\xfcssigkeiten vom Mund in den Magen beeintr\xe4chtigen. Ursachen k\xf6nnen neurologische Erkrankungen (z.B. Schlaganfall, Parkinson), strukturelle Ver\xe4nderungen oder altersbedingte Faktoren sein. Symptome umfassen Husten beim Essen/Trinken, gurgelnde Stimme, Nahrungsreste im Mund und h\xe4ufige Atemwegsinfektionen durch Aspiration. Das Management beinhaltet logop\xe4dische Therapie, angepasste Konsistenzen und Schlucktechniken.'},{id:'exsikkose',term:'Exsikkose',definition:'Exsikkose bezeichnet einen Wassermangel im K\xf6rper, bei dem mehr Fl\xfcssigkeit verloren geht als aufgenommen wird. Ursachen k\xf6nnen unzureichende Fl\xfcssigkeitszufuhr, erh\xf6hte Verluste (Fieber, Erbrechen, Durchfall) oder Medikamentenwirkungen sein. Erkennbar ist sie an trockenen Schleimh\xe4uten, vermindertem Hautturgor, M\xfcdigkeit, Verwirrtheit und konzentriertem Urin. Die Behandlung umfasst kontrollierte Fl\xfcssigkeitszufuhr, bei schweren F\xe4llen intraven\xf6se Hydratation.'},{id:'pvk',term:'PVK (Peripherer Venenkatheter)',definition:'Ein d\xfcnner Kunststoffschlauch, der in eine periphere Vene (meist am Arm oder Handr\xfccken) eingef\xfchrt wird, um Infusionen oder Medikamente zu verabreichen.'},{id:'zvk',term:'ZVK (Zentraler Venenkatheter)',definition:'Ein Katheter, dessen Spitze in einer gro\xdfen, herznahen Vene liegt. Dient zur Verabreichung hochkonzentrierter L\xf6sungen, Medikamente oder zur Messung des zentralen Venendrucks.'},{id:'bz',term:'BZ (Blutzucker)',definition:'Die Konzentration von Glukose im Blut. Wichtig f\xfcr die Diagnostik und Therapie von Diabetes mellitus.'},{id:'rr',term:'RR (Riva-Rocci)',definition:'Abk\xfcrzung f\xfcr den Blutdruck, gemessen nach der Methode von Scipione Riva-Rocci (indirekte Messung mittels Manschette).'},{id:'copd',term:'COPD (Chronisch obstruktive Lungenerkrankung)',definition:'Eine fortschreitende Lungenkrankheit, gekennzeichnet durch chronische Entz\xfcndung der Atemwege und Zerst\xf6rung des Lungengewebes, oft verbunden mit Rauchen.'},{id:'peg',term:'PEG (Perkutane endoskopische Gastrostomie)',definition:'Eine durch die Bauchwand direkt in den Magen gelegte Sonde zur k\xfcnstlichen Ern\xe4hrung.'},{id:'ekg',term:'EKG (Elektrokardiogramm)',definition:'Aufzeichnung der elektrischen Aktivit\xe4t des Herzens zur Beurteilung von Herzrhythmus und -funktion.'},{id:'aspiration',term:'Aspiration',definition:'Das Einatmen von Fremdk\xf6rpern, Fl\xfcssigkeiten (z.B. Speichel, Nahrung, Mageninhalt) in die Atemwege.'},{id:'kontraktur',term:'Kontraktur',definition:'Eine dauerhafte Verk\xfcrzung von Muskeln, Sehnen oder B\xe4ndern, die zu einer Bewegungseinschr\xe4nkung oder Fehlstellung eines Gelenks f\xfchrt.'},{id:'bradykardie',term:'Bradykardie',definition:'Eine verlangsamte Herzfrequenz unter 60 Schl\xe4ge pro Minute. Kann symptomlos sein oder zu Schwindel, M\xfcdigkeit und Synkopen f\xfchren.'},{id:'tachykardie',term:'Tachykardie',definition:'Eine erh\xf6hte Herzfrequenz \xfcber 100 Schl\xe4ge pro Minute. Symptome k\xf6nnen Herzklopfen, Kurzatmigkeit und Brustschmerzen umfassen.'},{id:'orthopnoe',term:'Orthopnoe',definition:'Atemnot im Liegen, die sich beim Aufrichten bessert. Typisches Symptom bei Herzinsuffizienz.'},{id:'dyspnoe',term:'Dyspnoe',definition:'Subjektives Gef\xfchl der Atemnot oder Kurzatmigkeit, oft als "Lufthunger" beschrieben. Kann verschiedene Ursachen haben, z.B. kardiale, pulmonale oder psychische.'},{id:'thrombose',term:'Thrombose',definition:'Bildung eines Blutgerinnsels in einem Blutgef\xe4\xdf. H\xe4ufig in den tiefen Beinvenen (Tiefe Venenthrombose), kann bei L\xf6sung eine Lungenembolie verursachen.'},{id:'embolie',term:'Embolie',definition:'Verschleppung eines Thrombus oder anderen Materials im Blutkreislauf mit Verstopfung eines Gef\xe4\xdfes. Lungenembolie ist die h\xe4ufigste schwerwiegende Form.'},{id:'hypertonie',term:'Hypertonie (Bluthochdruck)',definition:'Dauerhaft erh\xf6hter Blutdruck \xfcber 140/90 mmHg. Risikofaktor f\xfcr Herz-Kreislauf-Erkrankungen, oft symptomlos ("stiller Killer").'},{id:'hypotonie',term:'Hypotonie (niedriger Blutdruck)',definition:'Blutdruck unter 100/60 mmHg. Kann zu Schwindel, M\xfcdigkeit und Synkopen f\xfchren, muss aber nicht behandlungsbed\xfcrftig sein.'},{id:'anamnese',term:'Anamnese',definition:'Die systematische Befragung des Patienten durch medizinisches Fachpersonal zur Erhebung der Krankengeschichte. Sie umfasst Informationen zu aktuellen Beschwerden, Vorerkrankungen, Familienanamnese, Medikation, Allergien und Lebensgewohnheiten und bildet die Grundlage f\xfcr Diagnose und Therapie.'},{id:'auskultation',term:'Auskultation',definition:'Untersuchungsmethode, bei der mit Stethoskop oder blo\xdfem Ohr K\xf6rperger\xe4usche (z.B. Herzt\xf6ne, Atemger\xe4usche, Darmger\xe4usche) wahrgenommen und beurteilt werden, um R\xfcckschl\xfcsse auf den Funktionszustand von Organen zu ziehen.'},{id:'biopsie',term:'Biopsie',definition:'Entnahme einer Gewebeprobe aus dem lebenden Organismus zur anschlie\xdfenden histologischen, mikrobiologischen oder genetischen Untersuchung. Dient der Diagnostik von Erkrankungen, besonders zur Abkl\xe4rung von Tumorverdacht.'},{id:'bradypnoe',term:'Bradypnoe',definition:'Verlangsamte Atmung mit einer Atemfrequenz unter 12 Atemz\xfcgen pro Minute beim Erwachsenen. Kann durch Medikamente (Opioide), erh\xf6hten Hirndruck, metabolische St\xf6rungen oder als Zeichen einer Ersch\xf6pfung bei Ateminsuffizienz auftreten.'},{id:'compliance',term:'Compliance/Adh\xe4renz',definition:'Das Ausma\xdf, in dem das Verhalten eines Patienten mit den medizinischen Empfehlungen (Medikamenteneinnahme, Lebensstil\xe4nderungen, Wahrnehmung von Terminen) \xfcbereinstimmt. Neuere Begriffe wie "Adh\xe4renz" oder "Therapietreue" betonen die aktive Patientenbeteiligung.'},{id:'defibrillation',term:'Defibrillation',definition:'Therapiema\xdfnahme bei bestimmten lebensbedrohlichen Herzrhythmusst\xf6rungen (Kammerflimmern, pulslose ventrikul\xe4re Tachykardie), bei der durch gezielte Stromabgabe eine Synchronisation des Herzrhythmus erreicht werden soll. Erfolgt manuell oder automatisiert (AED).'},{id:'dialyse',term:'Dialyse',definition:'Blutreinigungsverfahren bei Nierenversagen, das die Entfernung von harnpflichtigen Substanzen, Wasser und Elektrolyten aus dem Blut erm\xf6glicht. Hauptformen sind H\xe4modialyse (Filterung durch semipermeable Membran) und Peritonealdialyse (Bauchh\xf6hle als Filter).'},{id:'epidemiologie',term:'Epidemiologie',definition:'Wissenschaft, die sich mit der Verteilung und den Determinanten von Krankheiten in Bev\xf6lkerungsgruppen befasst. Untersucht Krankheitsh\xe4ufigkeiten, Risikofaktoren, Krankheitsfolgen und dient als Grundlage f\xfcr pr\xe4ventive Ma\xdfnahmen und Gesundheitspolitik.'},{id:'fatigue',term:'Fatigue-Syndrom',definition:'Zustand anhaltender Ersch\xf6pfung und Leistungsminderung, der durch Ruhe nicht ausreichend gebessert wird. Tritt h\xe4ufig als Begleitsymptom bei chronischen Erkrankungen, insbesondere bei Krebs (Cancer-related Fatigue), aber auch nach Infektionen oder bei psychischen Erkrankungen auf.'},{id:'gcs',term:'Glasgow Coma Scale (GCS)',definition:'Bewertungssystem zur Beurteilung des Bewusstseinszustands. Bewertet werden Augen\xf6ffnen (1-4 Punkte), verbale Reaktion (1-5 Punkte) und motorische Reaktion (1-6 Punkte). Die Summe (3-15 Punkte) gibt Hinweise auf die Schwere einer Bewusstseinsst\xf6rung.'},{id:'habitus',term:'Habitus',definition:'Das \xe4u\xdfere Erscheinungsbild, die K\xf6rperhaltung und das Verhalten eines Patienten, das wichtige diagnostische Hinweise liefern kann. Bestimmte Erkrankungen zeigen charakteristische Habitusformen (z.B. Cushing-Habitus, Marfan-Habitus).'},{id:'ileostoma',term:'Ileostoma',definition:'K\xfcnstlicher D\xfcnndarmausgang in der Bauchwand (meist im rechten Unterbauch), bei dem der D\xfcnndarm (Ileum) nach au\xdfen verlegt wird. Kann tempor\xe4r oder permanent sein und dient der Ausleitung von Stuhl bei verschiedenen Darmerkrankungen oder nach Operationen.'}].forEach((function(n){l.set(n.id,n)})),t.default.forEach((function(n){var t=n.term.replace(/\)$/,'');l.has(n.id)||l.set(n.id,{id:n.id,term:t,definition:n.definition})})),s.default.forEach((function(n){l.has(n.id)||l.set(n.id,n)})),u.default.forEach((function(n){l.has(n.id)||l.set(n.id,n)})),h.default.forEach((function(n){l.has(n.id)||l.set(n.id,n)}));e.lexikonEntries=Array.from(l.values())}),625,[1,626,627,628,629]);
