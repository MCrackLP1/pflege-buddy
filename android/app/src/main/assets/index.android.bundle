ition:'Durchblutung, Motorik, Sensibilit\xe4t - wichtige neurologische Beurteilungskriterien'},{id:'echo',term:'ECHO',definition:'Echokardiographie - Ultraschalluntersuchung des Herzens'},{id:'aortenaneurysma',term:'Aortenaneurysma',definition:'Aussackung der Hauptschlagader aufgrund einer Gef\xe4\xdfwandschw\xe4che, die unbehandelt zum Riss (Ruptur) f\xfchren kann'},{id:'aplastische-anaemie',term:'Aplastische An\xe4mie',definition:'Seltene, schwere Erkrankung des Knochenmarks mit verminderter Produktion aller Blutzelltypen'},{id:'asthma-bronchiale',term:'Asthma bronchiale',definition:'Chronische Entz\xfcndung der Atemwege mit anfallsartiger Atemnot durch Verengung der Bronchien'},{id:'atriale-fibrillation',term:'Atriale Fibrillation',definition:'Herzrhythmusst\xf6rung mit unkoordinierter Erregung der Vorh\xf6fe, h\xe4ufigste Ursache f\xfcr Schlaganf\xe4lle'},{id:'bandscheibenvorfall',term:'Bandscheibenvorfall',definition:'Verlagerung von Bandscheibengewebe in den Wirbelkanal mit m\xf6glicher Kompression der Spinalnerven'},{id:'basalzellkarzinom',term:'Basalzellkarzinom',definition:'H\xe4ufigster maligner Hauttumor, der selten metastasiert aber lokal destruierend w\xe4chst'},{id:'cholelithiasis',term:'Cholelithiasis',definition:'Gallensteinleiden mit Bildung von Konkrementen in der Gallenblase oder den Gallenwegen'},{id:'colitis-ulcerosa',term:'Colitis ulcerosa',definition:'Chronisch-entz\xfcndliche Darmerkrankung mit Geschw\xfcrbildung im Dickdarm, beginnend im Rektum'},{id:'delir',term:'Delir',definition:'Akuter Verwirrtheitszustand mit St\xf6rung von Bewusstsein, Aufmerksamkeit und Kognition, oft mit Halluzinationen'},{id:'demenz',term:'Demenz',definition:'Chronisch fortschreitender Verlust kognitiver F\xe4higkeiten mit Beeintr\xe4chtigung von Ged\xe4chtnis, Denken, Orientierung und Sprache'},{id:'divertikulitis',term:'Divertikulitis',definition:'Entz\xfcndung von Ausst\xfclpungen der Darmwand (Divertikel), meist im Sigma, mit Bauchschmerzen und Fieber'},{id:'endokarditis',term:'Endokarditis',definition:'Entz\xfcndung der Herzinnenhaut, h\xe4ufig infekti\xf6s bedingt, mit Beteiligung der Herzklappen'},{id:'epilepsie',term:'Epilepsie',definition:'Neurologische Erkrankung mit wiederkehrenden Anf\xe4llen durch abnorme synchrone elektrische Aktivit\xe4t im Gehirn'},{id:'fibromyalgie',term:'Fibromyalgie',definition:'Chronisches Schmerzsyndrom mit weit verbreiteten Muskel- und Gelenkschmerzen, Fatigue und Schlafst\xf6rungen'},{id:'gicht',term:'Gicht',definition:'Stoffwechselerkrankung mit erh\xf6hten Harns\xe4urewerten und akuten Gelenkentz\xfcndungen, besonders am Gro\xdfzehengrundgelenk'},{id:'guillain-barre-syndrom',term:'Guillain-Barr\xe9-Syndrom',definition:'Akute entz\xfcndliche Polyneuropathie mit aufsteigenden L\xe4hmungen, meist nach Infekten'},{id:'harnwegsinfekt',term:'Harnwegsinfektion',definition:'Bakterielle Infektion der ableitenden Harnwege mit Dysurie, Pollakisurie und H\xe4maturie'},{id:'herpes-zoster',term:'Herpes Zoster',definition:'Viruserkrankung mit schmerzhaftem, g\xfcrtelf\xf6rmigem Hautausschlag durch Reaktivierung des Varizella-Zoster-Virus'},{id:'insulinom',term:'Insulinom',definition:'Seltener Tumor des Pankreas mit autonomer Insulinproduktion und Hypoglyk\xe4mien'},{id:'kardiomyopathie',term:'Kardiomyopathie',definition:'Gruppe von Herzmuskelerkrankungen mit strukturellen und funktionellen Ver\xe4nderungen des Myokards'},{id:'ace-hemmer',term:'ACE-Hemmer',definition:'Angiotensin-Converting-Enzyme-Hemmer, Medikamentengruppe zur Behandlung von Bluthochdruck und Herzinsuffizienz'},{id:'analgetika',term:'Analgetika',definition:'Schmerzmittel, unterteilt in Nicht-Opioid-Analgetika, schwache und starke Opioide nach WHO-Stufenschema'},{id:'antibiotika',term:'Antibiotika',definition:'Arzneimittel zur Behandlung bakterieller Infektionen, nach Wirkmechanismus und Spektrum klassifiziert'},{id:'antikoagulanzien',term:'Antikoagulanzien',definition:'Gerinnungshemmer zur Thromboseprophylaxe und -therapie, z.B. Heparine, Vitamin-K-Antagonisten, DOAKs'},{id:'antidepressiva',term:'Antidepressiva',definition:'Arzneimittel zur Behandlung von Depressionen und Angstst\xf6rungen (SSRI, SNRI, trizyklische Antidepressiva, MAO-Hemmer)'},{id:'antiemetika',term:'Antiemetika',definition:'Medikamente gegen \xdcbelkeit und Erbrechen, z.B. Metoclopramid, Ondansetron, Dimenhydrinat'},{id:'antihypertensiva',term:'Antihypertensiva',definition:'Medikamente zur Blutdrucksenkung, Klassen: Diuretika, Beta-Blocker, ACE-Hemmer, AT1-Blocker, Kalziumantagonisten'},{id:'antikonvulsiva',term:'Antikonvulsiva',definition:'Antiepileptika zur Behandlung von Krampfanf\xe4llen und neuropathischen Schmerzen'},{id:'antipyretika',term:'Antipyretika',definition:'Fiebersenkende Mittel wie Paracetamol, Ibuprofen oder Acetylsalicyls\xe4ure'},{id:'antipsychotika',term:'Antipsychotika',definition:'Neuroleptika zur Behandlung von Psychosen, Schizophrenie und akuter Agitiertheit, typische und atypische'},{id:'benzodiazepine',term:'Benzodiazepine',definition:'Psychopharmaka mit anxiolytischer, sedierender, hypnotischer und muskelrelaxierender Wirkung, h\xe4ufig zur Kurzzeitbehandlung von Angst- und Schlafst\xf6rungen'},{id:'beta-blocker',term:'Beta-Blocker',definition:'Betarezeptorenblocker zur Behandlung von Bluthochdruck, Herzrhythmusst\xf6rungen und koronarer Herzkrankheit'},{id:'bisphosphonate',term:'Bisphosphonate',definition:'Medikamente zur Behandlung von Osteoporose und Knochenmetastasen, hemmen den Knochenabbau'},{id:'diuretika',term:'Diuretika',definition:'Harntreibende Medikamente zur Behandlung von \xd6demen, Bluthochdruck und Herzinsuffizienz'},{id:'glukokortikoide',term:'Glukokortikoide',definition:'Kortisonderivate mit entz\xfcndungshemmender und immunsuppressiver Wirkung'},{id:'aktivierende-pflege',term:'Aktivierende Pflege',definition:'Pflegekonzept, das die Selbst\xe4ndigkeit und Eigenverantwortung des Patienten f\xf6rdert und Ressourcen st\xe4rkt'},{id:'assessment',term:'Assessment',definition:'Systematische Erfassung und Beurteilung des Pflegebedarfs eines Patienten nach strukturierten Kriterien'},{id:'basale-stimulation',term:'Basale Stimulation',definition:'Pflegekonzept zur F\xf6rderung der Wahrnehmung durch grundlegende Reize bei Menschen mit Wahrnehmungsbeeintr\xe4chtigungen'},{id:'bobath-konzept',term:'Bobath-Konzept',definition:'Therapeutisches Konzept f\xfcr neurologische Patienten, das auf Normalisierung des Muskeltonus und physiologische Bewegungsmuster abzielt'},{id:'dekubitusprophylaxe',term:'Dekubitusprophylaxe',definition:'Ma\xdfnahmen zur Vorbeugung von Druckgeschw\xfcren durch Lagerungswechsel, Druckentlastung und Hautpflege'},{id:'expertenstandard',term:'Expertenstandard',definition:'Evidenzbasierte Handlungsempfehlung zu bestimmten Pflegethemen, die den aktuellen Kenntnisstand darstellen'},{id:'kinaesthetics',term:'Kinaesthetics',definition:'Konzept zur Wahrnehmung und Bewegung, das in der Pflege zur schonenden Mobilisation eingesetzt wird'},{id:'kontrakturprophylaxe',term:'Kontrakturprophylaxe',definition:'Vorbeugung von Gelenkversteifungen durch passive und aktive Bewegungs\xfcbungen'},{id:'pflegediagnose',term:'Pflegediagnose',definition:'Professionelle Beurteilung der Reaktionen eines Menschen auf gesundheitliche Probleme oder Lebensprozesse'},{id:'pflegeplanung',term:'Pflegeplanung',definition:'Systematischer Prozess zur Planung der individuellen Pflege mit Erfassung, Diagnose, Zielsetzung, Ma\xdfnahmen und Evaluation'},{id:'prophylaxen',term:'Prophylaxen',definition:'Vorbeugende Ma\xdfnahmen in der Pflege, z.B. gegen Dekubitus, Pneumonie, Thrombose, Kontrakturen und Sturz'},{id:'thromboseprophylaxe',term:'Thromboseprophylaxe',definition:'Ma\xdfnahmen zur Vorbeugung von Blutgerinnseln, medikament\xf6s (z.B. Heparin) und physikalisch (z.B. Kompressionsstr\xfcmpfe, Mobilisation)'},{id:'appendix',term:'Appendix',definition:'Wurmfortsatz des Blinddarms, ca. 5-10 cm langer blinder Fortsatz am Ende des Blinddarms'},{id:'axilla',term:'Axilla',definition:'Achselh\xf6hle, Bereich zwischen Oberarm und seitlicher Brustwand'},{id:'bronchien',term:'Bronchien',definition:'Luftr\xf6hren\xe4ste, die sich nach der Teilung der Trachea baumf\xf6rmig verzweigen und die Luft zu den Lungenbl\xe4schen transportieren'},{id:'duodenum',term:'Duodenum',definition:'Zw\xf6lffingerdarm, erster Abschnitt des D\xfcnndarms, bogenf\xf6rmig um den Pankreaskopf gelegen'},{id:'epigastrium',term:'Epigastrium',definition:'Oberbauch, Region zwischen Rippenbogen und Nabel'},{id:'faszie',term:'Faszie',definition:'Bindegewebsschicht, die Muskeln, Muskelgruppen und Organe umh\xfcllt und voneinander trennt'},{id:'foramen-magnum',term:'Foramen magnum',definition:'Gro\xdfe Hinterhaupts\xf6ffnung an der Sch\xe4delbasis, durch die das R\xfcckenmark in den Wirbelkanal \xfcbergeht'},{id:'gyrus',term:'Gyrus',definition:'Hirnwindung, erhabene Struktur der Gro\xdfhirnrinde'},{id:'hypophyse',term:'Hypophyse',definition:'Hirnanhangdr\xfcse an der Sch\xe4delbasis, steuert als \xfcbergeordnete Hormondr\xfcse viele K\xf6rperfunktionen'},{id:'ileum',term:'Ileum',definition:'Krummdarm, letzter Abschnitt des D\xfcnndarms vor dem \xdcbergang in den Dickdarm'},{id:'jejunum',term:'Jejunum',definition:'Leerdarm, mittlerer Abschnitt des D\xfcnndarms zwischen Duodenum und Ileum'},{id:'mediastinum',term:'Mediastinum',definition:'Mittelfellraum, Raum zwischen den beiden Lungenfl\xfcgeln, enth\xe4lt Herz, gro\xdfe Gef\xe4\xdfe, Luftr\xf6hre, Speiser\xf6hre'},{id:'meninges',term:'Meninges',definition:'Hirnh\xe4ute, drei Schichten (Dura mater, Arachnoidea, Pia mater), die das zentrale Nervensystem umh\xfcllen'},{id:'miktion',term:'Miktion',definition:'Harnlassen, Entleerung der Harnblase \xfcber die Harnr\xf6hre'},{id:'niere',term:'Niere',definition:'Paariges Organ im Retroperitonealraum, verantwortlich f\xfcr Harnbildung, Regulation des Wasser- und Elektrolythaushalts sowie Blutdrucks'},{id:'perikard',term:'Perikard',definition:'Herzbeutel, umschlie\xdft das Herz und besteht aus einem \xe4u\xdferen fibr\xf6sen und einem inneren ser\xf6sen Blatt'},{id:'peritoneum',term:'Peritoneum',definition:'Bauchfell, ser\xf6se Auskleidung der Bauchh\xf6hle und \xdcberzug der Bauchorgane'},{id:'pleura',term:'Pleura',definition:'Brustfell, ser\xf6se Membran, die den Brustkorb auskleidet (Pleura parietalis) und die Lunge \xfcberzieht (Pleura visceralis)'},{id:'einheit-iu',term:'IE (Internationale Einheit)',definition:'Ma\xdfeinheit f\xfcr die Wirksamkeit von Medikamenten, Vitaminen, Hormonen etc., basierend auf biologischer Aktivit\xe4t'},{id:'einheit-mmol',term:'mmol/l',definition:'Millimol pro Liter, SI-Einheit zur Messung der Stoffmengenkonzentration von Elektrolyten, Glukose etc. im Blut'},{id:'einheit-gfr',term:'ml/min/1,73m\xb2',definition:'Einheit f\xfcr die glomerul\xe4re Filtrationsrate (GFR), bezogen auf eine standardisierte K\xf6rperoberfl\xe4che'},{id:'einheit-ph',term:'pH',definition:'Ma\xdf f\xfcr die Wasserstoffionenkonzentration, gibt den S\xe4uregrad an (7 = neutral, <7 = sauer, >7 = basisch)'},{id:'einheit-map',term:'MAP',definition:'Mittlerer arterieller Druck, wichtiger Parameter f\xfcr die Organperfusion, berechnet aus systolischem und diastolischem Blutdruck'},{id:'labor-hb',term:'H\xe4moglobin (Hb)',definition:'Eisenhaltiger Proteinkomplex der roten Blutk\xf6rperchen, transportiert Sauerstoff. Referenzbereich: M\xe4nner 14-18 g/dl, Frauen 12-16 g/dl'},{id:'labor-thrombozyten',term:'Thrombozyten',definition:'Blutpl\xe4ttchen, wichtig f\xfcr die Blutgerinnung. Referenzbereich: 150.000-400.000/\xb5l'},{id:'labor-leukozyten',term:'Leukozyten',definition:'Wei\xdfe Blutk\xf6rperchen, Bestandteil des Immunsystems. Referenzbereich: 4.000-10.000/\xb5l'},{id:'labor-erythrozyten',term:'Erythrozyten',definition:'Rote Blutk\xf6rperchen, transportieren Sauerstoff. Referenzbereich: M\xe4nner 4,5-5,9 Mio/\xb5l, Frauen 4,0-5,2 Mio/\xb5l'},{id:'labor-mch',term:'MCH',definition:'Mittlerer H\xe4moglobingehalt der Erythrozyten. Referenzbereich: 28-33 pg'},{id:'labor-mchc',term:'MCHC',definition:'Mittlere H\xe4moglobinkonzentration der Erythrozyten. Referenzbereich: 32-36 g/dl'},{id:'labor-mcv',term:'MCV',definition:'Mittleres Erythrozytenvolumen. Referenzbereich: 80-96 fl'},{id:'labor-quick',term:'Quick-Wert',definition:'Ma\xdf f\xfcr die Funktionsf\xe4higkeit des extrinsischen Gerinnungssystems. Referenzbereich: 70-130%'},{id:'labor-inr',term:'INR',definition:'International Normalized Ratio, standardisierter Quick-Wert. Referenzbereich: 0,9-1,2 (bei Antikoagulation h\xf6her)'},{id:'labor-ptt',term:'PTT',definition:'Partielle Thromboplastinzeit, misst das intrinsische Gerinnungssystem. Referenzbereich: 25-40 Sekunden'},{id:'labor-got',term:'GOT (AST)',definition:'Glutamat-Oxalacetat-Transaminase, Enzym der Leber. Referenzbereich: M\xe4nner <50 U/l, Frauen <35 U/l'},{id:'labor-gpt',term:'GPT (ALT)',definition:'Glutamat-Pyruvat-Transaminase, leberspezifisches Enzym. Referenzbereich: M\xe4nner <50 U/l, Frauen <35 U/l'},{id:'labor-gamma-gt',term:'Gamma-GT',definition:'Gamma-Glutamyltransferase, Enzym in Leber, Gallenwegen, Pankreas. Referenzbereich: M\xe4nner <60 U/l, Frauen <40 U/l'},{id:'labor-kreatinin',term:'Kreatinin',definition:'Abbauprodukt des Muskelstoffwechsels, wichtiger Nierenfunktionsparameter. Referenzbereich: M\xe4nner 0,7-1,2 mg/dl, Frauen 0,5-0,9 mg/dl'},{id:'labor-harnstoff',term:'Harnstoff',definition:'Endprodukt des Eiwei\xdfstoffwechsels, Nierenfunktionsparameter. Referenzbereich: 10-50 mg/dl'},{id:'labor-harnsaeure',term:'Harns\xe4ure',definition:'Endprodukt des Purinstoffwechsels, erh\xf6ht bei Gicht. Referenzbereich: M\xe4nner 3,5-7,2 mg/dl, Frauen 2,6-6,0 mg/dl'},{id:'labor-natrium',term:'Natrium',definition:'Wichtigstes Kation im Extrazellul\xe4rraum. Referenzbereich: 135-145 mmol/l'},{id:'labor-kalium',term:'Kalium',definition:'Wichtigstes Kation im Intrazellul\xe4rraum, bedeutsam f\xfcr Herzfunktion. Referenzbereich: 3,5-5,0 mmol/l'},{id:'labor-calcium',term:'Calcium',definition:'Mineralstoff, wichtig f\xfcr Knochen, Muskeln, Nervensystem. Referenzbereich: 2,2-2,6 mmol/l'},{id:'labor-phosphat',term:'Phosphat',definition:'Mineralstoff, wichtig f\xfcr Energiestoffwechsel und Knochen. Referenzbereich: 0,8-1,5 mmol/l'},{id:'labor-magnesium',term:'Magnesium',definition:'Mineralstoff, Cofaktor vieler Enzyme. Referenzbereich: 0,7-1,1 mmol/l'},{id:'labor-glukose',term:'Glukose (n\xfcchtern)',definition:'Blutzucker nach mindestens 8 Stunden Nahrungskarenz. Referenzbereich: 70-100 mg/dl'},{id:'labor-hba1c',term:'HbA1c',definition:'Glykiertes H\xe4moglobin, Langzeitwert des Blutzuckers (ca. 3 Monate). Referenzbereich: 4-6%'},{id:'labor-lipase',term:'Lipase',definition:'Enzym der Bauchspeicheldr\xfcse, erh\xf6ht bei akuter Pankreatitis. Referenzbereich: <60 U/l'},{id:'labor-amylase',term:'Amylase',definition:'Enzym in Pankreas und Speicheldr\xfcsen, erh\xf6ht bei Pankreatitis. Referenzbereich: 28-100 U/l'},{id:'labor-troponin',term:'Troponin T/I',definition:'Herzmuskelspezifisches Protein, wichtiger Marker bei Herzinfarkt. Referenzbereich: <14 ng/l'},{id:'labor-tsh',term:'TSH',definition:'Thyreoidea-stimulierendes Hormon, steuert Schilddr\xfcsenfunktion. Referenzbereich: 0,4-4,0 mU/l'},{id:'labor-ft3',term:'fT3',definition:'Freies Trijodthyronin, aktives Schilddr\xfcsenhormon. Referenzbereich: 3,1-6,8 pmol/l'},{id:'labor-ft4',term:'fT4',definition:'Freies Thyroxin, Schilddr\xfcsenhormon. Referenzbereich: 12-22 pmol/l'},{id:'labor-psa',term:'PSA',definition:'Prostataspezifisches Antigen, erh\xf6ht bei Prostataerkrankungen. Referenzbereich: <4 ng/ml'},{id:'labor-bilirubin',term:'Bilirubin (gesamt)',definition:'Abbauprodukt des H\xe4moglobins, erh\xf6ht bei Lebererkrankungen. Referenzbereich: <1,0 mg/dl'},{id:'labor-ldl',term:'LDL-Cholesterin',definition:'"Schlechtes" Cholesterin, Risikofaktor f\xfcr Arteriosklerose. Zielwert: <100 mg/dl (risikoadaptiert)'},{id:'labor-hdl',term:'HDL-Cholesterin',definition:'"Gutes" Cholesterin, sch\xfctzt vor Arteriosklerose. Referenzbereich: >40 mg/dl (M\xe4nner), >50 mg/dl (Frauen)'},{id:'labor-triglyceride',term:'Triglyceride',definition:'Blutneutrale Fette, erh\xf6ht bei Stoffwechselst\xf6rungen. Referenzbereich: <150 mg/dl'},{id:'labor-be',term:'BE (Base Excess)',definition:'Basen\xfcberschuss/-defizit im Blut, wichtig f\xfcr S\xe4ure-Basen-Haushalt. Referenzbereich: -2 bis +2 mmol/l'},{id:'labor-po2',term:'pO\u2082',definition:'Sauerstoffpartialdruck im Blut. Referenzbereich: 80-100 mmHg (arteriell)'},{id:'labor-pco2',term:'pCO\u2082',definition:'Kohlendioxidpartialdruck im Blut. Referenzbereich: 35-45 mmHg (arteriell)'},{id:'labor-hco3',term:'HCO\u2083\u207b',definition:'Bikarbonat im Blut, wichtiger Puffer. Referenzbereich: 22-26 mmol/l'},{id:'labor-procalcitonin',term:'Procalcitonin (PCT)',definition:'Marker f\xfcr bakterielle Infektionen und Sepsis. Referenzbereich: <0,5 ng/ml'},{id:'labor-bnp',term:'BNP/NT-proBNP',definition:'Natriuretisches Peptid, erh\xf6ht bei Herzinsuffizienz. Referenzbereich: BNP <100 pg/ml, NT-proBNP altersabh\xe4ngig'},{id:'labor-laktat',term:'Laktat',definition:'Stoffwechselprodukt der anaeroben Glykolyse, erh\xf6ht bei Sauerstoffmangel. Referenzbereich: 0,5-2,2 mmol/l'},{id:'labor-ferritin',term:'Ferritin',definition:'Eisenspeicherprotein, Marker f\xfcr Eisenstatus und Entz\xfcndungen. Referenzbereich: M\xe4nner 20-300 ng/ml, Frauen 15-150 ng/ml'},{id:'labor-d-dimere',term:'D-Dimere',definition:'Abbauprodukte des Fibrins, erh\xf6ht bei Thrombosen und Gerinnungsaktivierung. Referenzbereich: <0,5 mg/l'}]}),680,[]);
__d((function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.extendedLexikonEntries=void 0;e.extendedLexikonEntries=[{id:'abvd',term:'ABVD',definition:'Chemotherapie-Schema mit Adriamycin, Bleomycin, Vinblastin und Dacarbazin, vorwiegend bei Hodgkin-Lymphomen'},{id:'acb',term:'ACB',definition:'Aortokoronarer Bypass - operatives Verfahren zur \xdcberbr\xfcckung verengter Herzkranzgef\xe4\xdfe'},{id:'ace',term:'ACE',definition:'Angiotensin Converting Enzyme - Schl\xfcsselenzym im Renin-Angiotensin-Aldosteron-System'},{id:'adc',term:'ADC',definition:'Antibody-Drug Conjugate - zielgerichtete Krebstherapie mit Antik\xf6rpern, die Wirkstoffe direkt an Tumorzellen transportieren'},{id:'aed',term:'AED',definition:'Automatisierter Externer Defibrillator - Ger\xe4t zur Defibrillation bei Herzstillstand durch Laien'},{id:'afib',term:'AFib',definition:'Atrial Fibrillation - Vorhofflimmern, h\xe4ufige Herzrhythmusst\xf6rung'},{id:'ahc',term:'AHC',definition:'Ambulante Herzchirurgie - kurzstation\xe4re oder tagesklinische herzchirurgische Eingriffe'},{id:'ahi',term:'AHI',definition:'Apnoe-Hypopnoe-Index - Ma\xdf f\xfcr den Schweregrad einer Schlafapnoe'},{id:'ami',term:'AMI',definition:'Akuter Myokardinfarkt - pl\xf6tzliche Durchblutungsst\xf6rung des Herzmuskels'},{id:'ap',term:'AP',definition:'Angina Pectoris - anfallsartige Brustschmerzen durch Sauerstoffmangel im Herzmuskel'},{id:'asa',term:'ASA',definition:'American Society of Anesthesiologists - Klassifikation zur pr\xe4operativen Risikoeinsch\xe4tzung'},{id:'asd',term:'ASD',definition:'Autismus-Spektrum-St\xf6rung - neurobiologische Entwicklungsst\xf6rung'},{id:'ave',term:'AVE',definition:'Arterielle Verschlusskrankheit - Durchblutungsst\xf6rung der Extremit\xe4ten'},{id:'avk',term:'AVK',definition:'Arterielle Verschlusskrankheit - Verengung der Arterien, besonders in den Beinen'},{id:'bas',term:'BAS',definition:'Ballonatrioseptostomie - Herzkatheter-Eingriff zur Erweiterung eines zu kleinen Vorhofseptumdefekts'},{id:'bct',term:'BCT',definition:'Brusterhaltende Therapie - chirurgische Behandlung von Brustkrebs mit Erhalt der Brust'},{id:'bipap',term:'BiPAP',definition:'Biphasic Positive Airway Pressure - nicht-invasive Beatmung mit unterschiedlichen Dr\xfccken f\xfcr Ein- und Ausatmung'},{id:'bls',term:'BLS',definition:'Basic Life Support - Basisma\xdfnahmen der Wiederbelebung'},{id:'bpm',term:'bpm',definition:'Beats per minute - Herzschl\xe4ge pro Minute zur Messung der Herzfrequenz'},{id:'brca',term:'BRCA',definition:'Breast Cancer Gene - Gene, deren Mutation das Risiko f\xfcr Brust- und Eierstockkrebs erh\xf6ht'},{id:'bs',term:'BS',definition:'Blutdruck systolisch - oberer Blutdruckwert'},{id:'cag',term:'CAG',definition:'Koronarangiographie - Darstellung der Herzkranzgef\xe4\xdfe mittels Kontrastmittel'},{id:'cap',term:'CAP',definition:'Community Acquired Pneumonia - ambulant erworbene Lungenentz\xfcndung'},{id:'cbc',term:'CBC',definition:'Complete Blood Count - Blutbild mit Differentialblutbild'},{id:'cd',term:'CD',definition:'Cluster of Differentiation - Oberfl\xe4chenmarker zur Identifikation von Zellen, wichtig in der Immunologie'},{id:'cga',term:'CGA',definition:'Comprehensive Geriatric Assessment - umfassende geriatrische Beurteilung'},{id:'cgm',term:'CGM',definition:'Continuous Glucose Monitoring - kontinuierliche Glukosemessung bei Diabetes'},{id:'chop',term:'CHOP',definition:'Chemotherapie-Schema mit Cyclophosphamid, Doxorubicin, Vincristin und Prednison bei Non-Hodgkin-Lymphomen'},{id:'ckd',term:'CKD',definition:'Chronic Kidney Disease - chronische Nierenerkrankung'},{id:'cml',term:'CML',definition:'Chronische Myeloische Leuk\xe4mie - Krebserkrankung des Knochenmarks'},{id:'cmr',term:'CMR',definition:'Kardiale Magnetresonanztomographie - MRT-Untersuchung des Herzens'},{id:'cmv',term:'CMV',definition:'Cytomegalievirus - h\xe4ufiges Herpesvirus mit Bedeutung f\xfcr immungeschw\xe4chte Patienten'},{id:'cnap',term:'CNAP',definition:'Continuous Non-invasive Arterial Pressure - kontinuierliche nicht-invasive Blutdruckmessung'},{id:'cnt',term:'CNT',definition:'Kardiologische Notfalltherapie - Notfallversorgung bei akuten Herzkreislaufst\xf6rungen'},{id:'cpoe',term:'CPOE',definition:'Computerized Physician Order Entry - elektronische Arzneimittelverordnung'},{id:'crf',term:'CRF',definition:'Chronisches Nierenversagen (Chronic Renal Failure) - fortschreitender Verlust der Nierenfunktion'},{id:'crrt',term:'CRRT',definition:'Continuous Renal Replacement Therapy - kontinuierliches Nierenersatzverfahren bei akutem Nierenversagen'},{id:'crt',term:'CRT',definition:'Kardiale Resynchronisationstherapie - Schrittmachertherapie zur Behandlung der Herzinsuffizienz'},{id:'ctd',term:'CTD',definition:'Connective Tissue Disease - Bindegewebserkrankung'},{id:'cva',term:'CVA',definition:'Cerebrovascular Accident - Schlaganfall'},{id:'cvrd',term:'CVRD',definition:'Kardiovaskul\xe4re Risikodisposition - Neigung zu Herz-Kreislauferkrankungen'},{id:'dcm',term:'DCM',definition:'Dilatative Kardiomyopathie - Herzmuskelerkrankung mit Erweiterung der Herzkammern'},{id:'dd',term:'DD',definition:'Differentialdiagnose - Abgrenzung verschiedener in Frage kommender Erkrankungen'},{id:'dka',term:'DKA',definition:'Diabetische Ketoazidose - akute Stoffwechselentgleisung bei Diabetes mellitus Typ 1'},{id:'dkc',term:'DKC',definition:'Diabetisches Koma - schwere Bewusstseinsst\xf6rung bei entgleistem Diabetes'},{id:'dlb',term:'DLB',definition:'Demenz mit Lewy-K\xf6rperchen - neurodegenerative Erkrankung'},{id:'dpnp',term:'DPNP',definition:'Diabetische periphere Neuropathie - nervensch\xe4digende Komplikation bei Diabetes'},{id:'dsm',term:'DSM',definition:'Diagnostic and Statistical Manual of Mental Disorders - Klassifikationssystem f\xfcr psychische St\xf6rungen'},{id:'dvt',term:'DVT',definition:'Deep Vein Thrombosis - Tiefe Venenthrombose, Blutgerinnsel in tiefen Venen'},{id:'ebm',term:'EBM',definition:'Evidence-based Medicine - Evidenzbasierte Medizin, medizinische Behandlung auf Basis wissenschaftlicher Erkenntnisse'},{id:'ecf',term:'ECF',definition:'Extrazellul\xe4re Fl\xfcssigkeit - K\xf6rperfl\xfcssigkeit au\xdferhalb der Zellen'},{id:'ecls',term:'ECLS',definition:'Extracorporeal Life Support - apparative Unterst\xfctzung von Herz und/oder Lunge au\xdferhalb des K\xf6rpers'},{id:'ecmo',term:'ECMO',definition:'Extrakorporale Membranoxygenierung - Lungenunterst\xfctzungsverfahren bei schwerem Lungenversagen'},{id:'ecp',term:'ECP',definition:'Extrakorporale Photopherese - Blutreinigungsverfahren bei bestimmten Hauterkrankungen'},{id:'eeg',term:'EEG',definition:'Elektroenzephalogramm - Aufzeichnung der elektrischen Hirnaktivit\xe4t'},{id:'ems',term:'EMS',definition:'Emergency Medical Services - Rettungsdienst'},{id:'endr',term:'ENDR',definition:'Endokrine Regulationsst\xf6rung - St\xf6rung des Hormonsystems'},{id:'eol',term:'EOL',definition:'End of Life Care - Versorgung am Lebensende, Palliativversorgung'},{id:'epc',term:'EPC',definition:'Endotheliale Progenitorzellen - Vorl\xe4uferzellen zur Gef\xe4\xdfneubildung'},{id:'ercp',term:'ERCP',definition:'Endoskopisch retrograde Cholangiopankreatikographie - endoskopische Untersuchung der Gallenwege und Bauchspeicheldr\xfcse'},{id:'esbl',term:'ESBL',definition:'Extended-Spectrum Beta-Lactamase - multiresistente Keime mit speziellen Resistenzenzymen'},{id:'eskd',term:'ESKD',definition:'End-Stage Kidney Disease - terminales Nierenversagen'},{id:'esrd',term:'ESRD',definition:'End-Stage Renal Disease - Nierenerkrankung im Endstadium'},{id:'fev1',term:'FEV1',definition:'Forciertes exspiratorisches Volumen in 1 Sekunde - Lungenfunktionsparameter'},{id:'fno',term:'FNO',definition:'Fr\xfches Nierenorganversagen - beginnende Niereninsuffizienz'},{id:'fsga',term:'FSGA',definition:'Funktionelle speichergekoppelte Analyse - spezielle Diagnostik bei neurodegenerativen Erkrankungen'},{id:'fsme',term:'FSME',definition:'Fr\xfchsommer-Meningoenzephalitis - durch Zecken \xfcbertragene Virusinfektion des Gehirns'},{id:'fuo',term:'FUO',definition:'Fever of Unknown Origin - Fieber unklarer Genese'},{id:'gbs',term:'GBS',definition:'Guillain-Barr\xe9-Syndrom - akute entz\xfcndliche Erkrankung des peripheren Nervensystems'},{id:'gdm',term:'GDM',definition:'Gestationsdiabetes mellitus - Diabetes, der erstmals in der Schwangerschaft auftritt'},{id:'gerd',term:'GERD',definition:'Gastro\xf6sophageale Refluxkrankheit - chronischer R\xfcckfluss von Mageninhalt in die Speiser\xf6hre'},{id:'gfr',term:'GFR',definition:'Glomerul\xe4re Filtrationsrate - wichtiger Parameter der Nierenfunktion'},{id:'ghb',term:'GHB',definition:'Gesamthaushaltsbedarf - Gesamtbedarf an Pflegeleistungen eines Patienten'},{id:'hav',term:'HAV',definition:'Hepatitis-A-Virus - Erreger der Leberentz\xfcndung Typ A'},{id:'hbv',term:'HBV',definition:'Hepatitis-B-Virus - Erreger der Leberentz\xfcndung Typ B'},{id:'hcv',term:'HCV',definition:'Hepatitis-C-Virus - Erreger der Leberentz\xfcndung Typ C'},{id:'hdl',term:'HDL',definition:'High-Density-Lipoprotein - "gutes" Cholesterin im Blut'},{id:'hfo',term:'HFO',definition:'Hochfrequenzoszillation - spezielle Beatmungstechnik f\xfcr Neugeborene'},{id:'hfpef',term:'HFpEF',definition:'Heart Failure with preserved Ejection Fraction - Herzinsuffizienz mit erhaltener Pumpfunktion'},{id:'hfrex',term:'HFrEF',definition:'Heart Failure with reduced Ejection Fraction - Herzinsuffizienz mit reduzierter Pumpfunktion'},{id:'hht',term:'HHT',definition:'Heredit\xe4re h\xe4morrhagische Teleangiektasie - erbliche Gef\xe4\xdffehlbildung mit Blutungsneigung'},{id:'hie',term:'HIE',definition:'Hypoxisch-isch\xe4mische Enzephalopathie - Hirnsch\xe4digung durch Sauerstoffmangel'},{id:'hiv',term:'HIV',definition:'Humanes Immundefizienz-Virus - Erreger der Immunschw\xe4chekrankheit AIDS'},{id:'hla',term:'HLA',definition:'Humanes Leukozytenantigen - Gewebsmerkmale zur Transplantationsvertr\xe4glichkeit'},{id:'hlhs',term:'HLHS',definition:'Hypoplastisches Linksherzsyndrom - angeborener Herzfehler'},{id:'hmv',term:'HMV',definition:'H\xe4usliche Mechanische Ventilation - Beatmung zu Hause'},{id:'hpv',term:'HPV',definition:'Humanes Papillomavirus - Virusgruppe, die Warzen und Krebs verursachen kann'},{id:'hsct',term:'HSCT',definition:'H\xe4matopoetische Stammzelltransplantation - \xdcbertragung blutbildender Stammzellen'},{id:'iabp',term:'IABP',definition:'Intraaortale Ballonpumpe - Kreislaufunterst\xfctzung bei schwerem Herzversagen'},{id:'ibd',term:'IBD',definition:'Inflammatory Bowel Disease - chronisch-entz\xfcndliche Darmerkrankung'},{id:'icp',term:'ICP',definition:'Intrakranieller Druck - Druck innerhalb der Sch\xe4delh\xf6hle'},{id:'icu',term:'ICU',definition:'Intensive Care Unit - Intensivstation'},{id:'idc',term:'IDC',definition:'Invasive Duktales Karzinom - h\xe4ufigste Form von Brustkrebs'},{id:'idl',term:'IDL',definition:'Intermediate-Density-Lipoprotein - mittelgro\xdfe Lipoproteinpartikel im Blut'},{id:'ihr',term:'IHR',definition:'Intrahospitale Reanimation - Wiederbelebung im Krankenhaus'},{id:'ivf',term:'IVF',definition:'In-vitro-Fertilisation - k\xfcnstliche Befruchtung'},{id:'akromegalie',term:'Akromegalie',definition:'Erkrankung durch \xdcberproduktion von Wachstumshormon im Erwachsenenalter, f\xfchrt zu Vergr\xf6\xdferung von H\xe4nden, F\xfc\xdfen und Gesichtsz\xfcgen'},{id:'amyloidose',term:'Amyloidose',definition:'Gruppe von Erkrankungen, bei denen sich abnorme Proteine (Amyloid) in verschiedenen Organen ablagern'},{id:'ankylosierende-spondylitis',term:'Ankylosierende Spondylitis',definition:'Chronisch-entz\xfcndliche rheumatische Erkrankung, die haupts\xe4chlich die Wirbels\xe4ule betrifft, auch Morbus Bechterew genannt'},{id:'aortendissektion',term:'Aortendissektion',definition:'Lebensbedrohliches Ereignis, bei dem sich die Wandschichten der Hauptschlagader voneinander trennen'},{id:'aplastische-anaemie',term:'Aplastische An\xe4mie',definition:'Seltene, schwerwiegende Erkrankung, bei der das Knochenmark nicht gen\xfcgend neue Blutzellen produziert'},{id:'ards',term:'ARDS',definition:'Akutes Atemnotsyndrom, schwere Lungenfunktionsst\xf6rung mit eingeschr\xe4nktem Gasaustausch und Atemversagen'},{id:'arnold-chiari-malformation',term:'Arnold-Chiari-Malformation',definition:'Angeborene Fehlbildung des Gehirns, bei der Teile des Kleinhirns in den Spinalkanal hineinragen'},{id:'bakerzyste',term:'Bakerzyste',definition:'Fl\xfcssigkeitsgef\xfcllte Aussackung der Kniegelenkkapsel in die Kniekehle'},{id:'barretts-oesophagus',term:'Barrett-\xd6sophagus',definition:'Ver\xe4nderung der Schleimhautzellen in der Speiser\xf6hre, gilt als Pr\xe4kanzerose'},{id:'bechterew',term:'Morbus Bechterew',definition:'Chronisch-entz\xfcndliche rheumatische Erkrankung, die vorwiegend die Wirbels\xe4ule betrifft, auch ankylosierende Spondylitis genannt'},{id:'beinveneninsuffizienz',term:'Beinveneninsuffizienz',definition:'Funktionsschw\xe4che der Beinvenen, die zum Blutr\xfcckstau f\xfchrt, auch als chronisch ven\xf6se Insuffizienz bekannt'},{id:'bell-paralyse',term:'Bell-Paralyse',definition:'Akute Gesichtsl\xe4hmung durch Sch\xe4digung des Gesichtsnervs (Fazialisparese)'},{id:'berufsdermatose',term:'Berufsdermatose',definition:'Hauterkrankung, die durch berufliche T\xe4tigkeit verursacht wird'},{id:'bipolare-stoerung',term:'Bipolare St\xf6rung',definition:'Psychische Erkrankung mit episodisch auftretenden Stimmungsschwankungen zwischen Depression und Manie'},{id:'blasenmole',term:'Blasenmole',definition:'Gutartige Wucherung der Plazenta mit traubenf\xf6rmigen Bl\xe4schen, Form einer Schwangerschaftserkrankung'},{id:'blepharitis',term:'Blepharitis',definition:'Chronische Entz\xfcndung der Augenlider, oft mit R\xf6tung, Juckreiz und Krustenbildung'},{id:'bronchiektasie',term:'Bronchiektasie',definition:'Dauerhafte, krankhafte Erweiterung der Bronchien mit h\xe4ufigen Infektionen'},{id:'bronchiolitis',term:'Bronchiolitis',definition:'Entz\xfcndung der kleinen Atemwege (Bronchiolen), h\xe4ufig bei S\xe4uglingen und Kleinkindern'},{id:'brugada-syndrom',term:'Brugada-Syndrom',definition:'Seltene, erbliche Herzrhythmusst\xf6rung mit erh\xf6htem Risiko f\xfcr pl\xf6tzlichen Herztod'},{id:'bullimie',term:'Bulimie',definition:'Essst\xf6rung, gekennzeichnet durch Essanf\xe4lle mit anschlie\xdfendem selbstinduziertem Erbrechen'},{id:'candidiasis',term:'Candidiasis',definition:'Pilzinfektion, verursacht durch Hefepilze der Gattung Candida, kann verschiedene K\xf6rperregionen befallen'},{id:'chagas',term:'Chagas-Krankheit',definition:'Parasit\xe4re Infektionskrankheit, die durch Trypanosoma cruzi verursacht wird, \xfcbertragen durch Raubwanzen'},{id:'charcot-arthropathie',term:'Charcot-Arthropathie',definition:'Schmerzlose Gelenkzerst\xf6rung durch Nervensch\xe4den, h\xe4ufig bei Diabetikern an den F\xfc\xdfen'},{id:'charcot-marie-tooth',term:'Charcot-Marie-Tooth-Krankheit',definition:'Erbliche neurologische Erkrankung, die fortschreitende Muskelschw\xe4che verursacht'},{id:'cheilitis',term:'Cheilitis',definition:'Entz\xfcndung der Lippen, kann verschiedene Ursachen haben'},{id:'cheyne-stokes-atmung',term:'Cheyne-Stokes-Atmung',definition:'Periodisches Atemmuster mit wechselnden Phasen von tiefer und flacher Atmung bis zur Atempause'},{id:'chiari-malformation',term:'Chiari-Malformation',definition:'Strukturelle Anomalie des Gehirns, bei der Teile des Kleinhirns durch das Foramen magnum in den Spinalkanal ragen'},{id:'cholangitis',term:'Cholangitis',definition:'Entz\xfcndung der Galleng\xe4nge, h\xe4ufig durch Gallensteine oder Infektionen verursacht'},{id:'cholelithiasis',term:'Cholelithiasis',definition:'Gallensteinleiden, Bildung von festen Ablagerungen in der Gallenblase oder den Galleng\xe4ngen'},{id:'chorea-huntington',term:'Chorea Huntington',definition:'Erbliche Erkrankung des Gehirns mit fortschreitenden Bewegungsst\xf6rungen und Demenz'},{id:'chronische-fatigue-syndrom',term:'Chronisches Fatigue-Syndrom',definition:'Komplexe Erkrankung mit anhaltender, schwerer Ersch\xf6pfung und zahlreichen Begleitsymptomen'},{id:'chronisches-schmerzsyndrom',term:'Chronisches Schmerzsyndrom',definition:'Langanhaltende Schmerzzust\xe4nde, die \xfcber die normale Heilungszeit hinausgehen und oft schwer zu behandeln sind'},{id:'cluster-kopfschmerz',term:'Cluster-Kopfschmerz',definition:'Extrem schmerzhafte, einseitige Kopfschmerzattacken, die in Serien auftreten'},{id:'conn-syndrom',term:'Conn-Syndrom',definition:'\xdcberproduktion von Aldosteron durch die Nebenniere, f\xfchrt zu Bluthochdruck und Kaliumverlust'},{id:'cornea-ulcus',term:'Cornea-Ulcus',definition:'Geschw\xfcr der Hornhaut des Auges, oft durch Infektion oder Verletzung verursacht'},{id:'creutzfeldt-jakob',term:'Creutzfeldt-Jakob-Krankheit',definition:'Seltene, t\xf6dliche Prionenerkrankung des Gehirns mit rasch fortschreitender Demenz'},{id:'crohn',term:'Morbus Crohn',definition:'Chronisch-entz\xfcndliche Darmerkrankung, die den gesamten Verdauungstrakt betreffen kann'},{id:'cushing-syndrom',term:'Cushing-Syndrom',definition:'Hormonelle Erkrankung durch \xdcberproduktion von Kortisol mit typischen k\xf6rperlichen Ver\xe4nderungen'},{id:'cyclothymia',term:'Cyclothymia',definition:'Milde Form der bipolaren St\xf6rung mit zahlreichen Perioden depressiver und hypomanischer Symptome'},{id:'dekubitus',term:'Dekubitus',definition:'Druckgeschw\xfcr durch l\xe4ngere lokale Druckeinwirkung auf die Haut, typischerweise bei bettl\xe4gerigen Patienten'},{id:'dermatitis',term:'Dermatitis',definition:'Entz\xfcndliche Hauterkrankung mit R\xf6tung, Juckreiz und Hautausschlag'},{id:'dermatomyositis',term:'Dermatomyositis',definition:'Entz\xfcndliche Erkrankung von Haut und Muskeln autoimmunologischer Genese'},{id:'diabetes-insipidus',term:'Diabetes insipidus',definition:'Stoffwechselerkrankung mit erh\xf6hter Urinausscheidung durch Mangel am antidiuretischen Hormon'},{id:'diastolische-insuffizienz',term:'Diastolische Herzinsuffizienz',definition:'Form der Herzschw\xe4che, bei der die F\xfcllung der Herzkammern in der Entspannungsphase gest\xf6rt ist'},{id:'dickdarmkrebs',term:'Dickdarmkrebs',definition:'B\xf6sartige Tumorerkrankung des Dickdarms, h\xe4ufig durch Polypen entstehend'},{id:'divertikulose',term:'Divertikulose',definition:'Aussackungen der Darmwand, meist im Dickdarm, die sich bei Entz\xfcndung zu einer Divertikulitis entwickeln k\xf6nnen'},{id:'down-syndrom',term:'Down-Syndrom',definition:'Genetische St\xf6rung durch dreifaches Vorhandensein des Chromosoms 21, f\xfchrt zu typischen k\xf6rperlichen Merkmalen und geistiger Behinderung'},{id:'duchenne-muskeldystrophie',term:'Duchenne-Muskeldystrophie',definition:'Erbkrankheit mit fortschreitendem Muskelschwund, betrifft haupts\xe4chlich Jungen'},{id:'dupuytren-kontraktur',term:'Dupuytren-Kontraktur',definition:'Bindegewebserkrankung der Handinnenfl\xe4che, f\xfchrt zu Beugekontrakturen der Finger'},{id:'dystonie',term:'Dystonie',definition:'Neurologische Bewegungsst\xf6rung mit unwillk\xfcrlichen Muskelkontraktionen, die zu abnormalen K\xf6rperhaltungen f\xfchren'},{id:'echinococcose',term:'Echinokokkose',definition:'Parasit\xe4re Erkrankung durch Hundebandwurmlarven, bef\xe4llt Leber und andere Organe'},{id:'eklampsie',term:'Eklampsie',definition:'Schwere Komplikation in der Schwangerschaft mit Kr\xe4mpfen und Bewusstlosigkeit, folgt auf Pr\xe4eklampsie'},{id:'ekzem',term:'Ekzem',definition:'Entz\xfcndliche Hauterkrankung mit R\xf6tung, Juckreiz, Bl\xe4schen und Schuppung'},{id:'elephantiasis',term:'Elephantiasis',definition:'Massive Schwellung von Geweben, meist der Beine oder Genitalien, durch Lymphabflussst\xf6rung'},{id:'emphysem',term:'Emphysem',definition:'Lungenerkrankung mit \xdcberbl\xe4hung der Alveolen und verminderter Lungenelastizit\xe4t'},{id:'endokarditis',term:'Endokarditis',definition:'Entz\xfcndung der Herzinnenhaut, meist infekti\xf6s bedingt, kann zu Herzklappensch\xe4den f\xfchren'},{id:'endometriose',term:'Endometriose',definition:'Vorkommen von Geb\xe4rmutterschleimhaut au\xdferhalb der Geb\xe4rmutter, oft mit starken Schmerzen verbunden'},{id:'enterokolitis',term:'Enterokolitis',definition:'Entz\xfcndung von D\xfcnn- und Dickdarm, oft infekti\xf6s bedingt'},{id:'epilepsie',term:'Epilepsie',definition:'Neurologische Erkrankung mit wiederkehrenden Anf\xe4llen durch abnorme elektrische Aktivit\xe4t im Gehirn'},{id:'erysipel',term:'Erysipel',definition:'Akute bakterielle Infektion der Haut und Lymphgef\xe4\xdfe, auch Wundrose genannt'},{id:'erythema-nodosum',term:'Erythema nodosum',definition:'Schmerzhafte, rote Knoten unter der Haut, meist an den Schienbeinen, Reaktion auf verschiedene Erkrankungen'},{id:'essst\xf6rung',term:'Essst\xf6rung',definition:'Psychische St\xf6rung mit gest\xf6rtem Essverhalten, umfasst Anorexie, Bulimie und Binge-Eating-St\xf6rung'},{id:'exostose',term:'Exostose',definition:'Gutartige Knochenwucherung, die von der Oberfl\xe4che eines Knochens ausgeht'},{id:'facialisparese',term:'Facialisparese',definition:'L\xe4hmung des Gesichtsnervs, f\xfchrt zu einseitiger Gesichtsl\xe4hmung'},{id:'fallot-tetralogie',term:'Fallot-Tetralogie',definition:'Komplexer angeborener Herzfehler mit vier charakteristischen Komponenten'},{id:'fibrodysplasia',term:'Fibrodysplasia ossificans progressiva',definition:'Extrem seltene Erkrankung, bei der sich Muskel- und Bindegewebe in Knochen umwandelt'},{id:'filariose',term:'Filariose',definition:'Tropische Parasitose durch Fadenw\xfcrmer, f\xfchrt zu Lymphabflussst\xf6rungen und Elephantiasis'},{id:'follikulitis',term:'Follikulitis',definition:'Entz\xfcndung der Haarfollikel, meist bakteriell verursacht'},{id:'fragiles-x-syndrom',term:'Fragiles-X-Syndrom',definition:'Erbkrankheit mit geistiger Behinderung, Verhaltensauff\xe4lligkeiten und charakteristischen k\xf6rperlichen Merkmalen'},{id:'friedreich-ataxie',term:'Friedreich-Ataxie',definition:'Erbliche neurodegenerative Erkrankung mit fortschreitenden Koordinationsproblemen und Herzbeteiligung'},{id:'froehliche-adipositas',term:'Fr\xf6hliche Adipositas',definition:'Umgangssprachlicher Begriff f\xfcr Adipositas mit Antriebssteigerung durch Hirnsch\xe4digung (Hypothalamus)'},{id:'fussexostose',term:'Fu\xdfexostose',definition:'Kn\xf6cherne Ausw\xfcchse am Fu\xdf, die Schmerzen beim Laufen verursachen k\xf6nnen'},{id:'galaktos\xe4mie',term:'Galaktos\xe4mie',definition:'Erbliche Stoffwechselst\xf6rung, bei der Galaktose nicht abgebaut werden kann'},{id:'gallensteine',term:'Gallensteine',definition:'Feste Ablagerungen in der Gallenblase, haupts\xe4chlich aus Cholesterin oder Bilirubin'},{id:'gamstodtvergiftung',term:'Gasbrand',definition:'Schwere, lebensbedrohliche Infektion durch Clostridien mit Gasbildung im Gewebe'},{id:'gaumenspalte',term:'Gaumenspalte',definition:'Angeborene Fehlbildung, bei der der Gaumen nicht vollst\xe4ndig geschlossen ist'},{id:'gelenkluxation',term:'Gelenkluxation',definition:'Ausrenkung eines Gelenks, bei der die Gelenkfl\xe4chen vollst\xe4ndig den Kontakt verlieren'},{id:'gerstenkorn',term:'Gerstenkorn',definition:'Akute eitrige Entz\xfcndung einer Talgdr\xfcse am Augenlidrand'},{id:'geruchsverlust',term:'Geruchsverlust',definition:'Teilweiser oder vollst\xe4ndiger Verlust des Geruchssinns, kann verschiedene Ursachen haben'},{id:'gesichtsrose',term:'Gesichtsrose',definition:'Erysipel im Gesichtsbereich, bakterielle Hautinfektion mit starker R\xf6tung und Schwellung'},{id:'giardiasis',term:'Giardiasis',definition:'Durch Parasiten (Giardia lamblia) verursachte Durchfallerkrankung'},{id:'gilbert-syndrom',term:'Gilbert-Syndrom',definition:'Gutartige Stoffwechselanomalie mit erh\xf6htem Bilirubinspiegel im Blut, f\xfchrt zu milder Gelbsucht'},{id:'gingivitis',term:'Gingivitis',definition:'Zahnfleischentz\xfcndung, meist durch bakterielle Plaque verursacht'},{id:'glaukom',term:'Glaukom',definition:'Gr\xfcner Star, Augenerkrankung mit erh\xf6htem Augeninnendruck und Sch\xe4digung des Sehnervs'},{id:'glioblastom',term:'Glioblastom',definition:'Aggressiver, b\xf6sartiger Hirntumor, der aus Gliazellen entsteht'},{id:'glomerulonephritis',term:'Glomerulonephritis',definition:'Entz\xfcndliche Erkrankung der Nierenk\xf6rperchen, kann zu Nierenversagen f\xfchren'},{id:'glossitis',term:'Glossitis',definition:'Entz\xfcndung der Zunge mit R\xf6tung, Schwellung und Schmerzen'},{id:'glutenunvertr\xe4glichkeit',term:'Glutenunvertr\xe4glichkeit',definition:'Z\xf6liakie, Autoimmunerkrankung mit Unvertr\xe4glichkeit gegen\xfcber dem Getreideeiwei\xdf Gluten'},{id:'gonarthrose',term:'Gonarthrose',definition:'Degenerative Erkrankung des Kniegelenks mit Knorpelabnutzung'},{id:'granulom',term:'Granulom',definition:'Kn\xf6tchenf\xf6rmige Entz\xfcndungsreaktion des K\xf6rpers auf verschiedene Reize'},{id:'grippe',term:'Grippe',definition:'Influenza, hochansteckende Virusinfektion der Atemwege mit pl\xf6tzlichem Krankheitsbeginn und hohem Fieber'},{id:'haemochromatose',term:'H\xe4mochromatose',definition:'Erbliche Stoffwechselerkrankung mit \xfcberm\xe4\xdfiger Eisenaufnahme und -ablagerung in Organen'},{id:'haemophilie',term:'H\xe4mophilie',definition:'Erbliche Blutgerinnungsst\xf6rung mit verst\xe4rkter Blutungsneigung, auch Bluterkrankheit genannt'},{id:'hals-nasen-ohren-entzuendung',term:'HNO-Entz\xfcndung',definition:'Umgangssprachlicher Begriff f\xfcr Entz\xfcndungen im Hals-, Nasen- und Ohrenbereich'},{id:'hallux-rigidus',term:'Hallux rigidus',definition:'Arthrose des Gro\xdfzehengrundgelenks mit eingeschr\xe4nkter Beweglichkeit'},{id:'hallux-valgus',term:'Hallux valgus',definition:'Fehlstellung der Gro\xdfzehe mit Abweichung nach au\xdfen und Bildung einer schmerzhaften Beule'},{id:'hammertoehe',term:'Hammertoe',definition:'Deformit\xe4t der Zehen, bei der das mittlere Zehengelenk nach oben gebogen ist'},{id:'hashimoto',term:'Hashimoto-Thyreoiditis',definition:'Autoimmunerkrankung der Schilddr\xfcse, f\xfchrt meist zu einer Schilddr\xfcsenunterfunktion'},{id:'heuschnupfen',term:'Heuschnupfen',definition:'Saisonale allergische Rhinitis, ausgel\xf6st durch Pollen, mit Niesreiz, laufender Nase und Augenjucken'},{id:'hexenschuss',term:'Hexenschuss',definition:'Umgangssprachlich f\xfcr akute Lumbalgie, pl\xf6tzlicher Schmerz im unteren R\xfccken'},{id:'hidradenitis',term:'Hidradenitis suppurativa',definition:'Chronisch-entz\xfcndliche Hauterkrankung mit schmerzhaften Knoten in Achseln, Leisten und unter der Brust'},{id:'hirnabszess',term:'Hirnabszess',definition:'Eiteransammlung im Gehirn, meist durch bakterielle Infektion verursacht'},{id:'hirntumor',term:'Hirntumor',definition:'Gutartige oder b\xf6sartige Neubildung im Gehirn, kann Hirnfunktionen beeintr\xe4chtigen'},{id:'histiozytose',term:'Histiozytose',definition:'Gruppe seltener Erkrankungen mit abnormaler Vermehrung von Histiozyten in verschiedenen Geweben'},{id:'hodenkarzinom',term:'Hodenkarzinom',definition:'B\xf6sartiger Tumor des Hodens, h\xe4ufigste Krebserkrankung bei jungen M\xe4nnern'},{id:'hyperemesis-gravidarum',term:'Hyperemesis gravidarum',definition:'Schwere Form der Schwangerschafts\xfcbelkeit mit anhaltendem Erbrechen und Gewichtsverlust'},{id:'osteoporose',term:'Osteoporose',definition:'Erkrankung des Skelettsystems mit verminderter Knochendichte und erh\xf6htem Frakturrisiko'},{id:'paget-krankheit',term:'Paget-Krankheit',definition:'Chronische Knochenerkrankung mit gesteigertem Knochenumbau und Deformit\xe4ten'},{id:'pavk',term:'pAVK',definition:'Periphere arterielle Verschlusskrankheit - chronische Durchblutungsst\xf6rung der Extremit\xe4ten durch Verengung oder Verschluss der Arterien, klassifiziert nach Fontaine-Stadien'},{id:'pco-syndrom',term:'PCO-Syndrom',definition:'Polyzystisches Ovarialsyndrom - hormonelle St\xf6rung bei Frauen mit Zyklusst\xf6rungen und Stoffwechselver\xe4nderungen'},{id:'abatacept',term:'Abatacept',definition:'Immunsuppressivum zur Behandlung der rheumatoiden Arthritis, hemmt die T-Zell-Aktivierung'},{id:'acebutolol',term:'Acebutolol',definition:'Selektiver Beta-1-Blocker zur Behandlung von Bluthochdruck und bestimmten Herzrhythmusst\xf6rungen'},{id:'acemetacin',term:'Acemetacin',definition:'Nicht-steroidales Antirheumatikum (NSAR) zur Schmerzlinderung und Entz\xfcndungshemmung'},{id:'aciclovir',term:'Aciclovir',definition:'Antivirales Medikament zur Behandlung von Herpes-Infektionen'},{id:'adalimumab',term:'Adalimumab',definition:'TNF-alpha-Blocker zur Behandlung von chronischen Entz\xfcndungskrankheiten wie rheumatoider Arthritis, Morbus Crohn und Psoriasis'},{id:'adapalen',term:'Adapalen',definition:'Retinoid zur topischen Behandlung von Akne'},{id:'addolorin',term:'Addolorin',definition:'Umgangssprachliche Bezeichnung f\xfcr verschiedene schmerzlindernde Pr\xe4parate'},{id:'adrenalin',term:'Adrenalin',definition:'Hormon und Notfallmedikament bei allergischen Reaktionen, Herzstillstand und Schock'},{id:'albendazol',term:'Albendazol',definition:'Breitband-Anthelminthikum zur Behandlung von Wurmerkrankungen'},{id:'albuterol',term:'Albuterol (Salbutamol)',definition:'Kurzwirksamer Beta-2-Agonist zur Behandlung von Asthma und COPD'},{id:'alendronat',term:'Alendronat',definition:'Bisphosphonat zur Behandlung und Vorbeugung von Osteoporose'},{id:'alfentanil',term:'Alfentanil',definition:'Kurzwirksames Opioid-Analgetikum, haupts\xe4chlich in der An\xe4sthesie verwendet'},{id:'alfuzosin',term:'Alfuzosin',definition:'Alpha-1-Blocker zur Behandlung von Symptomen der benignen Prostatahyperplasie'},{id:'alimemazin',term:'Alimemazin',definition:'Antihistaminikum mit sedierenden Eigenschaften, eingesetzt bei Juckreiz und Schlafst\xf6rungen'},{id:'aliskiren',term:'Aliskiren',definition:'Direkter Renin-Inhibitor zur Behandlung von Bluthochdruck'},{id:'allopurinol',term:'Allopurinol',definition:'Xanthinoxidase-Hemmer zur Vorbeugung von Gichtanf\xe4llen und Behandlung erh\xf6hter Harns\xe4urewerte'},{id:'almotriptan',term:'Almotriptan',definition:'Selektiver Serotonin-5-HT1B/1D-Rezeptor-Agonist zur Behandlung von Migr\xe4ne'},{id:'alprazolam',term:'Alprazolam',definition:'Benzodiazepin mit anxiolytischer Wirkung zur Kurzzeitbehandlung von Angst- und Panikst\xf6rungen'},{id:'alprostadil',term:'Alprostadil',definition:'Prostaglandin E1, eingesetzt bei erektiler Dysfunktion und zur Offenhaltung des Ductus arteriosus bei Neugeborenen'},{id:'alteplase',term:'Alteplase',definition:'Thrombolytikum (Gewebeplasminogenaktivator) zur Aufl\xf6sung von Blutgerinnseln bei Herzinfarkt, Lungenembolie und Schlaganfall'},{id:'amantadin',term:'Amantadin',definition:'Medikament mit antiviraler und dopaminerger Wirkung, eingesetzt bei Parkinson-Krankheit und viraler Grippe'},{id:'ambrisentan',term:'Ambrisentan',definition:'Endothelin-Rezeptor-Antagonist zur Behandlung der pulmonalen arteriellen Hypertonie'},{id:'ambroxol',term:'Ambroxol',definition:'Sekretolytikum zur Behandlung von Erkrankungen der Atemwege mit z\xe4hem Schleim'},{id:'amfebutamon',term:'Amfebutamon (Bupropion)',definition:'Antidepressivum und Mittel zur Raucherentw\xf6hnung'},{id:'amidotrizoesaeure',term:'Amidotrizoes\xe4ure',definition:'Jodhaltiges R\xf6ntgenkontrastmittel f\xfcr verschiedene diagnostische Untersuchungen'},{id:'amikacin',term:'Amikacin',definition:'Aminoglykosid-Antibiotikum zur Behandlung schwerer bakterieller Infektionen'},{id:'amilorid',term:'Amilorid',definition:'Kaliumsparendes Diuretikum zur Behandlung von Bluthochdruck und Herzinsuffizienz'},{id:'aminoglutethimid',term:'Aminoglutethimid',definition:'Aromatase-Hemmer zur Behandlung von hormonabh\xe4ngigem Brustkrebs'},{id:'aminophyllin',term:'Aminophyllin',definition:'Bronchodilatator zur Behandlung von Asthma und COPD'},{id:'amiodarone',term:'Amiodaron',definition:'Antiarrhythmikum zur Behandlung und Vorbeugung von Herzrhythmusst\xf6rungen'},{id:'amitriptylin',term:'Amitriptylin',definition:'Trizyklisches Antidepressivum, auch eingesetzt bei neuropathischen Schmerzen und Migr\xe4neprophylaxe'},{id:'amlodipin',term:'Amlodipin',definition:'Kalziumkanalblocker zur Behandlung von Bluthochdruck und koronarer Herzkrankheit'},{id:'amoxicillin',term:'Amoxicillin',definition:'Penicillin-Antibiotikum mit breitem Wirkspektrum zur Behandlung bakterieller Infektionen'},{id:'amphotericin-b',term:'Amphotericin B',definition:'Antimykotikum zur Behandlung schwerer systemischer Pilzinfektionen'},{id:'ampicillin',term:'Ampicillin',definition:'Breitspektrum-Penicillin-Antibiotikum zur Behandlung bakterieller Infektionen'},{id:'anastrozol',term:'Anastrozol',definition:'Aromatase-Hemmer zur Behandlung von Brustkrebs bei postmenopausalen Frauen'},{id:'angiotensin-ii-rezeptorblocker',term:'Angiotensin-II-Rezeptorblocker (ARB)',definition:'Klasse von Medikamenten zur Behandlung von Bluthochdruck und Herzinsuffizienz, auch Sartane genannt'},{id:'apixaban',term:'Apixaban',definition:'Direkter Faktor-Xa-Hemmer zur Pr\xe4vention und Behandlung von Thrombosen und Embolien'},{id:'apomorphin',term:'Apomorphin',definition:'Dopamin-Agonist zur Behandlung fortgeschrittener Parkinson-Krankheit'},{id:'aprepitant',term:'Aprepitant',definition:'Neurokinin-1-Rezeptor-Antagonist zur Vorbeugung von \xdcbelkeit und Erbrechen bei Chemotherapie'},{id:'aripiprazol',term:'Aripiprazol',definition:'Atypisches Antipsychotikum zur Behandlung von Schizophrenie und bipolarer St\xf6rung'},{id:'arsentrioxid',term:'Arsentrioxid',definition:'Zytostatikum zur Behandlung bestimmter Formen der akuten Promyelozytenleuk\xe4mie'},{id:'artemether',term:'Artemether',definition:'Antimalariamittel, oft in Kombination mit Lumefantrin zur Behandlung unkomplizierter Malaria'},{id:'ascorbinsaeure',term:'Ascorbins\xe4ure (Vitamin C)',definition:'Wasserl\xf6sliches Vitamin, verwendet als Nahrungserg\xe4nzungsmittel und zur Behandlung von Skorbut'},{id:'asparaginase',term:'Asparaginase',definition:'Enzym zur Behandlung der akuten lymphatischen Leuk\xe4mie'},{id:'aspirin',term:'Aspirin (Acetylsalicyls\xe4ure)',definition:'Schmerzmittel, Fiebermittel und Thrombozytenaggregationshemmer mit entz\xfcndungshemmender Wirkung'},{id:'atenolol',term:'Atenolol',definition:'Selektiver Beta-1-Blocker zur Behandlung von Bluthochdruck, Angina pectoris und bestimmten Herzrhythmusst\xf6rungen'},{id:'atomoxetin',term:'Atomoxetin',definition:'Noradrenalin-Wiederaufnahmehemmer zur Behandlung der Aufmerksamkeitsdefizit-Hyperaktivit\xe4tsst\xf6rung (ADHS)'},{id:'atorvastatin',term:'Atorvastatin',definition:'HMG-CoA-Reduktase-Hemmer (Statin) zur Senkung erh\xf6hter Cholesterinwerte'},{id:'atosiban',term:'Atosiban',definition:'Oxytocin-Rezeptor-Antagonist zur Hemmung vorzeitiger Wehen'},{id:'atovaquon',term:'Atovaquon',definition:'Antiprotozoisches Medikament, h\xe4ufig in Kombination mit Proguanil zur Malariaprophylaxe und -behandlung'},{id:'atracurium',term:'Atracurium',definition:'Nicht-depolarisierendes Muskelrelaxans f\xfcr operative Eingriffe und Intensivmedizin'},{id:'atropin',term:'Atropin',definition:'Anticholinergikum mit vielf\xe4ltigen Anwendungen, u.a. in der Augenheilkunde und bei Bradykardie'},{id:'avapritinib',term:'Avapritinib',definition:'Tyrosinkinase-Inhibitor zur Behandlung bestimmter gastrointestinaler Stromatumoren'},{id:'azathioprin',term:'Azathioprin',definition:'Immunsuppressivum zur Verhinderung von Organabsto\xdfungen nach Transplantation und bei Autoimmunerkrankungen'},{id:'azelastin',term:'Azelastin',definition:'Antihistaminikum zur Behandlung allergischer Symptome wie Heuschnupfen'},{id:'azithromycin',term:'Azithromycin',definition:'Makrolid-Antibiotikum zur Behandlung verschiedener bakterieller Infektionen'},{id:'bacitracin',term:'Bacitracin',definition:'Peptid-Antibiotikum zur \xe4u\xdferlichen Anwendung bei bakteriellen Hautinfektionen'},{id:'baclofen',term:'Baclofen',definition:'Muskelrelaxans zur Behandlung von Spastizit\xe4t, wirkt am GABA-B-Rezeptor'},{id:'balsalazid',term:'Balsalazid',definition:'Entz\xfcndungshemmendes Medikament zur Behandlung von Colitis ulcerosa'},{id:'barbiturat',term:'Barbiturate',definition:'Gruppe von Sedativa, Hypnotika und Antiepileptika, die heute aufgrund ihres Abh\xe4ngigkeitspotenzials nur noch selten eingesetzt werden'},{id:'basiliximab',term:'Basiliximab',definition:'Monoklonaler Antik\xf6rper zur Immunsuppression bei Nierentransplantationen'},{id:'becaplermin',term:'Becaplermin',definition:'Wachstumsfaktor zur Behandlung von diabetischen Fu\xdfulzera'},{id:'beclometason',term:'Beclometason',definition:'Inhalatives Kortikosteroid zur Behandlung von Asthma und allergischer Rhinitis'},{id:'bedaquilin',term:'Bedaquilin',definition:'Antituberkulotikum zur Behandlung multiresistenter Tuberkulose'},{id:'belimumab',term:'Belimumab',definition:'Monoklonaler Antik\xf6rper zur Behandlung des systemischen Lupus erythematodes'},{id:'bendamustin',term:'Bendamustin',definition:'Zytostatikum zur Behandlung von Leuk\xe4mien und Lymphomen'},{id:'benperidol',term:'Benperidol',definition:'Hochpotentes Antipsychotikum zur Behandlung schwerer psychotischer St\xf6rungen'},{id:'benzydamin',term:'Benzydamin',definition:'Lokales Analgetikum und Antiphlogistikum zur Behandlung von Entz\xfcndungen im Mund- und Rachenraum'},{id:'betahistin',term:'Betahistin',definition:'Medikament zur Behandlung von Morbus Meni\xe8re und Schwindel'},{id:'betamethason',term:'Betamethason',definition:'Kortisonpr\xe4parat mit starker entz\xfcndungshemmender Wirkung'},{id:'betaxolol',term:'Betaxolol',definition:'Selektiver Beta-1-Blocker, h\xe4ufig als Augentropfen zur Behandlung des Glaukoms eingesetzt'},{id:'bezafibrat',term:'Bezafibrat',definition:'Fibrat zur Behandlung von Fettstoffwechselst\xf6rungen'},{id:'bicalutamid',term:'Bicalutamid',definition:'Antiandrogen zur Behandlung des fortgeschrittenen Prostatakarzinoms'},{id:'bimatoprost',term:'Bimatoprost',definition:'Prostaglandin-Analogon zur Behandlung des Glaukoms und zur F\xf6rderung des Wimpernwachstums'},{id:'biperiden',term:'Biperiden',definition:'Anticholinergikum zur Behandlung der Parkinson-Krankheit und medikamentenbedingter extrapyramidaler Symptome'},{id:'bisocodyl',term:'Bisocodyl',definition:'Kontaktlaxativum zur kurzfristigen Behandlung von Verstopfung'},{id:'bisonlauftrunk',term:'Bisontrank',definition:'Umgangssprachlich f\xfcr bittere, unappetitliche Medikamente'},{id:'abhaengigkeitspflege',term:'Abh\xe4ngigkeitspflege',definition:'Pflegeform bei vollst\xe4ndiger Abh\xe4ngigkeit des Patienten von fremder Hilfe'},{id:'abwehrspannung',term:'Abwehrspannung',definition:'Unwillk\xfcrliche Anspannung der Bauchmuskulatur bei Ber\xfchrung, Zeichen einer Peritonitis'},{id:'adipositas-paradoxa',term:'Adipositas paradoxa',definition:'\xdcbergewicht, das nicht durch \xfcberm\xe4\xdfige Ern\xe4hrung, sondern durch Wassereinlagerungen (\xd6deme) entsteht'},{id:'adls',term:'ADLs (Activities of Daily Living)',definition:'Aktivit\xe4ten des t\xe4glichen Lebens, Ma\xdfstab f\xfcr die Selbstst\xe4ndigkeit eines Menschen'},{id:'aerosoltherpaie',term:'Aerosoltherapie',definition:'Behandlung mit zerst\xe4ubten Medikamenten zur Inhalation, besonders bei Atemwegserkrankungen'},{id:'atemdepression',term:'Atemdepression',definition:'Verminderung der Atemfrequenz und -tiefe, h\xe4ufig bei \xdcberdosierung von Opioiden oder Narkosemitteln'},{id:'auskultation',term:'Auskultation',definition:'Abh\xf6ren von K\xf6rperger\xe4uschen mit dem Stethoskop, wichtige Untersuchungsmethode'},{id:'barthel-index',term:'Barthel-Index',definition:'Standardisiertes Bewertungssystem zur Erfassung grundlegender Alltagsfunktionen und des Pflegebedarfs'},{id:'basale-stimulation',term:'Basale Stimulation',definition:'Pflegekonzept zur F\xf6rderung der Wahrnehmung durch grundlegende Reize bei Menschen mit schweren Beeintr\xe4chtigungen'},{id:'basisreflexe',term:'Basisreflexe',definition:'Grundlegende, angeborene Reflexe, deren Vorhandensein oder Fehlen neurologische Hinweise geben kann'},{id:'bezugspflege',term:'Bezugspflege',definition:'Pflegeorganisationsform, bei der eine Pflegekraft f\xfcr die gesamte Pflege bestimmter Patienten verantwortlich ist'},{id:'biochemischer-befund',term:'Biochemischer Befund',definition:'Laborergebnisse, die Aufschluss \xfcber chemische Vorg\xe4nge im K\xf6rper geben'},{id:'biographiearbeit',term:'Biographiearbeit',definition:'Methode in der Pflege, die die Lebensgeschichte des Patienten in die Pflege einbezieht, besonders wichtig in der Geriatrie'},{id:'blaehbauch',term:'Bl\xe4hbauch',definition:'Umgangssprachlich f\xfcr Meteorismus, Aufbl\xe4hung des Bauches durch Gasansammlung im Darm'},{id:'bobath-konzept',term:'Bobath-Konzept',definition:'Therapeutisches Konzept zur Rehabilitation neurologischer Patienten, f\xf6rdert normale Bewegungsmuster'},{id:'bradypnoe',term:'Bradypnoe',definition:'Verlangsamte Atmung mit weniger als 12 Atemz\xfcgen pro Minute'},{id:'braden-skala',term:'Braden-Skala',definition:'Assessment-Instrument zur Einsch\xe4tzung des Dekubitusrisikos'},{id:'case-management',term:'Case Management',definition:'Koordinierte Betreuung von Patienten \xfcber den gesamten Behandlungsverlauf hinweg'},{id:'cheyne-stokes-atmung',term:'Cheyne-Stokes-Atmung',definition:'Pathologisches Atemmuster mit periodisch zu- und abnehmender Atemtiefe bis zur Atempause'},{id:'compliance',term:'Compliance',definition:'Bereitschaft des Patienten, \xe4rztliche Anweisungen zu befolgen, heute oft durch den Begriff "Adh\xe4renz" ersetzt'},{id:'deeskalation',term:'Deeskalation',definition:'Ma\xdfnahmen zur Beruhigung einer angespannten Situation, besonders bei aggressiven oder erregten Patienten'},{id:'dehydration',term:'Dehydration',definition:'Fl\xfcssigkeitsmangel im K\xf6rper, kann zu schwerwiegenden Komplikationen f\xfchren'},{id:'dekubitus-grad',term:'Dekubitus-Grade',definition:'Klassifikationssystem f\xfcr Druckgeschw\xfcre von Grad 1 (R\xf6tung) bis Grad 4 (tiefe Gewebssch\xe4digung)'},{id:'dekubitus-prophylaxe',term:'Dekubitusprophylaxe',definition:'Ma\xdfnahmen zur Vorbeugung von Druckgeschw\xfcren, z.B. regelm\xe4\xdfige Positionswechsel, spezielle Matratzen'},{id:'delir',term:'Delir',definition:'Akuter Verwirrtheitszustand mit St\xf6rungen von Bewusstsein, Aufmerksamkeit und Kognition'},{id:'dermatologische-therapie',term:'Dermatologische Therapie',definition:'Behandlung von Hauterkrankungen, oft mit topischen (\xe4u\xdferlich anzuwendenden) Mitteln'},{id:'diabetes-management',term:'Diabetes-Management',definition:'Umfassendes Konzept zur Kontrolle des Blutzuckers und zur Vermeidung von Komplikationen bei Diabetes'},{id:'diagnostische-pflege',term:'Diagnostische Pflege',definition:'Pflegema\xdfnahmen zur Unterst\xfctzung diagnostischer Verfahren oder zur Beobachtung von Krankheitszeichen'},{id:'diaforese',term:'Diaforese',definition:'Starkes Schwitzen, oft im Rahmen von Fieber, Schock oder anderen Erkrankungen'},{id:'diaphoretikum',term:'Diaphoretikum',definition:'Schwei\xdftreibendes Mittel, in der Naturheilkunde zur Fiebersenkung eingesetzt'},{id:'differentialdiagnose',term:'Differentialdiagnose',definition:'Systematische Unterscheidung verschiedener m\xf6glicher Erkrankungen anhand von Symptomen und Befunden'},{id:'diffusionsst\xf6rung',term:'Diffusionsst\xf6rung',definition:'Beeintr\xe4chtigung des Gasaustauschs in der Lunge, f\xfchrt zu Sauerstoffmangel im Blut'},{id:'dissoziative-st\xf6rung',term:'Dissoziative St\xf6rung',definition:'Psychische St\xf6rung mit Unterbrechung der normalen Integration von Bewusstsein, Ged\xe4chtnis oder Identit\xe4t'},{id:'durchgangssyndrom',term:'Durchgangssyndrom',definition:'Vor\xfcbergehende Verwirrtheit, oft nach Operationen oder bei \xe4lteren Patienten'},{id:'dysfunktionale-atmung',term:'Dysfunktionale Atmung',definition:'Abweichung vom normalen Atemmuster, die zu k\xf6rperlichen Symptomen f\xfchren kann'},{id:'dysphagie-management',term:'Dysphagie-Management',definition:'Ma\xdfnahmen zur sicheren Ern\xe4hrung bei Schluckst\xf6rungen, einschlie\xdflich angepasster Nahrungskonsistenz'},{id:'dysphonie',term:'Dysphonie',definition:'Stimmst\xf6rung mit heiserer, rauer oder angestrengter Stimme'},{id:'edukation',term:'Edukation',definition:'Patientenschulung zur F\xf6rderung des Verst\xe4ndnisses der Erkrankung und der aktiven Beteiligung an der Behandlung'},{id:'eeg-monitoring',term:'EEG-Monitoring',definition:'Kontinuierliche \xdcberwachung der Hirnstr\xf6me, besonders auf der Intensivstation oder bei Epilepsie'},{id:'einlaufverfahren',term:'Einlaufverfahren',definition:'Einbringen von Fl\xfcssigkeit in den Darm \xfcber den After zur Stuhlentleerung oder Darmreinigung'},{id:'elektrolytgleichgewicht',term:'Elektrolytgleichgewicht',definition:'Balance wichtiger Mineralien wie Natrium, Kalium und Calcium im K\xf6rper'},{id:'eliminationsdi\xe4t',term:'Eliminationsdi\xe4t',definition:'Diagnostisches Verfahren zum Erkennen von Nahrungsmittelunvertr\xe4glichkeiten durch systematisches Weglassen bestimmter Lebensmittel'},{id:'emboliegefahr',term:'Emboliegefahr',definition:'Risiko f\xfcr die Verschleppung eines Blutgerinnsels im Blutkreislauf'},{id:'enterale-ern\xe4hrung',term:'Enterale Ern\xe4hrung',definition:'Ern\xe4hrung \xfcber den Magen-Darm-Trakt mittels Sonde oder Trinknahrung'},{id:'entlassmanagement',term:'Entlassmanagement',definition:'Strukturierte Planung und Durchf\xfchrung der Entlassung aus dem Krankenhaus mit Sicherstellung der Weiterversorgung'},{id:'entzugssyndrom',term:'Entzugssyndrom',definition:'K\xf6rperliche und psychische Symptome beim Absetzen einer Substanz, von der eine Abh\xe4ngigkeit besteht'},{id:'epiduralan\xe4sthesie',term:'Epiduralan\xe4sthesie',definition:'Regionale Bet\xe4ubung durch Einspritzen von Lokalan\xe4sthetikum in den Epiduralraum des R\xfcckenmarks'},{id:'epileptischer-anfall',term:'Epileptischer Anfall',definition:'Pl\xf6tzliche, abnorme elektrische Entladung im Gehirn mit verschiedenen m\xf6glichen Symptomen'},{id:'erbrechen',term:'Erbrechen',definition:'Forcierte Entleerung des Mageninhalts durch den Mund, h\xe4ufiges Symptom verschiedener Erkrankungen'},{id:'ergotherapie',term:'Ergotherapie',definition:'Therapieform zur F\xf6rderung der Selbstst\xe4ndigkeit im Alltag durch motorische und kognitive \xdcbungen'},{id:'ernaehrungsplan',term:'Ern\xe4hrungsplan',definition:'Individuell erstellter Plan zur Sicherstellung einer bedarfsgerechten Ern\xe4hrung'},{id:'erregungs\xfcbertragung',term:'Erregungs\xfcbertragung',definition:'Weitergabe von elektrischen Impulsen zwischen Nervenzellen oder im Herzgewebe'},{id:'erstickungsgefahr',term:'Erstickungsgefahr',definition:'Risiko einer Blockade der Atemwege mit Behinderung der Atmung, besonders bei Schluckst\xf6rungen oder Bewusstlosigkeit'},{id:'erstversorgung',term:'Erstversorgung',definition:'Unmittelbare medizinische Ma\xdfnahmen bei Unf\xe4llen oder akuten Erkrankungen'},{id:'erythema',term:'Erythem',definition:'R\xf6tung der Haut durch vermehrte Durchblutung, typisches Entz\xfcndungszeichen'},{id:'exazerbation',term:'Exazerbation',definition:'Akute Verschlechterung einer chronischen Erkrankung'},{id:'exsikkose',term:'Exsikkose',definition:'Austrocknung des K\xf6rpers durch Fl\xfcssigkeitsmangel, kann lebensbedrohlich sein'},{id:'extubation',term:'Extubation',definition:'Entfernung eines Beatmungsschlauchs (Tubus) aus den Atemwegen'},{id:'faecalimpakation',term:'F\xe4kalimpaktation',definition:'Verh\xe4rteter Stuhl, der den Darm blockiert und nicht auf normalem Weg ausgeschieden werden kann'},{id:'fallprophylaxe',term:'Fallprophylaxe',definition:'Ma\xdfnahmen zur Vermeidung von St\xfcrzen, besonders wichtig bei \xe4lteren oder geschw\xe4chten Patienten'},{id:'fastenprotokoll',term:'Fastenprotokoll',definition:'Strukturierte Anleitung zum therapeutischen Fasten mit \xdcberwachung der Vitalfunktionen'},{id:'fatigue',term:'Fatigue',definition:'Zustand chronischer Ersch\xf6pfung, der durch Ruhe nicht verbessert wird, h\xe4ufig bei Krebspatienten'},{id:'fetalposition',term:'Fetalposition',definition:'Zusammengekauerte K\xf6rperhaltung \xe4hnlich der eines F\xf6tus, oft bei starken Schmerzen oder psychischen Problemen'},{id:'fieber',term:'Fieber',definition:'Erh\xf6hte K\xf6rpertemperatur \xfcber 38\xb0C, meist als Reaktion auf Infektionen'},{id:'fixierung',term:'Fixierung',definition:'Freiheitsentziehende Ma\xdfnahme durch mechanische Einschr\xe4nkung der Bewegungsfreiheit, rechtlich streng reguliert'},{id:'flaschenern\xe4hrung',term:'Flaschenern\xe4hrung',definition:'Ern\xe4hrung von S\xe4uglingen mit der Flasche statt durch Stillen'},{id:'fl\xfcssigkeitsbilanz',term:'Fl\xfcssigkeitsbilanz',definition:'Dokumentation der zugef\xfchrten und ausgeschiedenen Fl\xfcssigkeitsmengen zur \xdcberwachung des Fl\xfcssigkeitshaushalts'},{id:'foetor-ex-ore',term:'Foetor ex ore',definition:'Unangenehmer Mundgeruch, kann auf verschiedene Erkrankungen hinweisen'},{id:'fokale-neurologie',term:'Fokale neurologische Defizite',definition:'Neurologische Ausf\xe4lle, die auf eine umschriebene Sch\xe4digung im Nervensystem hinweisen'},{id:'forensische-pflege',term:'Forensische Pflege',definition:'Pflege im Bereich der Rechtsmedizin oder von Patienten im Ma\xdfregelvollzug'},{id:'fremdanamnese',term:'Fremdanamnese',definition:'Erhebung der Krankengeschichte nicht vom Patienten selbst, sondern von Angeh\xf6rigen oder anderen Personen'},{id:'funktionsdiagnostik',term:'Funktionsdiagnostik',definition:'Untersuchung der Funktionsf\xe4higkeit von Organen und Organsystemen'},{id:'gaitbelt',term:'Gaitbelt (Gehgurt)',definition:'Hilfsmittel zur Unterst\xfctzung bei der Mobilisation und zum sicheren Transfer von Patienten'},{id:'geriatrisches-assessment',term:'Geriatrisches Assessment',definition:'Umfassende Beurteilung \xe4lterer Patienten hinsichtlich k\xf6rperlicher, psychischer und sozialer Faktoren'},{id:'gesundheitsf\xf6rderung',term:'Gesundheitsf\xf6rderung',definition:'Ma\xdfnahmen zur St\xe4rkung der Gesundheitsressourcen und -potenziale von Menschen'},{id:'grading',term:'Grading',definition:'Einstufung des Differenzierungsgrades von Tumorzellen als Ma\xdf f\xfcr die B\xf6sartigkeit'},{id:'haematurie',term:'H\xe4maturie',definition:'Blut im Urin, kann auf verschiedene Erkrankungen der Nieren oder Harnwege hinweisen'},{id:'acromion',term:'Acromion',definition:'Schulterh\xf6he, lateraler Fortsatz des Schulterblatts, der mit dem Schl\xfcsselbein verbunden ist'},{id:'adenohypophyse',term:'Adenohypophyse',definition:'Vorderlappen der Hirnanhangdr\xfcse, produziert wichtige Hormone wie ACTH, TSH, FSH, LH und Wachstumshormon'},{id:'alveolen',term:'Alveolen',definition:'Lungenbl\xe4schen, wichtigste Strukturen f\xfcr den Gasaustausch in der Lunge'},{id:'anulus-fibrosus',term:'Anulus fibrosus',definition:'Faserring der Bandscheibe, umgibt den Gallertkern (Nucleus pulposus)'},{id:'aorta-ascendens',term:'Aorta ascendens',definition:'Aufsteigender Teil der Hauptschlagader, beginnt am linken Ventrikel des Herzens'},{id:'aortenbogen',term:'Aortenbogen',definition:'Bogenf\xf6rmiger Teil der Hauptschlagader zwischen aufsteigender und absteigender Aorta'},{id:'arachnoidea',term:'Arachnoidea',definition:'Mittlere der drei Hirnh\xe4ute, spinnenwebartige Struktur zwischen Dura mater und Pia mater'},{id:'arcus-palatoglossus',term:'Arcus palatoglossus',definition:'Vorderer Gaumenbogen, verbindet den weichen Gaumen mit der Zunge'},{id:'arcus-palatopharyngeus',term:'Arcus palatopharyngeus',definition:'Hinterer Gaumenbogen, verbindet den weichen Gaumen mit dem Rachen'},{id:'area-postrema',term:'Area postrema',definition:'Hirnregion im Boden des vierten Ventrikels, fungiert als Brechzentrum'},{id:'arteria-basilaris',term:'Arteria basilaris',definition:'Hirnbasisschlagader, versorgt den Hirnstamm und Teile des Kleinhirns'},{id:'arteria-cerebri-media',term:'Arteria cerebri media',definition:'Mittlere Hirnarterie, versorgt gro\xdfe Teile der seitlichen Gro\xdfhirnrinde'},{id:'arteria-coronaria',term:'Arteria coronaria',definition:'Herzkranzgef\xe4\xdf, versorgt den Herzmuskel mit sauerstoffreichem Blut'},{id:'arteria-femoralis',term:'Arteria femoralis',definition:'Oberschenkelarterie, Hauptarterie des Oberschenkels'},{id:'arteria-gastrica',term:'Arteria gastrica',definition:'Magenarterie, versorgt den Magen mit arteriellem Blut'},{id:'arteria-hepatica',term:'Arteria hepatica',definition:'Leberarterie, liefert sauerstoffreiches Blut zur Leber'},{id:'arteria-pulmonalis',term:'Arteria pulmonalis',definition:'Lungenarterie, transportiert sauerstoffarmes Blut vom Herzen zur Lunge'},{id:'arteria-renalis',term:'Arteria renalis',definition:'Nierenarterie, versorgt die Nieren mit Blut'},{id:'arteria-vertebralis',term:'Arteria vertebralis',definition:'Wirbelarterie, verl\xe4uft durch die Querforts\xe4tze der Halswirbel und versorgt Teile des Gehirns'},{id:'articulatio-coxae',term:'Articulatio coxae',definition:'H\xfcftgelenk, Verbindung zwischen Becken und Oberschenkelknochen'},{id:'articulatio-genus',term:'Articulatio genus',definition:'Kniegelenk, komplexes Gelenk zwischen Oberschenkelknochen, Schienbein und Kniescheibe'},{id:'articulatio-humeri',term:'Articulatio humeri',definition:'Schultergelenk, Verbindung zwischen Schulterblatt und Oberarmknochen'},{id:'articulatio-sacroiliaca',term:'Articulatio sacroiliaca',definition:'Iliosakralgelenk, Verbindung zwischen Kreuzbein und Darmbein'},{id:'articulatio-talocruralis',term:'Articulatio talocruralis',definition:'Oberes Sprunggelenk, verbindet Unterschenkel mit Fu\xdf'},{id:'articulatio-talotarsalis',term:'Articulatio talotarsalis',definition:'Unteres Sprunggelenk, wichtig f\xfcr die Seitw\xe4rtsbewegung des Fu\xdfes'},{id:'atlas',term:'Atlas',definition:'Erster Halswirbel, tr\xe4gt den Sch\xe4del'},{id:'atrium-cordis',term:'Atrium cordis',definition:'Herzvorhof, obere Herzkammer'},{id:'auricula',term:'Auricula',definition:'Ohrmuschel, \xe4u\xdferer sichtbarer Teil des Ohrs'},{id:'axis',term:'Axis',definition:'Zweiter Halswirbel, erm\xf6glicht Drehbewegungen des Kopfes'},{id:'bauchspeicheldr\xfcse',term:'Bauchspeicheldr\xfcse',definition:'Pankreas, produziert Verdauungsenzyme und Hormone wie Insulin'},{id:'biceps-brachii',term:'Biceps brachii',definition:'Zweik\xf6pfiger Oberarmmuskel, beugt den Ellenbogen und dreht den Unterarm nach au\xdfen'},{id:'blasenhalsloge',term:'Blasenhalsloge',definition:'Region am Ausgang der Harnblase, wichtig bei Operationen der Prostata'},{id:'blut-hirn-schranke',term:'Blut-Hirn-Schranke',definition:'Physiologische Barriere zwischen Blutkreislauf und Zentralnervensystem'},{id:'brachialis',term:'Musculus brachialis',definition:'Oberarmmuskel, wichtigster Beuger des Ellenbogens'},{id:'broca-areal',term:'Broca-Areal',definition:'Sprachzentrum im Gehirn, zust\xe4ndig f\xfcr die Sprachproduktion'},{id:'bronchialsystem',term:'Bronchialsystem',definition:'Verzweigtes R\xf6hrensystem der Lunge, leitet die Atemluft'},{id:'bulbus-oculi',term:'Bulbus oculi',definition:'Augapfel, enth\xe4lt die lichtempfindlichen Rezeptoren'},{id:'calcaneus',term:'Calcaneus',definition:'Fersenbein, gr\xf6\xdfter Fu\xdfwurzelknochen'},{id:'canalis-inguinalis',term:'Canalis inguinalis',definition:'Leistenkanal, Durchtrittsstelle f\xfcr den Samenstrang beim Mann'},{id:'canalis-spinalis',term:'Canalis spinalis',definition:'Wirbelkanal, enth\xe4lt das R\xfcckenmark'},{id:'capillaren',term:'Kapillaren',definition:'Haargef\xe4\xdfe, kleinste Blutgef\xe4\xdfe, verbinden Arterien und Venen'},{id:'caput-femoris',term:'Caput femoris',definition:'Oberschenkelkopf, kugelf\xf6rmiger Teil des Oberschenkelknochens'},{id:'cardia',term:'Cardia',definition:'Mageneingang, \xdcbergang von der Speiser\xf6hre zum Magen'},{id:'carpus',term:'Carpus',definition:'Handwurzel, besteht aus acht kleinen Knochen'},{id:'cartilago-articularis',term:'Cartilago articularis',definition:'Gelenkknorpel, bedeckt die Gelenkfl\xe4chen und erm\xf6glicht reibungsarme Bewegungen'},{id:'cartilago-costalis',term:'Cartilago costalis',definition:'Rippenknorpel, verbindet die vorderen Rippenenden mit dem Brustbein'},{id:'cartilago-thyroidea',term:'Cartilago thyroidea',definition:'Schildknorpel, gr\xf6\xdfter Knorpel des Kehlkopfs'},{id:'cauda-equina',term:'Cauda equina',definition:'Pferdeschwanz, B\xfcndel von Spinalnerven am unteren Ende des R\xfcckenmarks'},{id:'cavitas-oris',term:'Cavitas oris',definition:'Mundh\xf6hle, erster Abschnitt des Verdauungstrakts'},{id:'cavum-tympani',term:'Cavum tympani',definition:'Paukenh\xf6hle, luftgef\xfcllter Raum im Mittelohr'},{id:'ampere',term:'Ampere (A)',definition:'SI-Basiseinheit der elektrischen Stromst\xe4rke, wichtig in der Elektrophysiologie und Reizstromtherapie'},{id:'apgar-score',term:'APGAR-Score',definition:'Bewertungssystem f\xfcr Neugeborene mit Skala von 0-10, basierend auf 5 Kriterien'},{id:'atemfrequenz',term:'Atemfrequenz (AF)',definition:'Anzahl der Atemz\xfcge pro Minute, Normalwert beim Erwachsenen: 12-20/min'},{id:'atemminutenvolumen',term:'Atemminutenvolumen (AMV)',definition:'Luftmenge, die pro Minute ein- und ausgeatmet wird, berechnet als Produkt aus Atemzugvolumen und Atemfrequenz'},{id:'atemzugvolumen',term:'Atemzugvolumen (AZV)',definition:'Luftmenge, die bei normaler Atmung ein- und ausgeatmet wird, ca. 500 ml beim Erwachsenen'},{id:'atmosph\xe4rendruck',term:'Atmosph\xe4rendruck (atm)',definition:'Einheit des Drucks, entspricht dem mittleren Luftdruck auf Meeresh\xf6he (1 atm = 1013,25 hPa)'},{id:'bar',term:'Bar (bar)',definition:'Druckeinheit, h\xe4ufig bei Blutdruckmessger\xe4ten und medizinischen Gasflaschen verwendet (1 bar = 100.000 Pa)'},{id:'becquerel',term:'Becquerel (Bq)',definition:'SI-Einheit der Radioaktivit\xe4t, entspricht einem Kernzerfall pro Sekunde'},{id:'blutdruck',term:'Blutdruck (RR)',definition:'Druck des Blutes in den Arterien, angegeben in mmHg, Normalwert ca. 120/80 mmHg'},{id:'body-mass-index',term:'Body-Mass-Index (BMI)',definition:'Verh\xe4ltnis von K\xf6rpergewicht in kg zum Quadrat der K\xf6rpergr\xf6\xdfe in m, zur Beurteilung des K\xf6rpergewichts'},{id:'candela',term:'Candela (cd)',definition:'SI-Basiseinheit der Lichtst\xe4rke, relevant f\xfcr opthalmologische Untersuchungen'},{id:'celsius',term:'Celsius (\xb0C)',definition:'Temperatureinheit, Normaltemperatur des Menschen 36,5-37,5\xb0C'},{id:'dalton',term:'Dalton (Da)',definition:'Atomare Masseneinheit, entspricht etwa der Masse eines Wasserstoffatoms, wichtig in der Biochemie'},{id:'decibel',term:'Dezibel (dB)',definition:'Einheit f\xfcr das Schalldruckverh\xe4ltnis, zur Messung der Lautst\xe4rke und bei H\xf6rtests'},{id:'dioptrie',term:'Dioptrie (dpt)',definition:'Ma\xdfeinheit f\xfcr die Brechkraft optischer Systeme, auch f\xfcr Sehhilfen'},{id:'dosis',term:'Dosis',definition:'Menge eines Arzneimittels oder einer Strahlung, die verabreicht wird'},{id:'dyne',term:'Dyn (dyn)',definition:'Einheit der Kraft im CGS-System, manchmal in der H\xe4modynamik verwendet'},{id:'einstein',term:'Einstein (E)',definition:'Einheit f\xfcr die Menge absorbierter Photonen in der Photochemie'},{id:'ejektionsfraktion',term:'Ejektionsfraktion (EF)',definition:'Anteil des Blutvolumens, der bei einer Herzkontraktion ausgeworfen wird, normal >55%'},{id:'elektrokardiogramm',term:'Elektrokardiogramm (EKG)',definition:'Aufzeichnung der elektrischen Aktivit\xe4t des Herzens, wichtiges diagnostisches Verfahren'},{id:'a1c',term:'A1C (HbA1c)',definition:'Glykiertes H\xe4moglobin, Langzeitwert f\xfcr Blutzucker, Referenzbereich: <5,7% (ohne Diabetes)'},{id:'acth',term:'ACTH',definition:'Adrenocorticotropes Hormon, steuert die Kortisolproduktion, Referenzbereich: 7-63 ng/l (morgens)'},{id:'adh',term:'ADH (Vasopressin)',definition:'Antidiuretisches Hormon, reguliert den Wasserhaushalt, Referenzbereich: 0,5-5,0 pg/ml'},{id:'agglutinierte-erythrozyten',term:'Agglutinierte Erythrozyten',definition:'Verklumpte rote Blutk\xf6rperchen, hinweisend auf Blutgruppeninkompatibilit\xe4t oder Autoimmunerkrankungen'},{id:'akanthocyten',term:'Akanthozyten',definition:'Stachelzellen, abnorm geformte Erythrozyten mit unregelm\xe4\xdfigen Forts\xe4tzen'},{id:'albumin',term:'Albumin',definition:'Wichtigstes Protein im Blutplasma, Referenzbereich: 35-52 g/l'},{id:'aldolase',term:'Aldolase',definition:'Enzym in Muskel- und Leberzellen, erh\xf6ht bei Muskelerkrankungen, Referenzbereich: <7,6 U/l'},{id:'aldosteron',term:'Aldosteron',definition:'Steroidhormon der Nebennierenrinde, reguliert den Salz- und Wasserhaushalt, Referenzbereich: 40-310 pg/ml (stehend)'},{id:'alkalische-phosphatase',term:'Alkalische Phosphatase (AP)',definition:'Enzym in verschiedenen Geweben, erh\xf6ht bei Leber- und Knochenerkrankungen, Referenzbereich: 40-129 U/l'},{id:'alpha-1-antitrypsin',term:'Alpha-1-Antitrypsin',definition:'Protein zum Schutz des Lungengewebes, Mangel f\xfchrt zu Lungenemphysem, Referenzbereich: 90-200 mg/dl'},{id:'alpha-amylase',term:'Alpha-Amylase',definition:'Verdauungsenzym, erh\xf6ht bei Pankreatitis, Referenzbereich: 28-100 U/l'},{id:'alpha-fetoprotein',term:'Alpha-Fetoprotein (AFP)',definition:'Tumormarker und Parameter in der Schwangerschaft, Referenzbereich: <7 ng/ml (Erwachsene)'},{id:'aminotransferasen',term:'Aminotransferasen (GOT, GPT)',definition:'Leberenzyme, erh\xf6ht bei Lebersch\xe4den, Referenzbereich: GOT <50 U/l, GPT <50 U/l (M\xe4nner)'},{id:'ammoniak',term:'Ammoniak',definition:'Abbauprodukt des Proteinstoffwechsels, erh\xf6ht bei schweren Lebererkrankungen, Referenzbereich: 15-45 \xb5g/dl'},{id:'amylase',term:'Amylase',definition:'Enzym zur St\xe4rkeverdauung, erh\xf6ht bei Pankreatitis, Referenzbereich: 28-100 U/l'},{id:'anion-gap',term:'Anion Gap',definition:'Differenz zwischen Kationen und Anionen im Blut, wichtig bei Beurteilung von S\xe4ure-Basen-St\xf6rungen, Referenzbereich: 8-16 mmol/l'},{id:'anti-cycline-citrulline-peptide',term:'Anti-CCP',definition:'Antik\xf6rper gegen zyklische citrullinierte Peptide, spezifisch f\xfcr rheumatoide Arthritis, Referenzbereich: <20 U/ml'},{id:'anti-dna',term:'Anti-DNA',definition:'Antik\xf6rper gegen DNA, charakteristisch f\xfcr systemischen Lupus erythematodes, Referenzbereich: negativ'},{id:'anti-mitochondriale-antikoerper',term:'Anti-mitochondriale Antik\xf6rper (AMA)',definition:'Autoantik\xf6rper bei prim\xe4r bili\xe4rer Cholangitis, Referenzbereich: negativ'},{id:'anti-neutrophile-cytoplasmische-antikoerper',term:'ANCA',definition:'Antineutrophile zytoplasmatische Antik\xf6rper, wichtig bei Vaskulitiden, Referenzbereich: negativ'}]}),681,[]);
