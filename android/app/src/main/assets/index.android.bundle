W)",definition:"Medikamentennebenwirkung"},{id:"mods",term:"MODS",definition:"Multiorgandysfunktionssyndrom"},{id:"mok",term:"MOK",definition:"maximale Organkonzentration"},{id:"m\xf6t",term:"M\xd6T)",definition:"Mitralklappen\xf6ffnungston"},{id:"mov",term:"MOV)",definition:"Multiorganversagen"},{id:"mpg",term:"MPG",definition:"Medizinproduktegesetz"},{id:"mps",term:"MPS",definition:"myeloproliferatives Syndrom"},{id:"mr",term:"MR)",definition:"Magnetresonanz"},{id:"mrcp",term:"MRCP",definition:"Magnetresonanz-"},{id:"mrr",term:"MRR)",definition:"Mund-Rachen-Raum"},{id:"mrt",term:"MRT)",definition:"Magnetresonanztomographie"},{id:"mrv",term:"MRV)",definition:"Ma\xdfregelvollzug"},{id:"ms",term:"MS)",definition:"Magensonde"},{id:"msa",term:"MSA",definition:"Multisystematrophien"},{id:"msh",term:"MSH",definition:"melanozytenstimulierendes"},{id:"msi",term:"MSI)",definition:"Mikrosatelliteninstabilit\xe4t"},{id:"mslt",term:"MSLT",definition:"multipler Schlaflatenztest"},{id:"msu",term:"MSU)",definition:"Mittelstrahlurin"},{id:"mta",term:"MTA)",definition:"Medizinisch technische"},{id:"mts",term:"MTS",definition:"medizinische"},{id:"mwt",term:"MWT",definition:"multipler Wachbleibetest"},{id:"mzl",term:"MZL)",definition:"Marginalzonen-Lymphom"},{id:"na",term:"NA)",definition:"Nabelarterie"},{id:"n\xe4",term:"N\xc4)",definition:"Not\xe4rztin"},{id:"nap",term:"NAP)",definition:"Nervenaustrittspunkt"},{id:"nas",term:"NAS",definition:"neuroallergisches Syndrom"},{id:"nash",term:"NASH",definition:"nicht-alkoholische"},{id:"naw",term:"NAW)",definition:"Notarztwagen"},{id:"nb",term:"NB)",definition:"Nachblutung"},{id:"nbz",term:"NBZ)",definition:"N\xfcchternblutzucker"},{id:"nch",term:"NCH)",definition:"Neurochirurgie"},{id:"nd",term:"ND)",definition:"Nebendiagnose"},{id:"nec",term:"NEC",definition:"nekrotisierende Enterokolitis"},{id:"ng",term:"NG",definition:"Neugeborenes"},{id:"nhl",term:"NHL)",definition:"Non-Hodgkin-Lymphom"},{id:"nid",term:"NID",definition:"normalgewichtiger"},{id:"nir",term:"NIR",definition:"nichtisch\xe4mische Region"},{id:"nk",term:"NK)",definition:"Nachkontrolle"},{id:"nkm",term:"NKM",definition:"nichtklassifizierbares Melanom"},{id:"nl",term:"NL)",definition:"Nierenlager"},{id:"nla",term:"NLA)",definition:"Neuroleptanalgesie"},{id:"nlg",term:"NLG)",definition:"Nervenleitgeschwindigkeit"},{id:"nlks",term:"NLKS)",definition:"Nierenlagerklopfschmerz"},{id:"nm",term:"NM",definition:"neuromuskul\xe4r"},{id:"nmm",term:"NMM",definition:"nodul\xe4res malignes Melanom"},{id:"nmt",term:"NMT",definition:"neuromuskul\xe4re Transmission"},{id:"nn",term:"NN)",definition:"Nebenniere"},{id:"nnh",term:"NNH",definition:"Nasennebenh\xf6hlen"},{id:"nnm",term:"NNM)",definition:"Nebennierenmark"},{id:"nnr",term:"NNR)",definition:"Nebennierenrinde"},{id:"nocm",term:"NOCM",definition:"nicht obstruktive"},{id:"nora",term:"NORA)",definition:"Noradrenalin"},{id:"npc",term:"NPC)",definition:"Nasopharynxkarzinom"},{id:"npl",term:"NPL)",definition:"Neoplasma"},{id:"nsa",term:"NSA)",definition:"Nasensalbe"},{id:"nsar",term:"NSAR",definition:"nichtsteroidales"},{id:"nse",term:"NSE",definition:"neurospezifische Enolase"},{id:"nsr",term:"NSR",definition:"normaler Sinusrhythmus"},{id:"nt",term:"NT",definition:"nasotracheal"},{id:"ntx",term:"NTX)",definition:"Nierentransplantation"},{id:"nu",term:"NU)",definition:"Nachuntersuchung"},{id:"nub",term:"NUB",definition:"Neue Untersuchungs- und"},{id:"nvk",term:"NVK)",definition:"Nabelvenenkatheter"},{id:"nvt",term:"NVT)",definition:"Nierenvenenthrombose"},{id:"nw",term:"NW)",definition:"Nachweis"},{id:"nx",term:"NX)",definition:"Nierenbiopsie"},{id:"nza",term:"NZA)",definition:"Nierenzelladenom"},{id:"nzc/",term:"NZC/",definition:"NZK"},{id:"oa",term:"OA)",definition:"Oberarm"},{id:"o\xe4",term:"O\xc4)",definition:"Ober\xe4rztin"},{id:"oae",term:"OAE",definition:"otoakustische Emissionen"},{id:"oak",term:"OAK",definition:"orale Antikoagulation"},{id:"oal",term:"OAL",definition:"oberfl\xe4chenaktives Lipoprotein"},{id:"oas",term:"OAS",definition:"oberfl\xe4chenaktive Spannung"},{id:"ocg",term:"OCG",definition:"orales Cholezystogramm"},{id:"odg",term:"ODG)",definition:"Ophtalmodynamographie"},{id:"oemg",term:"OEMG)",definition:"Okuloelektromyogramm"},{id:"oep",term:"OEP",definition:"olfaktorisch evoziertes Potenzial"},{id:"ofd",term:"OFD",definition:"orofazialdigitales Syndrom"},{id:"ogtt",term:"OGTT",definition:"oraler Glukosetoleranztest"},{id:"oi",term:"OI)",definition:"Osteogenesis imperfecta"},{id:"ok",term:"OK)",definition:"Oberkiefer"},{id:"okh",term:"OKH)",definition:"Oberkieferh\xf6hle"},{id:"ol",term:"OL)",definition:"Oberlappen"},{id:"om",term:"OM)",definition:"Otitis media"},{id:"omf",term:"OMF)",definition:"Osteomyelofibrose"},{id:"oms",term:"OMS)",definition:"Osteomyelosklerose"},{id:"onk-",term:"ONK-",definition:"Tubus"},{id:"o\xf6s",term:"O\xd6S",definition:"oberer \xd6sophagussphinkter"},{id:"opca",term:"OPCA",definition:"olivo-ponto-cerebellare"},{id:"opz",term:"OPZ",definition:"operatives Zentrum"},{id:"orn",term:"ORN",definition:"Ornithin"},{id:"os",term:"OS)",definition:"Oberschenkel"},{id:"osas",term:"OSAS",definition:"obstruktives"},{id:"ota",term:"OTA)",definition:"Operationstechnische"},{id:"otd",term:"OTD)",definition:"Organtoleranzdosis"},{id:"oup",term:"OUP",definition:"oberer Umschlagspunkt"},{id:"\xf6v",term:"\xd6V",definition:"\xd6sophagusvarizen"},{id:"\xf6vb",term:"\xd6VB)",definition:"\xd6sophagusvarizenblutung"},{id:"ovh",term:"OVH)",definition:"Ovulationshemmer"},{id:"pa",term:"PA)",definition:"Pflegeanamnese"},{id:"pad",term:"PAD",definition:"perkutane Abszessdrainage"},{id:"paf",term:"PAF",definition:"pl\xe4ttchenaktiviernder Faktor"},{id:"page",term:"PAGE",definition:"Polyacrylamidgelelektrophorese"},{id:"pak",term:"PAK",definition:"Pulmonalarterienkatheter"}]}),626,[]);
__d((function(e,i,n,r,t,s,a){t.exports=[{id:"afasie",term:"Afasie",definition:"St\xf6rung der Sprachfunktion nach Hirnsch\xe4digung bei intakten Sprechwerkzeugen. Hauptformen sind die Broca-Afasie (motorisch/expressiv), Wernicke-Afasie (sensorisch/rezeptiv), globale und amnestische Afasie."},{id:"agnosie",term:"Agnosie",definition:"Unf\xe4higkeit, Sinneseindr\xfccke zu erkennen und zu interpretieren trotz intakter Sinnesorgane. Je nach betroffenem Sinnessystem unterscheidet man visuelle, akustische und taktile Agnosie."},{id:"agraphie",term:"Agraphie",definition:"Erworbene St\xf6rung der Schreibf\xe4higkeit nach Hirnsch\xe4digung trotz erhaltener motorischer F\xe4higkeiten und Sprachverst\xe4ndnis."},{id:"alexie",term:"Alexie",definition:"Erworbene Lesest\xf6rung nach Hirnsch\xe4digung trotz intaktem Sehverm\xf6gen und Sprachverst\xe4ndnis."},{id:"amnesie",term:"Amnesie",definition:"Ged\xe4chtnisst\xf6rung, die das Abspeichern neuer Informationen (anterograde A.) oder den Abruf bereits gespeicherter Informationen (retrograde A.) betrifft."},{id:"aneurysma",term:"Aneurysma (zerebral)",definition:"Aussackung einer Hirnarterie, meist an Gef\xe4\xdfverzweigungen. Ruptur kann zu Subarachnoidalblutung f\xfchren. H\xe4ufigste Lokalisation: Circulus arteriosus Willisii."},{id:"aphonie",term:"Aphonie",definition:"Vollst\xe4ndiger Stimmverlust bei erhaltener Fl\xfcsterstimme, oft psychogen oder durch Kehlkopferkrankungen verursacht. Keine prim\xe4r neurologische St\xf6rung."},{id:"aphasie",term:"Aphasie",definition:"Zentrale Sprachst\xf6rung nach Hirnsch\xe4digung. Variante von Afasie, in manchen Klassifikationen als st\xe4rkere Auspr\xe4gung der Sprachst\xf6rung beschrieben."},{id:"apraxie",term:"Apraxie",definition:"St\xf6rung zielgerichteter Bewegungen und Handlungen trotz intakter motorischer Funktion. Ideomotorische (Ausf\xfchrung einzelner Bewegungen), ideatorische (komplexe Handlungsabl\xe4ufe) und konstruktive Apraxie (r\xe4umliche Anordnung)."},{id:"arachnoidalzyste",term:"Arachnoidalzyste",definition:"Gutartige, mit Liquor gef\xfcllte Zyste zwischen Arachnoidea und Pia mater. Meist angeboren und asymptomatisch, kann aber durch Raumforderung Symptome verursachen."},{id:"astrozytom",term:"Astrozytom",definition:"Hirntumor, der aus Astrozyten (einem Typ von Gliazellen) entsteht. WHO-Grad I-IV, wobei Grad IV dem Glioblastom entspricht."},{id:"ataxie",term:"Ataxie",definition:"St\xf6rung der Bewegungskoordination mit unsicherem Gang, ungenauer Zielbewegung und Intentionstremor. Meist durch Sch\xe4digung des Kleinhirns oder der Kleinhirnbahnen."},{id:"athetose",term:"Athetose",definition:"Unwillk\xfcrliche, langsame, wurmartige Bewegungen v.a. der Extremit\xe4ten. H\xe4ufig bei extrapyramidalen Bewegungsst\xf6rungen wie Zerebralparese."},{id:"babinskizeichen",term:"Babinski-Zeichen",definition:"Pathologisches Reflex-Ph\xe4nomen mit Gro\xdfzehendorsiflexion und F\xe4cherung der \xfcbrigen Zehen bei Reizung der Fu\xdfsohle. Hinweis auf Sch\xe4digung der Pyramidenbahn."},{id:"ballismus",term:"Ballismus",definition:"Schwere Form der Hyperkinese mit heftigen, schleudernden Bewegungen der Extremit\xe4ten. Oft einseitig (Hemiballismus) durch Sch\xe4digung des Nucleus subthalamicus."},{id:"baroreflexversagen",term:"Baroreflexversagen",definition:"St\xf6rung der Blutdruckregulation durch Ausfall der Barorezeptoren oder ihrer zentralen Verschaltung. F\xfchrt zu starken Blutdruckschwankungen, v.a. orthostatisch."},{id:"brainpressure",term:"Brain Pressure (Hirndruck)",definition:"Erh\xf6hter intrakranieller Druck durch Raumforderungen, \xd6deme, Blutungen oder Liquorzirkulationsst\xf6rungen. Symptome: Kopfschmerz, \xdcbelkeit, Erbrechen, Bewusstseinsst\xf6rungen, Stauungspapille."},{id:"cerebritisheard",term:"Cerebritis-Herd",definition:"Lokalisierte Entz\xfcndung des Hirngewebes, Fr\xfchstadium eines Hirnabszesses. Verursacht durch bakterielle, virale oder pilzbedingte Infektionen."},{id:"chorea",term:"Chorea",definition:"Unwillk\xfcrliche, rasche, unregelm\xe4\xdfige, nicht-rhythmische Bewegungen, die flie\xdfend ineinander \xfcbergehen. Wichtigstes Beispiel: Chorea Huntington."},{id:"cva",term:"CVA (Cerebrovascular Accident)",definition:"Englische Bezeichnung f\xfcr Schlaganfall. Pl\xf6tzliche Unterbrechung der Blutversorgung bestimmter Hirnareale durch Isch\xe4mie oder Blutung."},{id:"dysdiadochokinese",term:"Dysdiadochokinese",definition:"St\xf6rung der raschen Ausf\xfchrung alternierender Bewegungen (z.B. Pronation/Supination). Typisches Kleinhirnzeichen."},{id:"dystonie",term:"Dystonie",definition:"Bewegungsst\xf6rung mit unwillk\xfcrlichen anhaltenden Muskelkontraktionen, die zu abnormen Haltungen oder wiederholten Bewegungen f\xfchren. Fokale (z.B. Torticollis) oder generalisierte Formen."},{id:"eeg",term:"EEG (Elektroenzephalogramm)",definition:"Aufzeichnung der elektrischen Hirnaktivit\xe4t mittels Oberfl\xe4chenelektroden. Diagnostik bei Epilepsien, Bewusstseinsst\xf6rungen, Enzephalopathien und Hirntoddetermination."},{id:"emg",term:"EMG (Elektromyogramm)",definition:"Aufzeichnung der elektrischen Muskelaktivit\xe4t. Diagnostik bei neuromuskul\xe4ren Erkrankungen, zur Differenzierung von myogenen und neurogenen Erkrankungen."},{id:"encephalitis",term:"Enzephalitis",definition:"Entz\xfcndung des Hirngewebes, meist viral bedingt. Symptome: Fieber, Kopfschmerzen, Bewusstseinsst\xf6rungen, neurologische Ausf\xe4lle, Krampfanf\xe4lle."},{id:"encephalopathie",term:"Enzephalopathie",definition:"Sammelbegriff f\xfcr diffuse Hirnfunktionsst\xf6rungen verschiedener Ursachen (toxisch, metabolisch, hypoxisch etc.). Symptome: Bewusstseinsst\xf6rungen, Verwirrtheit, kognitive Defizite."},{id:"epilepsie",term:"Epilepsie",definition:"Erkrankung mit wiederkehrenden, unprovoziert auftretenden Anf\xe4llen aufgrund paroxysmaler, synchroner neuronaler Entladungen. Fokale und generalisierte Formen."},{id:"evp",term:"EVP (Evozierte Potentiale)",definition:"Elektrische Antworten des Nervensystems auf definierte \xe4u\xdfere Reize. Visuelle (VEP), akustische (AEP), somatosensorische (SEP) und motorische (MEP) evozierte Potentiale."},{id:"faszikulationen",term:"Faszikulationen",definition:"Unwillk\xfcrliche Kontraktionen einzelner Muskelfaserb\xfcndel, sichtbar als Muskelzucken unter der Haut. Hinweis auf Vorderhornzellsch\xe4digung, z.B. bei ALS."},{id:"gerstmannsyndrm",term:"Gerstmann-Syndrom",definition:"Symptomkomplex mit Fingeragnosie, Rechts-Links-St\xf6rung, Agraphie und Akalkulie. L\xe4sion im Bereich des Gyrus angularis der dominanten Hemisph\xe4re."},{id:"glioblastom",term:"Glioblastom",definition:"B\xf6sartigster hirneigener Tumor (WHO Grad IV), ausgehend von Gliazellen. Infiltratives Wachstum, schlechte Prognose, Standardtherapie: Operation, Radiochemotherapie."},{id:"hemiparese",term:"Hemiparese",definition:"Inkomplette L\xe4hmung einer K\xf6rperh\xe4lfte. H\xe4ufige Folge eines Schlaganfalls oder anderer L\xe4sionen der Pyramidenbahn."},{id:"hemiplegie",term:"Hemiplegie",definition:"Vollst\xe4ndige L\xe4hmung einer K\xf6rperh\xe4lfte. Schwere Form der Hemiparese bei kompletter Pyramidenbahnl\xe4sion."},{id:"hirnoedem",term:"Hirn\xf6dem",definition:"Vermehrter Wassergehalt des Hirngewebes mit Volumenzunahme und potenzieller Hirndrucksteigerung. Vasogene, zytotoxische und interstitielle Formen."},{id:"hornersyndrm",term:"Horner-Syndrom",definition:"Trias aus Miosis (enge Pupille), Ptosis (Oberlidh\xe4ngen) und Enophthalmus (eingesunkener Augapfel) durch L\xe4sion des sympathischen Nervensystems."},{id:"huntington",term:"Huntington-Krankheit",definition:"Autosomal-dominant vererbte neurodegenerative Erkrankung mit Chorea, kognitiven St\xf6rungen und psychiatrischen Symptomen. Ursache: CAG-Repeat-Expansion im Huntingtin-Gen."},{id:"hydrocephalus",term:"Hydrozephalus",definition:"Erweiterung der Hirnventrikel durch vermehrte Liquormenge. Obstruktiv (Abflussbehinderung), kommunizierend (gest\xf6rte Resorption) oder ex vacuo (bei Hirnatrophie)."},{id:"hyperkinese",term:"Hyperkinese",definition:"\xdcberschie\xdfende unwillk\xfcrliche Bewegungen verschiedener Formen (Tremor, Chorea, Tics etc.). Ursache meist in Basalganglien oder Kleinhirn."},{id:"ischias",term:"Ischias",definition:"Schmerzsyndrom im Versorgungsgebiet des Nervus ischiadicus. Meist durch Bandscheibenvorfall oder andere Kompression der Nervenwurzel L4-S1."},{id:"kataplexy",term:"Kataplexie",definition:"Pl\xf6tzlicher, meist emotionsausgel\xf6ster Verlust des Muskeltonus bei erhaltenem Bewusstsein. Kardinalsymptom der Narkolepsie."},{id:"klumpke",term:"Klumpke-L\xe4hmung",definition:"L\xe4hmung des unteren Plexus brachialis (C8-Th1). Betrifft kleine Handmuskeln und Fingerbeuger. Oft durch Geburtstrauma oder Zugverletzungen."},{id:"leptomeningitis",term:"Leptomeningitis",definition:"Entz\xfcndung der weichen Hirnh\xe4ute (Pia mater und Arachnoidea). Meist bakteriell, viral oder pilzbedingt. Symptome: Fieber, Kopfschmerz, Meningismus, Lichtscheu."},{id:"lhermitte",term:"Lhermitte-Zeichen",definition:"Elektrisierendes Gef\xfchl, das bei Kopfbeugung vom Nacken in R\xfccken und Extremit\xe4ten ausstrahlt. Hinweis auf L\xe4sion der Hinterstr\xe4nge, typisch f\xfcr Multiple Sklerose."},{id:"locked_in",term:"Locked-in-Syndrom",definition:"Zustand mit vollst\xe4ndiger L\xe4hmung aller willk\xfcrlichen Muskeln au\xdfer der Augenbewegung bei erhaltenem Bewusstsein. Ursache meist Ponsl\xe4sion (Basilaristhrombose)."},{id:"meningismus",term:"Meningismus",definition:"Nackensteifigkeit und andere meningeale Reizzeichen ohne Entz\xfcndung der Meningen. Kann bei Fieber, Vergiftungen oder Hirnblutungen auftreten."},{id:"meningitis",term:"Meningitis",definition:"Entz\xfcndung der Hirnh\xe4ute. Bakterielle Form ist lebensbedrohlicher Notfall mit Fieber, Kopfschmerz, Nackensteife, Bewusstseinsst\xf6rung. Virale Form meist milder."},{id:"mnd",term:"MND (Motor Neuron Disease)",definition:"Oberbegriff f\xfcr neurodegenerative Erkrankungen der motorischen Neurone. Wichtigster Vertreter: Amyotrophe Lateralsklerose (ALS)."},{id:"multiplesklerose",term:"Multiple Sklerose",definition:"Chronisch-entz\xfcndliche, demyelinisierende Erkrankung des ZNS. Zeitliche und \xf6rtliche Dissemination von Symptomen, schubf\xf6rmiger oder progredienter Verlauf."},{id:"myasthenia",term:"Myasthenia gravis",definition:"Autoimmunerkrankung mit Bildung von Antik\xf6rpern gegen Acetylcholinrezeptoren der neuromuskul\xe4ren Endplatte. Belastungsabh\xe4ngige Muskelschw\xe4che, Tagesschwankungen."},{id:"myelitis",term:"Myelitis",definition:"Entz\xfcndung des R\xfcckenmarks. Postinfekti\xf6s, paraneoplastisch oder im Rahmen demyelinisierender Erkrankungen. Symptome: Paraparese, Sensibilit\xe4tsst\xf6rungen, vegetative St\xf6rungen."},{id:"narkolepsie",term:"Narkolepsie",definition:"Schlafst\xf6rung mit \xfcberm\xe4\xdfiger Tagesschl\xe4frigkeit, Kataplexie, Schlafl\xe4hmung und hypnagogen Halluzinationen. Ursache: Mangel an Hypocretin (Orexin) im Hypothalamus."},{id:"neurofibroma",term:"Neurofibrom",definition:"Gutartiger Tumor aus Nervenscheidenzellen, oft multiple bei Neurofibromatose. Meist harmlos, kann aber durch Kompression Symptome verursachen."},{id:"neurofibromatose",term:"Neurofibromatose",definition:"Erbliche Erkrankung mit multiplen Neurofibromen, Caf\xe9-au-lait-Flecken und h\xf6herem Risiko f\xfcr Tumore des Nervensystems. Typ 1 (NF1) und Typ 2 (NF2)."},{id:"neuropathie",term:"Neuropathie",definition:"Erkrankung peripherer Nerven unterschiedlicher Ursache. Axonale oder demyelinisierende Formen. H\xe4ufig bei Diabetes, Alkoholabusus, Vitamin-B12-Mangel, toxisch."},{id:"palsy",term:"Palsy (Parese)",definition:"Englischer Begriff f\xfcr L\xe4hmung/Parese. H\xe4ufig in Zusammensetzungen wie 'Bell's palsy' (Fazialisparese) oder 'cerebral palsy' (Zerebralparese)."},{id:"papillenoedem",term:"Papillen\xf6dem",definition:"Schwellung der Sehnervenpapille, ophthalmoskopisch sichtbar. H\xe4ufigste Ursache ist erh\xf6hter intrakranieller Druck (Stauungspapille)."},{id:"paraparese",term:"Paraparese",definition:"Inkomplette L\xe4hmung beider Beine. Meist durch R\xfcckenmarksl\xe4sion oberhalb des Lendensegments (Querschnittsyndrom)."},{id:"paraplegie",term:"Paraplegie",definition:"Vollst\xe4ndige L\xe4hmung beider Beine mit Sensibilit\xe4tsverlust und vegetativen St\xf6rungen. Form des kompletten Querschnittsyndroms."},{id:"parkinson",term:"Parkinson-Krankheit",definition:"Neurodegenerative Erkrankung mit Verlust dopaminerger Neurone in der Substantia nigra. Kardinalsymptome: Rigor, Tremor, Bradykinese, posturale Instabilit\xe4t."},{id:"plexopathie",term:"Plexopathie",definition:"Sch\xe4digung eines Nervengeflechts (Plexus). Plexus brachialis (Arm) oder lumbosacralis (Bein). Ursachen: Trauma, Entz\xfcndung, Tumor, Bestrahlung."},{id:"polyneuropathie",term:"Polyneuropathie",definition:"Generalisierte Erkrankung peripherer Nerven, meist symmetrisch, strumpf- und handschuhf\xf6rmige Verteilung. H\xe4ufig bei Diabetes, Alkoholismus, Vitamin-B12-Mangel."},{id:"pseudobulbaer",term:"Pseudobulb\xe4rparalyse",definition:"L\xe4hmung der Hirnnerven durch supranukle\xe4re L\xe4sion (oberhalb der Hirnnervenkerne). Symptome \xe4hnlich Bulb\xe4rparalyse, aber mit erhaltenen Reflexen und emotionaler Instabilit\xe4t."},{id:"querschnitt",term:"Querschnittsyndrom",definition:"Komplexes neurologisches Ausfallmuster bei L\xe4sion des R\xfcckenmarks. Je nach H\xf6he: Tetraplegie (zervikales R\xfcckenmark) oder Paraplegie (thorakal/lumbal)."},{id:"radikulaer",term:"Radikul\xe4rsyndrom",definition:"Sch\xe4digung einer oder mehrerer Nervenwurzeln mit segmentaler motorischer Schw\xe4che, Sensibilit\xe4tsst\xf6rung und abgeschw\xe4chten/fehlenden Reflexen."},{id:"restlesslegs",term:"Restless-Legs-Syndrom",definition:"Neurologische St\xf6rung mit zwanghaftem Bewegungsdrang der Beine, v.a. in Ruhe und abends/nachts. Beschrieben als Kribbeln, Ziehen oder Schmerzen."},{id:"sah",term:"SAB (Subarachnoidalblutung)",definition:"Blutung in den mit Liquor gef\xfcllten Subarachnoidalraum. H\xe4ufigste Ursache: Ruptur eines Aneurysmas. Leitsymptom: pl\xf6tzlicher, sehr starker Kopfschmerz ('Vernichtungskopfschmerz')."},{id:"singultus",term:"Singultus (Schluckauf)",definition:"Unwillk\xfcrliche, rhythmische Kontraktionen des Zwerchfells mit pl\xf6tzlichem Verschluss der Glottis. Bei l\xe4ngerer Dauer neurologische Ursachen m\xf6glich (Hirnstamm)."},{id:"spastik",term:"Spastik",definition:"Erh\xf6hter Muskeltonus mit geschwindigkeitsabh\xe4ngigem Widerstand gegen passive Bewegung, pathologischen Reflexen und Kloni. Zeichen einer Pyramidenbahnl\xe4sion."},{id:"syringomyelie",term:"Syringomyelie",definition:"Bildung fl\xfcssigkeitsgef\xfcllter H\xf6hlen (Syrinx) im R\xfcckenmark. Charakteristisch: dissoziierte Sensibilit\xe4tsst\xf6rung (Schmerz-/Temperaturverlust bei erhaltener Ber\xfchrungsempfindung)."},{id:"tetraplegie",term:"Tetraplegie",definition:"L\xe4hmung aller vier Extremit\xe4ten durch hohe R\xfcckenmarksl\xe4sion (oberhalb C8). Auch Tetraparese bei inkompletter L\xe4hmung."},{id:"thalamuslasion",term:"Thalamusl\xe4sion",definition:"Sch\xe4digung des Thalamus (zentrale Schaltstation f\xfcr Sinneseindr\xfccke und Motorik). Verursacht kontralaterale Sensibilit\xe4tsst\xf6rungen, Schmerzsyndrome, Bewegungsst\xf6rungen."},{id:"tic",term:"Tic",definition:"Unwillk\xfcrliche, rasche, wiederholte Bewegungen (motorische Tics) oder Laut\xe4u\xdferungen (vokale Tics). Multiple Tics \xfcber l\xe4ngere Zeit: Tourette-Syndrom."},{id:"tinnitus",term:"Tinnitus",definition:"Ger\xe4uschwahrnehmung ohne \xe4u\xdfere Schallquelle (Ohrger\xe4usche). Nicht prim\xe4r neurologisch, kann aber bei zerebralen oder vaskul\xe4ren St\xf6rungen auftreten."},{id:"torticollis",term:"Torticollis",definition:"Fehlfixierung des Kopfes durch unwillk\xfcrliche Kontraktion der Nackenmuskulatur. Form einer fokalen Dystonie (Torticollis spasmodicus)."},{id:"tremor",term:"Tremor",definition:"Rhythmische, oszillierende Bewegung von K\xf6rperteilen. Ruhetremor (Parkinson), Haltetremor (essentieller Tremor), Intentionstremor (Kleinhirn) und andere Formen."},{id:"trigeminusneuralgie",term:"Trigeminusneuralgie",definition:"Anfallsartige, einschie\xdfende Schmerzattacken im Versorgungsgebiet des N. trigeminus. Oft ausgel\xf6st durch Ber\xfchrung bestimmter Triggerpunkte im Gesicht."},{id:"vegetativ",term:"Vegetativer Zustand",definition:"Schwere Bewusstseinsst\xf6rung mit erhaltenen autonomen Funktionen, Schlaf-Wach-Rhythmus, aber ohne nachweisbare bewusste Wahrnehmung und Kommunikation."},{id:"vertigo",term:"Vertigo",definition:"Drehschwindel mit Scheinbewegung der Umgebung. Peripher (Innenohr/Vestibularnerv) oder zentral (Hirnstamm/Kleinhirn). Je nach Ursache mit vegetativen Symptomen."},{id:"wallenberg",term:"Wallenberg-Syndrom",definition:"Laterales Medulla-oblongata-Syndrom durch Verschluss der A. cerebelli posterior inferior. Symptome: ipsilaterale Gesichtssensibilit\xe4tsst\xf6rung, kontralaterale K\xf6rpersensibilit\xe4tsst\xf6rung, Horner-Syndrom."},{id:"wernickeaphasie",term:"Wernicke-Aphasie",definition:"Sensorische/rezeptive Aphasie mit fl\xfcssiger Sprache, aber gest\xf6rtem Sprachverst\xe4ndnis und Wortwahl. L\xe4sion im Wernicke-Zentrum (Temporallappen der dominanten Hemisph\xe4re)."},{id:"zerebralparese",term:"Zerebralparese",definition:"Bewegungs- und Haltungsst\xf6rung durch fr\xfchkindliche Hirnsch\xe4digung. Spastische, dyskinetische, ataktische und gemischte Formen."},{id:"neurosarkoidose",term:"Neurosarkoidose",definition:"Manifestation der Sarkoidose im Nervensystem. Kann sowohl ZNS als auch PNS betreffen. Symptome abh\xe4ngig von der Lokalisation: Hirnnervenparesen, Meningitis, Myelopathie, Neuropathie."},{id:"tia",term:"TIA (Transitorische isch\xe4mische Attacke)",definition:"Vor\xfcbergehende neurologische Symptome durch kurzzeitige fokale zerebrale Isch\xe4mie. Vollst\xe4ndige R\xfcckbildung innerhalb von 24 Stunden, meist jedoch binnen 1 Stunde. Warnsignal f\xfcr drohenden Schlaganfall."},{id:"demenz",term:"Demenz",definition:"Syndrom mit fortschreitendem Verlust kognitiver F\xe4higkeiten. Hauptformen: Alzheimer-Demenz, vaskul\xe4re Demenz, Lewy-K\xf6rperchen-Demenz, frontotemporale Demenz. Symptome: Ged\xe4chtnisst\xf6rungen, Orientierungsprobleme, Pers\xf6nlichkeitsver\xe4nderungen."},{id:"guillainbarre",term:"Guillain-Barr\xe9-Syndrom",definition:"Akute, immunvermittelte Polyradikuloneuritis. Aufsteigende L\xe4hmungen, beginnend in den Beinen, bis hin zur Ateml\xe4hmung. Meist nach Infektionen. Gute Prognose bei ad\xe4quater Therapie."},{id:"msk",term:"MSK (Medulla-Spinalis-Kompression)",definition:"Kompression des R\xfcckenmarks durch Tumor, Bandscheibenvorfall, Abszess oder H\xe4matom. Neurologischer Notfall mit drohender Querschnittsl\xe4hmung. Symptome: L\xe4hmungen, Sensibilit\xe4tsst\xf6rungen, Blasen-Mastdarm-St\xf6rungen."},{id:"parkinsoni",term:"Parkinson-Krankheit",definition:"Neurodegenerative Erkrankung mit Degeneration dopaminerger Neurone in der Substantia nigra. Kardinalsymptome: Bradykinese, Rigor, Ruhetremor, posturale Instabilit\xe4t."},{id:"wernickeenzephalopathie",term:"Wernicke-Enzephalopathie",definition:"Akute neurologische St\xf6rung durch Thiaminmangel (Vitamin B1), meist bei Alkoholismus. Klassische Trias: Bewusstseinsst\xf6rung, Augenmuskelparesen, Ataxie. Unbehandelt \xdcbergang in Korsakow-Syndrom."},{id:"lws",term:"LWS-Syndrom",definition:"Schmerzsyndrom der Lendenwirbels\xe4ule, oft mit Ausstrahlung ins Bein (Lumboischialgie). H\xe4ufige Ursachen: Bandscheibenvorfall, Spinalkanalstenose, Facettensyndrom, Muskelblockaden."}]}),627,[]);
__d((function(e,i,n,r,t,a,o){t.exports=[{id:"arrhythmie",term:"Arrhythmie",definition:"St\xf6rung des normalen Herzrhythmus. Kann bradykard (zu langsam), tachykard (zu schnell) oder irregul\xe4r sein. Ursachen: Herzerkrankungen, Elektrolytst\xf6rungen, Medikamente, Stress."},{id:"angina_pectoris",term:"Angina pectoris",definition:"Thoraxschmerz aufgrund unzureichender Sauerstoffversorgung des Herzmuskels (Myokardisch\xe4mie). Typisch: retrosternale Schmerzen mit Ausstrahlung in linken Arm, Kiefer. Formen: stabile und instabile Angina."},{id:"nstemi",term:"NSTEMI",definition:"Nicht-ST-Hebungsinfarkt. Herzinfarkt ohne ST-Streckenhebung im EKG. Partieller Verschluss eines Herzkranzgef\xe4\xdfes mit Myokardnekrose. Diagnose durch Troponin-Anstieg."},{id:"stemi",term:"STEMI",definition:"ST-Hebungsinfarkt. Herzinfarkt mit ST-Streckenhebung im EKG. Kompletter Verschluss eines Herzkranzgef\xe4\xdfes. Kardiologischer Notfall, der sofortige Revaskularisation (PCI) erfordert."},{id:"ami",term:"AMI (Akuter Myokardinfarkt)",definition:"Pl\xf6tzliche Unterbrechung der Blutversorgung eines Herzmuskelareals mit Nekrose. Symptome: starke Brustschmerzen, Dyspnoe, vegetative Symptome. Unterteilung in STEMI und NSTEMI."},{id:"aks",term:"AKS (Akutes Koronarsyndrom)",definition:"Sammelbegriff f\xfcr akute isch\xe4mische Herzerkrankungen: instabile Angina pectoris, NSTEMI und STEMI. Gemeinsame Pathophysiologie: Plaqueruptur mit Thrombusbildung."},{id:"herzinsuffizienz",term:"Herzinsuffizienz",definition:"Unverm\xf6gen des Herzens, den K\xf6rper ausreichend mit Blut zu versorgen. Einteilung: links-/rechtsventrikul\xe4r, systolisch/diastolisch, akut/chronisch. NYHA-Klassifikation I-IV nach Symptomatik."},{id:"hfref",term:"HFrEF",definition:"Herzinsuffizienz mit reduzierter Ejektionsfraktion (EF <40%). Fr\xfcher systolische Herzinsuffizienz genannt. Ursachen: KHK, Klappenvitien, Kardiomyopathien. Therapie: RAAS-Blocker, Betablocker, MRA, SGLT2-Hemmer."},{id:"hfpef",term:"HFpEF",definition:"Herzinsuffizienz mit erhaltener Ejektionsfraktion (EF >50%). Fr\xfcher diastolische Herzinsuffizienz genannt. H\xe4ufig bei Hypertonie, Diabetes, Adipositas. Therapie: Grunderkrankungen, Symptomkontrolle."},{id:"vorhofflimmern",term:"Vorhofflimmern",definition:"H\xe4ufigste anhaltende Herzrhythmusst\xf6rung mit unkoordinierter Vorhofaktivit\xe4t und unregelm\xe4\xdfiger Kammer\xfcberleitung. Erh\xf6htes Schlaganfallrisiko. Klassifikation: paroxysmal, persistierend, permanent."},{id:"vht",term:"VHT (Vorhofthrombus)",definition:"Blutgerinnsel im Vorhof, meist bei Vorhofflimmern. Hauptlokalisation: linkes Herzohr. Embolisationsgefahr mit Schlaganfallrisiko. Prophylaxe/Therapie: Antikoagulation."},{id:"avblock",term:"AV-Block",definition:"St\xf6rung der Erregungsleitung zwischen Vorh\xf6fen und Kammern. Einteilung in Grad I (verz\xf6gerte \xdcberleitung), II (teilweise blockierte \xdcberleitung) und III (komplette Blockade)."},{id:"bradykardie",term:"Bradykardie",definition:"Herzfrequenz unter 60/min. Ursachen: physiologisch (Sportler), Sinusknotendysfunktion, AV-Blockierungen, Medikamente (Betablocker). Symptome: Schwindel, Synkopen, Belastungsintoleranz."},{id:"tachykardie",term:"Tachykardie",definition:"Herzfrequenz \xfcber 100/min. Formen: Sinustachykardie, supraventrikul\xe4re Tachykardie (SVT), ventrikul\xe4re Tachykardie (VT). Ursachen: Fieber, Stress, Herzerkrankungen, Medikamente."},{id:"vt",term:"VT (Ventrikul\xe4re Tachykardie)",definition:"Schneller Herzrhythmus (>100/min) ausgehend von den Herzkammern. Lebensbedrohlich, kann in Kammerflimmern \xfcbergehen. Ursachen: KHK, Kardiomyopathie, Elektrolitst\xf6rungen, QT-Verl\xe4ngerung."},{id:"vf",term:"VF (Ventricular Fibrillation/Kammerflimmern)",definition:"Chaotische elektrische Aktivit\xe4t der Herzkammern ohne effektive Kontraktion. F\xfchrt unbehandelt zum Kreislaufstillstand. Sofortige Defibrillation und CPR erforderlich."},{id:"koronare_herzkrankheit",term:"KHK (Koronare Herzkrankheit)",definition:"Verengung der Herzkranzgef\xe4\xdfe durch Arteriosklerose. F\xfchrt zu Myokardisch\xe4mie. Manifestationen: stabile Angina pectoris, AKS, pl\xf6tzlicher Herztod, Herzinsuffizienz."},{id:"pci",term:"PCI (Perkutane Koronarintervention)",definition:"Kathetergest\xfctzte Behandlung verengter Koronararterien. Ablauf: Ballonerweiterung (PTCA) meist mit Stentimplantation. Zugangswege: radial oder femoral."},{id:"cabg",term:"CABG (Coronary Artery Bypass Graft)",definition:"Bypass-Operation zur \xdcberbr\xfcckung von Koronarstenosen. Verwendung von Arterien (A. mammaria, A. radialis) oder Venen (V. saphena magna). Indikation bei komplexer KHK."},{id:"pulmonale_hypertonie",term:"Pulmonale Hypertonie",definition:"Erh\xf6hter Blutdruck im Lungenkreislauf (mPAP >20 mmHg). Einteilung WHO-Gruppe 1-5. Symptome: Dyspnoe, M\xfcdigkeit, Synkopen. Diagnose: Rechtsherzkatheter. Therapie abh\xe4ngig von Ursache."},{id:"mitralklappeninsuffizienz",term:"Mitralklappeninsuffizienz",definition:"Schlussunf\xe4higkeit der Mitralklappe mit R\xfcckstrom von Blut in den linken Vorhof w\xe4hrend der Systole. Ursachen: prim\xe4r (Prolaps, rheumatisch) oder sekund\xe4r (Herzinsuffizienz)."},{id:"aortenklappenstenose",term:"Aortenklappenstenose",definition:"Verengung der Aortenklappe mit erh\xf6htem Ausflusswiderstand. H\xe4ufigste Klappenerkrankung. Ursachen: degenerativ (kalzifizierend), angeboren (bikuspide Klappe), rheumatisch. Leitsymptome: Dyspnoe, Angina, Synkope."},{id:"endokarditis",term:"Endokarditis",definition:"Entz\xfcndung der Herzinnenhaut, v.a. an Herzklappen. Meist bakteriell, selten pilzbedingt. Pr\xe4disponierend: Klappenerkrankungen, i.v. Drogenkonsum, Immunsuppression. Komplikationen: Klappendestruktion, Embolien."},{id:"perikarderguss",term:"Perikarderguss",definition:"Fl\xfcssigkeitsansammlung im Herzbeutel. Ursachen: Infektionen, Tumore, Ur\xe4mie, Myokardinfarkt, autoimmun. Bei schneller Entstehung oder gro\xdfem Volumen: Tamponade mit h\xe4modynamischer Beeintr\xe4chtigung."},{id:"herztamponade",term:"Herztamponade",definition:"Lebensbedrohliche Kompression des Herzens durch Fl\xfcssigkeit im Herzbeutel. Klinische Trias: Hypotonie, gestaute Halsvenen, leise Herzt\xf6ne. Sofortige Perikardpunktion notwendig."},{id:"dcm",term:"DCM (Dilatative Kardiomyopathie)",definition:"Erkrankung mit Erweiterung und eingeschr\xe4nkter Pumpfunktion des linken oder beider Ventrikel. Ursachen: genetisch, toxisch (Alkohol), Myokarditis, idiopathisch. Folge: Herzinsuffizienz."},{id:"hcm",term:"HCM (Hypertrophe Kardiomyopathie)",definition:"Verdickung der Herzmuskulatur (v.a. Septum) ohne erkennbare Ursache. Oft genetisch bedingt. Kann zu Ausflussobstruktion, Herzrhythmusst\xf6rungen, pl\xf6tzlichem Herztod f\xfchren."},{id:"nt_probnp",term:"NT-proBNP",definition:"Labormarker f\xfcr myokardiale Belastung, diagnostischer Standard bei Herzinsuffizienz. Erh\xf6ht bei ventrikul\xe4rer Dehnung. Beeinflusst durch Alter, Nierenfunktion, Adipositas."},{id:"troponin",term:"Troponin",definition:"Strukturprotein der Herzmuskelzellen, hochsensitiver Marker f\xfcr Myokardsch\xe4digung. Wichtig f\xfcr Diagnose des Myokardinfarkts. Auch erh\xf6ht bei Myokarditis, Lungenembolie, Niereninsuffizienz."},{id:"tte",term:"TTE (Transthorakale Echokardiographie)",definition:"Ultraschalluntersuchung des Herzens durch die Brustwand. Standardmethode zur Beurteilung von Herzgr\xf6\xdfe, Pumpfunktion, Klappenfunktion, Perikard. Nicht-invasiv, keine Strahlenbelastung."}]}),628,[]);
__d((function(e,n,i,r,t,o,a){t.exports=[{id:"copd",term:"COPD",definition:"Chronisch obstruktive Lungenerkrankung mit Verengung der Atemwege. Hauptursache: Rauchen. Symptome: Dyspnoe, chronischer Husten, Auswurf. Spirometrie: FEV1/FVC <70%. Stadieneinteilung nach GOLD."},{id:"asthma",term:"Asthma bronchiale",definition:"Chronisch-entz\xfcndliche Atemwegserkrankung mit reversibler Bronchialobstruktion. Symptome: anfallsartige Atemnot, Husten, Giemen. Ausl\xf6ser: Allergene, Anstrengung, Infekte, K\xe4lte. Therapie: Inhalativa (SABA, ICS)."},{id:"pneumonie",term:"Pneumonie",definition:"Entz\xfcndung des Lungenparenchyms, meist durch Bakterien, Viren oder Pilze. Einteilung: ambulant/nosokomial, typisch/atypisch. Symptome: Fieber, Husten, Auswurf, Dyspnoe. Diagnostik: R\xf6ntgen-Thorax, Labor."},{id:"le",term:"Lungenembolie",definition:"Akuter Verschluss einer Lungenarterie, meist durch Thromben aus Bein-/Beckenvenen. Risiko: Immobilit\xe4t, OP, Tumoren, Gerinnungsst\xf6rungen. Symptome: Dyspnoe, Thoraxschmerz, Tachykardie. Diagnostik: D-Dimere, CT-Angio."},{id:"tuberkulose",term:"Tuberkulose",definition:"Infektionskrankheit durch Mycobacterium tuberculosis. \xdcbertragung aerogen (Tr\xf6pfcheninfektion). Manifestation: prim\xe4r pulmonal, selten extrapulmonal. Diagnostik: THT, IGRA, Sputum. Therapie: Kombination mehrerer Antibiotika."},{id:"ple",term:"Pleuraerguss",definition:"Pathologische Fl\xfcssigkeitsansammlung im Pleuraspalt. Einteilung: Transsudat (Herzinsuffizienz, Leberzirrhose) vs. Exsudat (Entz\xfcndung, Tumor). Diagnostik: Sonographie, Punktat. Therapie: Punktion, ggf. Drainage."},{id:"pneumothorax",term:"Pneumothorax",definition:"Luftansammlung im Pleuraspalt mit Kollaps der Lunge. Einteilung: spontan (prim\xe4r/sekund\xe4r), traumatisch, iatrogen. Symptome: pl\xf6tzlicher Thoraxschmerz, Dyspnoe. Therapie: Beobachtung bis Thoraxdrainage."},{id:"bronchiektasen",term:"Bronchiektasen",definition:"Irreversible Erweiterung der Bronchien durch chronische Entz\xfcndung. Ursachen: rezidivierende Infekte, Mukoviszidose, Immundefekte. Symptome: chronischer Husten mit viel Auswurf, H\xe4moptoe, Infektneigung."},{id:"interstitielle_lungenerkrankung",term:"Interstitielle Lungenerkrankung",definition:"Heterogene Gruppe chronischer Lungenerkrankungen mit Entz\xfcndung und Fibrose des Lungenger\xfcsts. \xdcber 200 verschiedene Entit\xe4ten. Symptome: trockener Husten, Belastungsdyspnoe. Diagnostik: HRCT, ggf. Lungenbiopsie."},{id:"ipf",term:"IPF (Idiopathische pulmonale Fibrose)",definition:"Sonderform der interstitiellen Lungenerkrankung unklarer Genese mit progressiver Fibrosierung. Betrifft meist \xe4ltere M\xe4nner. Prognose schlecht (3-5 Jahre). Therapie: antifibrotische Medikamente, Transplantation."},{id:"sarkoidose",term:"Sarkoidose",definition:"Multisystemerkrankung mit Bildung nicht-verk\xe4sender Granulome. Betrifft v.a. Lunge und Lymphknoten. Stadieneinteilung 0-IV nach R\xf6ntgenbild. Diagnostik: ACE, sIL-2R, Biopsie. Therapie: Kortikoide bei Symptomen."},{id:"lc",term:"Lungenkarzinom",definition:"B\xf6sartiger Tumor der Lunge. Hauptursache: Rauchen. Histologie: kleinzellig vs. nicht-kleinzellig (Adeno-, Plattenepithel-, gro\xdfzelliges Karzinom). Symptome: Husten, H\xe4moptysen, B-Symptomatik. Staging: TNM-Klassifikation."},{id:"schlafapnoe",term:"Schlafapnoe-Syndrom",definition:"Schlafbezogene Atmungsst\xf6rung mit wiederholten Atemaussetzern. Formen: obstruktiv (OSAS) oder zentral (ZSAS). Risikofaktoren: \xdcbergewicht, m\xe4nnliches Geschlecht, Alter. Folgen: Tagesm\xfcdigkeit, kardiovaskul\xe4re Erkrankungen."},{id:"ards",term:"ARDS (Acute Respiratory Distress Syndrome)",definition:"Lebensbedrohliches Lungenversagen mit diffuser Sch\xe4digung der alveolo-kapill\xe4ren Membran. Ursachen: Sepsis, Pneumonie, Aspiration, Trauma. Kennzeichen: therapierefrakt\xe4re Hypox\xe4mie, beidseitige Infiltrate."},{id:"atemwegsinfekt",term:"Akuter Atemwegsinfekt",definition:"Infekti\xf6se Erkrankung der oberen/unteren Atemwege. Meist viral (Rhinoviren, Influenza). Symptome: Husten, Schnupfen, Halsschmerzen, Fieber. Selbstlimitierend, Therapie meist symptomatisch."},{id:"lungentransplantation",term:"Lungentransplantation",definition:"Chirurgischer Ersatz einer oder beider Lungen bei terminalem Lungenversagen. Indikationen: COPD, IPF, CF, PAH. Komplikationen: Absto\xdfung, Infektionen. Lebenslange Immunsuppression erforderlich."},{id:"bronchoskopie",term:"Bronchoskopie",definition:"Endoskopische Untersuchung der Atemwege bis in die Subsegmentbronchien. Indikationen: Diagnostik (Biopsie, Lavage) und Therapie (Fremdk\xf6rperentfernung, Stentimplantation). Durchf\xfchrung: flexibel oder starr."},{id:"spirometrie",term:"Spirometrie",definition:"Lungenfunktionstest zur Messung von Atemvolumina und -fl\xfcssen. Parameter: VC, FEV1, FVC, Tiffeneau-Index. Unterscheidet obstruktive und restriktive Ventilationsst\xf6rungen. Basisdiagnostik bei Lungenerkrankungen."},{id:"bgb",term:"BGA (Blutgasanalyse)",definition:"Messung von Gaspartialdr\xfccken (pO2, pCO2) und S\xe4ure-Base-Haushalt (pH, HCO3-) im Blut. Abnahme arteriell, kapill\xe4r oder ven\xf6s. Wichtig bei akuter/chronischer respiratorischer Insuffizienz."},{id:"tracheotomie",term:"Tracheotomie",definition:"Chirurgische Anlage eines Zugangs zur Luftr\xf6hre. Indikationen: Langzeitbeatmung, obere Atemwegsobstruktion, Aspirationsschutz. Kann tempor\xe4r oder permanent sein. Komplikationen: Blutung, Infektion, Stenose."},{id:"niv",term:"NIV (Nicht-invasive Ventilation)",definition:"Beatmungsform ohne Intubation via Maske. Indikationen: COPD/Asthma-Exazerbation, kardiogenes Lungen\xf6dem, Immunsuppression. Verringert Intubationsrate und Mortalit\xe4t. Modi: CPAP, BiPAP."},{id:"cf",term:"CF (Cystische Fibrose/Mukoviszidose)",definition:"Autosomal-rezessive Erbkrankheit mit St\xf6rung des Chloridkanals CFTR. Folge: z\xe4her Schleim in Lunge, Pankreas, Leber. Symptome: chronischer Husten, rezidivierende Infekte, Gedeihst\xf6rung, Pankreasinsuffizienz."},{id:"thoraxdrainage",term:"Thoraxdrainage",definition:"Einbringen eines Katheters in den Pleuraspalt zur Ableitung von Luft oder Fl\xfcssigkeit. Indikationen: Pneumothorax, H\xe4matothorax, Pleuraerguss. Komplikationen: Fehlplatzierung, Infektion, Organverletzung."},{id:"pulsoximetrie",term:"Pulsoximetrie",definition:"Nicht-invasive Messung der Sauerstoffs\xe4ttigung im Blut. Normwert: 94-99%. Einsatz im Monitoring bei Lungenerkrankungen, An\xe4sthesie, Intensivmedizin. Limitationen: Durchblutungsst\xf6rungen, An\xe4mie, CO-Vergiftung."},{id:"lungenemphysem",term:"Lungenemphysem",definition:"Irreversible \xdcberbl\xe4hung der Lunge durch Zerst\xf6rung von Alveolarw\xe4nden. Meist Teil der COPD. Folgen: vergr\xf6\xdferter Totraum, verminderte Gasaustauschfl\xe4che. Symptome: Dyspnoe, Fassthorax, hyperresonanter Klopfschall."},{id:"hltx",term:"HLTX (Herz-Lungen-Transplantation)",definition:"Simultane Transplantation von Herz und Lunge. Indikationen: kombiniertes Herz- und Lungenversagen, schwere PAH mit Rechtsherzversagen. Selteneres Verfahren als isolierte Lungentransplantation."},{id:"ecmo",term:"ECMO (Extrakorporale Membranoxygenierung)",definition:"Verfahren zur tempor\xe4ren \xdcbernahme der Lungen- und/oder Herzfunktion. Indikation: schwerstes Lungenversagen (vv-ECMO) oder kombiniertes kardiopulmonales Versagen (va-ECMO). Komplikationen: Blutungen, Infektionen, Embolien."},{id:"sauerstofftherapie",term:"Sauerstofftherapie",definition:"Gabe von Sauerstoff zur Behandlung oder Vorbeugung von Hypox\xe4mie. Indikationen: akut (Pneumonie, LE) oder chronisch (fortgeschrittene COPD, ILD). Applikation: Nasensonde, Maske, High-Flow. Langzeit-O2-Therapie bei pO2 <55 mmHg."},{id:"pap",term:"PAP (Pulmonary Alveolar Proteinosis)",definition:"Seltene Lungenerkrankung mit Ansammlung von Surfactant-\xe4hnlichem Material in den Alveolen. Ursache: GM-CSF-Autoantik\xf6rper oder Mutationen. Therapie: Ganzlungenlavage, GM-CSF-Therapie."},{id:"dilatative_bronchitis",term:"Dilatative Bronchitis",definition:"Chronische Entz\xfcndung der Bronchien mit Erweiterung und Wandverdickung. Oft im Rahmen von COPD oder Bronchiektasen. Symptome: produktiver Husten, wiederkehrende Infekte. Therapie: Antibiotika, Sekretmobilisation."}]}),629,[]);
